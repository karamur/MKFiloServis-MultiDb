<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\MKFiloServis.Shared\MKFiloServis.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="AngleSharp" Version="1.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.0-preview.1.25120.3" />
    <PackageReference Include="Microsoft.ML" Version="5.0.0" />
    <PackageReference Include="Snappier" Version="1.3.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.1" />
    <PackageReference Include="EPPlus" Version="8.5.0" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <!-- CVE-2025-6965 / GHSA-2m69-gcr7-jv3q: Microsoft.Data.Sqlite, SQLitePCLRaw 2.1.11'i
         transitively getirir ve bu sürüm 3.50.2'nin altındaki SQLite'ı gömülü taşır (bellek bozulması).
         Düzeltilmiş 3.50.2+ yerine 3.53.3 doğrudan sabitlenerek açık kapatılır. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="9.6.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.58.0" />
    <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.7" />
    <PackageReference Include="MySqlConnector" Version="2.5.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="Parquet.Net" Version="5.2.0" />
    <PackageReference Include="QuestPDF" Version="2026.2.4" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.13.1" />
    <PackageReference Include="Selenium.WebDriver" Version="4.41.0" />
    <PackageReference Include="Selenium.WebDriver.ChromeDriver" Version="146.0.7680.16500" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.6" />
    <!-- Güvenlik yamalı sürümü proje referanslarına da taşı: eski transitif 10.0.0'a düşmesin.
         NU1510 (framework'te zaten var) bu kasıtlı sürüm sabitlemesi için geçerli değil. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" NoWarn="NU1510" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
    <PackageReference Include="WebDriverManager" Version="2.17.7" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Components\Pages\Checklist\" />
    <Folder Include="Components\Pages\OdemeEslestirme\" />
    <Folder Include="Components\Pages\ServisCalismalari\" />
    <Folder Include="Scripts\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="bin\**\*.cs" />
    <Compile Remove="obj\**\*.cs" />
    <Compile Remove="Tests\**\*.cs" />
    <Compile Remove="setup\output\**\*.cs" />
  </ItemGroup>

  <!-- Gelistirme/test ciktilari ve yerel veriler kurulum paketine girmemeli. -->
  <ItemGroup>
    <Content Remove="Tests\**;App_Data\**;Backups\**;artifacts\**;.artifacts\**;wwwroot\uploads\**;cookies.txt;dbsettings.json;portalsettings.json;backup_settings.json;appsettings.Production.json" />
    <None Remove="Tests\**;App_Data\**;Backups\**;artifacts\**;.artifacts\**;wwwroot\uploads\**;cookies.txt;dbsettings.json;portalsettings.json;backup_settings.json;appsettings.Production.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Tests\PlaywrightSmoke\MKFiloServis.PlaywrightSmoke.csproj" />
    <None Include="Tests\RentACar\MKFiloServis.RentACarChecks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Deploy\IIS\kur.bat">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <Link>kur.bat</Link>
    </Content>
    <Content Include="Deploy\IIS\kur.ps1">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <Link>kur.ps1</Link>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>MKFiloServis-Web-Development-7a75ec91-8ffb-4a17-b2f7-78b4209a2d61</UserSecretsId>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <!-- Swagger/OpenAPI XML dokümantasyon üretimi -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 1591: 'public X için XML açıklama eksik' uyarısını sustur -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="../MKFiloServis.Shared/Auditing/postgres-write-audit.sql" Link="Deploy/Migrate/postgres-write-audit.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

