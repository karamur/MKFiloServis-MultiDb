@using Microsoft.AspNetCore.Authorization
@using System.Reflection
@using MKFiloServis.Web.Services
@inject LicenseService Licenses
@inject LicenseCache Cache
@inject ILogger<LicenseModuleRouteGuard> Logger
@implements IDisposable

@if (allowed)
{
    <CascadingValue Value="licenseIdentity" IsFixed="true" @key="licenseIdentity">
        @ChildContent
    </CascadingValue>
}
else
{
    <AuthorizeView>
    <NotAuthorized><RedirectToLogin /></NotAuthorized>
    <Authorized>
    <div class="container py-5">
        <div class="alert alert-warning">
            <h4>Bu modül lisansınıza dahil değil</h4>
            <p>Modül hakkı için lisans yöneticinizle iletişime geçin. Eski ticari lisanslar modül seçilerek v3 biçiminde yeniden üretilmelidir.</p>
            <a href="/dashboard" class="btn btn-outline-primary">Ana Sayfa</a>
            <a href="/ayarlar/lisans" class="btn btn-primary ms-2">Lisans Bilgileri</a>
        </div>
    </div>
    </Authorized>
    </AuthorizeView>
}

@code {
    [Parameter, EditorRequired] public Type PageType { get; set; } = default!;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private string[] modules = [];
    private bool allowed;
    private string licenseIdentity = "";
    private bool disposed;
    private readonly CancellationTokenSource lifetime = new();

    protected override void OnInitialized()
    {
        Cache.Changed += LicenseChanged;
        _ = WatchExpiryAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        modules = PageType.GetCustomAttributes<AuthorizeAttribute>(true)
            .Select(x => x.Policy).Where(x => x?.StartsWith("Licensed:", StringComparison.Ordinal) == true)
            .Select(x => x![9..]).Distinct().ToArray();
        if (modules.Length > 0 && !Cache.HasValidLicense())
            await Licenses.ValidateAsync(persistValidation: false);
        licenseIdentity = (Cache.Get()?.Signature ?? "") + ":" + Cache.HasValidLicense();
        allowed = modules.All(Licenses.HasModulePermission);
    }

    private void LicenseChanged()
    {
        if (disposed) return;
        _ = InvokeAsync(() =>
        {
            if (disposed) return;
            licenseIdentity = (Cache.Get()?.Signature ?? "") + ":" + Cache.HasValidLicense();
            allowed = modules.All(Licenses.HasModulePermission);
            StateHasChanged();
        });
    }

    private async Task WatchExpiryAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            while (await timer.WaitForNextTickAsync(lifetime.Token))
                await InvokeAsync(async () =>
                {
                    if (disposed || modules.Length == 0) return;
                    LicenseValidationResult validation;
                    try { validation = await Licenses.ValidateAsync(persistValidation: false); }
                    catch (Exception ex)
                    {
                        Logger.LogError(ex, "Açık sayfanın modül lisansı doğrulanamadı.");
                        validation = LicenseValidationResult.Fail("Lisans doğrulanamadı.");
                    }
                    if (disposed) return;
                    allowed = validation.IsValid && modules.All(Licenses.HasModulePermission);
                    StateHasChanged();
                });
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }

    public void Dispose()
    {
        disposed = true;
        Cache.Changed -= LicenseChanged;
        lifetime.Cancel();
        lifetime.Dispose();
    }
}
