@inject AppIssueStateService AppIssueState
@inject NavigationManager Navigation

@* Sayfa içinde yakalanmayan hata (MainLayout'taki AppErrorBoundary'nin hata içeriği). Menü ve üst çubuk çalışmaya
   devam eder; kullanıcı hatayı tek tıkla destek ekibine iletebilir. *@

<div class="container py-4">
    <div class="card border-danger shadow-sm">
        <div class="card-body p-4">
            <h5 class="text-danger mb-2">
                <i class="bi bi-exclamation-octagon me-2"></i>Bu sayfada beklenmeyen bir hata oluştu
            </h5>
            <p class="text-muted mb-3">
                Yaptığınız son işlem tamamlanmamış olabilir. Sorunu destek ekibine iletebilir ya da sayfayı yeniden yükleyebilirsiniz.
            </p>
            @if (!string.IsNullOrWhiteSpace(Hata?.Message))
            {
                <div class="alert alert-light border small mb-3">
                    <strong>Hata:</strong> @Hata.Message
                </div>
            }
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-danger" @onclick="SorunuBildir">
                    <i class="bi bi-bug me-1"></i>Sorunu Bildir
                </button>
                <button type="button" class="btn btn-outline-secondary" @onclick="Yenile">
                    <i class="bi bi-arrow-clockwise me-1"></i>Sayfayı Yenile
                </button>
                <a class="btn btn-outline-primary" href="/dashboard">
                    <i class="bi bi-house-door me-1"></i>Ana Sayfa
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public Exception? Hata { get; set; }

    private void SorunuBildir()
    {
        AppIssueState.RequestReportForm(AppIssueState.LastReport);
    }

    private void Yenile()
    {
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}
