@using MKFiloServis.Web.Services
@using Microsoft.Extensions.Logging
@inject IToastService ToastService
@inject AppIssueStateService AppIssueState
@inject ILogger<ToastContainer> Logger
@implements IDisposable
@rendermode InteractiveServer

<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
    @foreach (var toast in toasts)
    {
        <div class="toast show @toast.BgClass @toast.TextClass" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header @toast.BgClass @toast.TextClass">
                <i class="bi @toast.IconClass me-2"></i>
                <strong class="me-auto">@toast.Title</strong>
                <small>simdi</small>
                <button type="button" class="btn-close @(toast.Type != ToastType.Warning ? "btn-close-white" : "")"
                        @onclick="() => RemoveToast(toast.Id)"></button>
            </div>
            <div class="toast-body">
                @toast.Message
                @if (toast.Type == ToastType.Error)
                {
                    <div class="mt-2 pt-2 border-top border-light border-opacity-50">
                        <button type="button" class="btn btn-light btn-sm" @onclick="() => SorunuBildir(toast)"
                                title="Bu hatayı destek ekibine talep olarak iletin">
                            <i class="bi bi-bug me-1"></i>Sorunu bildir
                        </button>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    // Hata kutuları "Sorunu bildir" düğmesine basılabilsin diye daha uzun açık kalır.
    private static readonly TimeSpan KisaSure = TimeSpan.FromSeconds(5);
    private static readonly TimeSpan HataSuresi = TimeSpan.FromSeconds(12);

    private List<ToastMessage> toasts = new();

    protected override void OnInitialized()
    {
        ToastService.OnShow += ShowToast;
    }

    private void ShowToast(ToastMessage toast)
    {
        if (toast.Type == ToastType.Error)
            AppIssueState.ReportVisibleError(toast.Message);

        _ = InvokeAsync(async () =>
        {
            toasts.Add(toast);
            StateHasChanged();

            try
            {
                await Task.Delay(toast.Type == ToastType.Error ? HataSuresi : KisaSure);
                if (toasts.Remove(toast))
                {
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "ToastContainer otomatik kapatma sirasinda hata (circuit kapanmis olabilir)");
            }
        });
    }

    private void SorunuBildir(ToastMessage toast)
    {
        RemoveToast(toast.Id);
        AppIssueState.RequestReportForm(new AppIssueReport
        {
            ErrorTime = toast.CreatedAt,
            CurrentPage = AppIssueState.CurrentPage,
            PreviousPage = AppIssueState.PreviousPage,
            ErrorMessage = toast.Message,
            ErrorType = "Ekranda gösterilen hata"
        });
    }

    private void RemoveToast(Guid id)
    {
        var toast = toasts.FirstOrDefault(t => t.Id == id);
        if (toast != null && toasts.Remove(toast))
        {
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        ToastService.OnShow -= ShowToast;
    }
}




