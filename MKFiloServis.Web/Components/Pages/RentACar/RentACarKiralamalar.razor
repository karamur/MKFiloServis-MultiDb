@code {
    [SupplyParameterFromQuery(Name = "sekme")] public string? Sekme { get; set; }
    private string AktifSekme => Sekme is "araclar" or "kiralamalar" or "teslim-iade" ? Sekme : "rezervasyon";

    private void AracKartindanSec(Arac arac)
    {
        if (!MusaitlikGuncel || !musaitAraclar.Any(x => x.Id == arac.Id))
        {
            rezervasyonMesaji = "Önce seçilen tarih aralığı için müsait araçları yeniden arayın.";
            rezervasyonBasarili = false;
            return;
        }

        rezervasyon.AracId = arac.Id;
        if (arac.GunlukKiraBedeli is > 0) rezervasyon.GunlukFiyat = arac.GunlukKiraBedeli.Value;
        rezervasyonMesaji = null;
        rezervasyonBasarili = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (AktifSekme == "araclar" && !MusaitlikGuncel) await MusaitAraclariGetirAsync();
        durumFiltresi = -1;
    }

    private enum RentACarBelgeTuru { Sozlesme, TeslimIade }

    private IReadOnlyList<RentACarKiralamaSatiri> kiralamalar = Array.Empty<RentACarKiralamaSatiri>();
    private IReadOnlyList<Cari> musteriler = Array.Empty<Cari>();
    private IReadOnlyList<Arac> musaitAraclar = Array.Empty<Arac>();
    private IReadOnlyList<Arac> rezervasyonluAraclar = Array.Empty<Arac>();
    private DateTime? musaitlikBaslangic;
    private DateTime? musaitlikBitis;
    private int musaitlikSorguSurumu;
    private RentACarRezervasyonTalebi rezervasyon = new()
    {
        BaslangicTarihi = DateTime.Now,
        PlanlananBitisTarihi = DateTime.Now.AddDays(1)
    };
    private bool yukleniyor = true;
    private bool musaitlikYukleniyor;
    private bool kaydediliyor;
    private bool rezervasyonBasarili;
    private string arama = string.Empty;
    private string? hataMesaji;
    private string? rezervasyonMesaji;
    private int? iptalEdilecekId;
    private string iptalNedeni = string.Empty;
    private string? iptalMesaji;
    private bool iptalEdiliyor;
    private bool iptalBasarili;
    private int? duzenlenecekId;
    private RentACarRezervasyonTalebi duzenlemeTalebi = new();
    private IReadOnlyList<Arac> duzenlemeAraclari = Array.Empty<Arac>();
    private bool duzenleniyor;
    private bool duzenlemeBasarili;
    private string? duzenlemeMesaji;
    private int durumFiltresi = -1;
    private int aracFiltreId;
    private int iadeZamaniFiltresi;
    private DateTime? baslangicFiltre;
    private DateTime? bitisFiltre;
    private RentACarKiralamaSatiri? onizlenenKiralama;
    private RentACarBelgeTuru onizlenenBelgeTuru;
    private RentACarKiralamaSatiri? aracIslemKiralama;
    private RentACarAracIslemBilgisi aracIslemBilgisi = new();
    private bool aracIadeIslemi;
    private bool aracIslemKaydediliyor;
    private bool aracIslemBasarili;
    private string? aracIslemMesaji;

    private string BelgeBasligi => onizlenenBelgeTuru == RentACarBelgeTuru.Sozlesme
        ? "Kira sözleşmesi taslağı"
        : "Teslim / iade tutanağı";

    private bool MusaitlikGuncel => musaitlikBaslangic == rezervasyon.BaslangicTarihi
        && musaitlikBitis == rezervasyon.PlanlananBitisTarihi;

    private int AktifKiralamaSayisi => kiralamalar.Count(x => x.Durum == KiralamaDurumu.Aktif);
    private int RezervasyonSayisi => kiralamalar.Count(x => x.Durum == KiralamaDurumu.Rezervasyon);
    private int TamamlananKiralamaSayisi => kiralamalar.Count(x => x.Durum == KiralamaDurumu.Tamamlandi);
    private decimal IptalHaricPlanlananTutar => kiralamalar
        .Where(x => x.Durum != KiralamaDurumu.IptalEdildi)
        .Sum(x => x.ToplamTutar);

    private static string BelgeDegeri(string? deger) => string.IsNullOrWhiteSpace(deger) ? "Belirtilmemiş" : deger;

    private void AracIslemPenceresiAc(RentACarKiralamaSatiri kiralama, bool iade)
    {
        aracIslemKiralama = kiralama;
        aracIadeIslemi = iade;
        aracIslemBilgisi = new RentACarAracIslemBilgisi
        {
            Kilometre = iade ? kiralama.BaslangicKm ?? 0 : 0
        };
        aracIslemMesaji = null;
        aracIslemBasarili = false;
    }

    private void AracIslemPenceresiKapat()
    {
        if (!aracIslemKaydediliyor)
        {
            aracIslemKiralama = null;
        }
    }

    private async Task AracIsleminiKaydetAsync()
    {
        if (aracIslemKiralama is null)
        {
            return;
        }

        aracIslemKaydediliyor = true;
        aracIslemMesaji = null;
        try
        {
            if (aracIadeIslemi)
            {
                await RezervasyonServisi.AraciIadeAlAsync(aracIslemKiralama.Id, aracIslemBilgisi);
            }
            else
            {
                await RezervasyonServisi.AraciTeslimEtAsync(aracIslemKiralama.Id, aracIslemBilgisi);
            }

            aracIslemBasarili = true;
            aracIslemMesaji = aracIadeIslemi
                ? "Araç iadesi kaydedildi ve kiralama tamamlandı."
                : "Rezervasyon aktif kiralamaya dönüştürüldü.";
            await YenileAsync();
            aracIslemKiralama = null;
        }
        catch (Exception ex)
        {
            aracIslemBasarili = false;
            aracIslemMesaji = ex.Message;
        }
        finally
        {
            aracIslemKaydediliyor = false;
        }
    }

