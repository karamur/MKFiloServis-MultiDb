@page "/rent-a-car"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using MKFiloServis.Shared.Entities
@using MKFiloServis.Web.Services
@using MKFiloServis.Web.Services.Interfaces
@using MKFiloServis.Web.Services.RentACar
@inject IRentACarKiralamaSorguServisi KiralamaSorguServisi
@inject IRentACarRezervasyonServisi RezervasyonServisi
@inject IExcelService ExcelService
@inject IPdfService PdfService
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Rent a Car</PageTitle>

<MKFiloServis.Web.Components.Shared.YetkiKontrol Yetki="rentacar.oku" GerekliYetkiAdi="Rent a Car Görüntüleme">
    <Yetkili>
<div class="container-fluid rentacar-page">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-1"><i class="bi bi-car-front-fill me-2 text-primary"></i>Rent a Car</h3>
            <p class="text-muted mb-0">Kiralama kayıtlarını görüntüleyin.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-success" @onclick="ExceleAktarAsync" disabled="@(yukleniyor || !FiltrelenmisKiralamalar.Any())">
                <i class="bi bi-file-earmark-excel me-1"></i>Filtreli Excel
            </button>
            <button class="btn btn-outline-danger" @onclick="PdfyeAktarAsync" disabled="@(yukleniyor || !FiltrelenmisKiralamalar.Any())">
                <i class="bi bi-file-earmark-pdf me-1"></i>Filtreli PDF
            </button>
            <button class="btn btn-outline-primary" @onclick="YenileAsync" disabled="@(yukleniyor)">
                <i class="bi bi-arrow-clockwise me-1"></i>Yenile
            </button>
        </div>
    </div>

    <RentACarAltMenu Aktif="@AktifSekme" />
    @if (AktifSekme is "rezervasyon" or "araclar")
    {
    <MKFiloServis.Web.Components.Shared.YetkiKontrol Yetki="rentacar.rezervasyon.yaz" GerekliYetkiAdi="Rent a Car Rezervasyon Oluşturma">
        <Yetkili>
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-calendar-plus me-2"></i>Yeni Rezervasyon
                </div>
                <div class="card-body">
                    <EditForm Model="rezervasyon" OnValidSubmit="RezervasyonOlusturAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />
                        <div class="row g-3 align-items-end">
                            <div class="col-md-3">
                                <label class="form-label">Müşteri</label>
                                <InputSelect class="form-select" @bind-Value="rezervasyon.MusteriId">
                                    <option value="0">Müşteri seçin</option>
                                    @foreach (var musteri in musteriler)
                                    {
                                        <option value="@musteri.Id">@musteri.Unvan</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => rezervasyon.MusteriId)" class="text-danger" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Başlangıç</label>
                                <InputDate class="form-control" Type="InputDateType.DateTimeLocal" @bind-Value="rezervasyon.BaslangicTarihi" @bind-Value:after="() => RezervasyonTarihiDegisti()" />
                                <ValidationMessage For="@(() => rezervasyon.BaslangicTarihi)" class="text-danger" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Planlanan iade</label>
                                <InputDate class="form-control" Type="InputDateType.DateTimeLocal" @bind-Value="rezervasyon.PlanlananBitisTarihi" @bind-Value:after="() => RezervasyonTarihiDegisti()" />
                                <ValidationMessage For="@(() => rezervasyon.PlanlananBitisTarihi)" class="text-danger" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Günlük fiyat (₺)</label>
                                <InputNumber class="form-control" @bind-Value="rezervasyon.GunlukFiyat" />
                                <ValidationMessage For="@(() => rezervasyon.GunlukFiyat)" class="text-danger" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Depozito (₺)</label>
                                <InputNumber class="form-control" @bind-Value="rezervasyon.Depozito" />
                                <ValidationMessage For="@(() => rezervasyon.Depozito)" class="text-danger" />
                            </div>
                            <div class="col-md-2 d-grid">
                                 <button type="button" class="btn btn-outline-primary" @onclick="MusaitAraclariGetirAsync" disabled="@musaitlikYukleniyor">
                                    @if (musaitlikYukleniyor)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span><span>Araçlar aranıyor</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-search me-1"></i><span>Müsait araçları bul</span>
                                    }
                                </button>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Müsait araç (@(MusaitlikGuncel ? musaitAraclar.Count : 0))</label>
                                <InputSelect class="form-select" @bind-Value="rezervasyon.AracId" disabled="@(!MusaitlikGuncel || musaitAraclar.Count == 0)">
                                    <option value="0">Araç seçin</option>
                                    @foreach (var arac in musaitAraclar)
                                    {
                                        <option value="@arac.Id">@arac.AktifPlaka — @arac.Marka @arac.Model</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => rezervasyon.AracId)" class="text-danger" />
                                @if (!musaitlikYukleniyor && MusaitlikGuncel && musaitAraclar.Count == 0)
                                {
                                    <small class="text-danger d-block mt-1">
                                        Bu tarih aralığında müsait araç bulunamadı. Boşta/Kiralık durumundaki araçlar çakışan sözleşmeler nedeniyle ayrılmış olabilir.
                                        @if (rezervasyonluAraclar.Count > 0) { <span>@rezervasyonluAraclar.Count araç aşağıda sözleşme çakışması nedeniyle gösteriliyor.</span> }
                                    </small>
                                }
                                else if (MusaitlikGuncel && musaitAraclar.Count > 0)
                                {
                                    <small class="text-success d-block mt-1">@musaitAraclar.Count araç bu tarih aralığında müsait.</small>
                                }
                                else
                                {
                                    <small class="text-muted d-block mt-1">Tarih aralığı için önce müsait araçları arayın.</small>
                                }
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Not</label>
                                <InputText class="form-control" @bind-Value="rezervasyon.Notlar" maxlength="500" />
                                <ValidationMessage For="@(() => rezervasyon.Notlar)" class="text-danger" />
                            </div>
                            <div class="col-md-2 d-grid">
                                 <button type="submit" class="btn btn-primary" disabled="@(kaydediliyor || !MusaitlikGuncel || rezervasyon.AracId <= 0 || musaitAraclar.Count == 0)">
                                    @if (kaydediliyor)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    Rezervasyon Oluştur
                                </button>
                            </div>
                        </div>
                        @if (MusaitlikGuncel)
                        {
                            <h5 class="mt-4">Müsait araçlar</h5>
                            <p class="text-muted">Seçilen tarih aralığına uygun aracın kartındaki “Aracı seç” düğmesini kullanın. Kayıt sırasında müsaitlik yeniden kontrol edilir.</p>
                            <div class="row g-3">
                                @foreach (var arac in musaitAraclar)
                                {
                                    <div class="col-md-4 col-xl-3" @key="arac.Id">
                                        <div class="card h-100 @(rezervasyon.AracId == arac.Id ? "border-primary" : "border-success")">
                                            <div class="card-body">
                                                <h6>@arac.AktifPlaka</h6>
                                                <p>@arac.Marka @arac.Model</p>
                                                <span class="badge bg-success mb-2">Seçilen tarihlerde müsait</span>
                                                <button type="button" class="btn btn-outline-primary w-100" aria-pressed="@(rezervasyon.AracId == arac.Id)" @onclick="() => AracKartindanSec(arac)">
                                                    @(rezervasyon.AracId == arac.Id ? "Seçildi" : "Aracı seç")
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                            @if (rezervasyonluAraclar.Count > 0)
                            {
                                <div class="alert alert-warning mt-4 mb-2">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                    Aşağıdaki araçların seçilen tarih aralığında rezervasyon veya kiralama sözleşmesi vardır ve seçilemez.
                                </div>
                                <div class="row g-3">
                                    @foreach (var rezervasyonluArac in rezervasyonluAraclar)
                                    {
                                        <div class="col-md-4 col-xl-3" @key="rezervasyonluArac.Id">
                                            <div class="card h-100 border-danger bg-danger-subtle">
                                                <div class="card-body">
                                                    <h6>@rezervasyonluArac.AktifPlaka</h6>
                                                    <p>@rezervasyonluArac.Marka @rezervasyonluArac.Model</p>
                                                    <span class="badge bg-danger">Bu tarihlerde sözleşmesi var</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                                }
                            </div>
                        }
                    </EditForm>
                    @if (!string.IsNullOrWhiteSpace(rezervasyonMesaji))
                    {
                        <div class="alert @(rezervasyonBasarili ? "alert-success" : "alert-danger") mt-3 mb-0">@rezervasyonMesaji</div>
                    }
                </div>
            </div>
        </Yetkili>
    </MKFiloServis.Web.Components.Shared.YetkiKontrol>
    }

<style>
    @@media print {
        body * { visibility: hidden !important; }
        .rentacar-document-preview,
        .rentacar-document-preview * { visibility: visible !important; }
        .rentacar-document-preview {
            position: absolute !important;
            inset: 0 !important;
            display: block !important;
            overflow: visible !important;
            padding: 0 !important;
            background: #fff !important;
        }
        .rentacar-document-preview .modal-dialog,
        .rentacar-document-preview .modal-content,
        .rentacar-document-preview .modal-body {
            width: 100% !important;
            max-width: none !important;
            height: auto !important;
            max-height: none !important;
            margin: 0 !important;
            overflow: visible !important;
            border: 0 !important;
            box-shadow: none !important;
            background: #fff !important;
        }
        .rentacar-print-sheet { width: 100% !important; padding: 0 !important; }
        .rentacar-document-preview .d-print-none { display: none !important; }
        .rentacar-document-preview .d-print-block { display: block !important; }
    }
</style>

    @if (!string.IsNullOrWhiteSpace(hataMesaji))
    {
        <div class="alert alert-danger">@hataMesaji</div>
    }

    @if (AktifSekme is "kiralamalar" or "teslim-iade")
    {
    <div class="row g-2 mb-3">
        <div class="col-md-3">
            <div class="card border-primary h-100">
                <div class="card-body py-2">
                    <small class="text-muted d-block">Aktif kiralama</small>
                    <span class="fs-4 fw-bold text-primary">@AktifKiralamaSayisi</span>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-info h-100">
                <div class="card-body py-2">
                    <small class="text-muted d-block">Rezervasyon</small>
                    <span class="fs-4 fw-bold text-info">@RezervasyonSayisi</span>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-secondary h-100">
                <div class="card-body py-2">
                    <small class="text-muted d-block">Tamamlanan</small>
                    <span class="fs-4 fw-bold text-secondary">@TamamlananKiralamaSayisi</span>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-success h-100">
                <div class="card-body py-2">
                    <small class="text-muted d-block">İptal dışı planlanan toplam</small>
                    <span class="fs-5 fw-bold text-success">@IptalHaricPlanlananTutar.ToString("N2") ₺</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label for="kiralamaAra" class="form-label">Sözleşme, müşteri veya plaka ara</label>
                    <input id="kiralamaAra" class="form-control" @bind="arama" @bind:event="oninput" placeholder="Arama metni..." />
                </div>
                <div class="col-md-2">
                    <label for="durumFiltresi" class="form-label">Durum</label>
                    <select id="durumFiltresi" class="form-select" @bind="durumFiltresi">
                        <option value="-1">Tüm durumlar</option>
                        @foreach (var durum in Enum.GetValues<KiralamaDurumu>())
                        {
                            <option value="@((int)durum)">@durum</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="iadeZamaniFiltresi" class="form-label">İade zamanı</label>
                    <select id="iadeZamaniFiltresi" class="form-select" @bind="iadeZamaniFiltresi">
                        <option value="0">Tüm iade zamanları</option>
                        <option value="1">İadesi gecikmiş</option>
                        <option value="2">İade yaklaşıyor (24 saat)</option>
                        <option value="3">Süresi var (&gt;24 saat)</option>
                        <option value="4">İade edilmiş</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="aracFiltre" class="form-label">Araç / plaka</label>
                    <select id="aracFiltre" class="form-select" @bind="aracFiltreId">
                        <option value="0">Tüm araçlar</option>
                        @foreach (var arac in FiltreAraclari)
                        {
                            <option value="@arac.Id">@arac.Plaka — @arac.AracTanimi</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="baslangicFiltre" class="form-label">Başlangıç tarihi (ilk)</label>
                    <InputDate id="baslangicFiltre" class="form-control" @bind-Value="baslangicFiltre" />
                </div>
                <div class="col-md-2">
                    <label for="bitisFiltre" class="form-label">Başlangıç tarihi (son)</label>
                    <InputDate id="bitisFiltre" class="form-control" @bind-Value="bitisFiltre" />
                </div>
                <div class="col-md-2 d-grid">
                    <button class="btn btn-outline-secondary" @onclick="FiltreleriTemizle">
                        <i class="bi bi-x-circle me-1"></i>Filtreleri temizle
                    </button>
                </div>
            </div>
            <small class="text-muted d-block mt-2">@FiltrelenmisKiralamalar.Count kayıt listeleniyor. Toplam tutar, iptal dışı kayıtların planlanan tutarlarının toplamıdır.</small>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Sözleşme</th>
                        <th>Müşteri</th>
                        <th>Araç</th>
                        <th>Plaka</th>
                        <th>Başlangıç</th>
                        <th>Planlanan iade</th>
                        <th>Durum</th>
                        <th class="text-end">Tutar</th>
                        <th>Ödeme</th>
                        <th>İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @if (yukleniyor)
                    {
                        <tr><td colspan="10" class="text-center py-4"><span class="spinner-border spinner-border-sm me-2"></span>Yükleniyor...</td></tr>
                    }
                    else if (FiltrelenmisKiralamalar.Count == 0)
                    {
                        <tr><td colspan="10" class="text-center text-muted py-4">Görüntülenecek kiralama kaydı bulunamadı.</td></tr>
                    }
                    else
                    {
                        @foreach (var kiralama in FiltrelenmisKiralamalar)
                        {
                            <tr>
                                <td>@(kiralama.SozlesmeNo ?? "-")</td>
                                <td>@kiralama.MusteriUnvan</td>
                                <td>@(string.IsNullOrWhiteSpace(kiralama.AracTanimi) ? "-" : kiralama.AracTanimi)</td>
                                <td>@(string.IsNullOrWhiteSpace(kiralama.Plaka) ? "-" : kiralama.Plaka)</td>
                                <td>@kiralama.BaslangicTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@kiralama.PlanlananBitisTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                <td><span class="badge @DurumSinifi(kiralama.Durum)">@kiralama.Durum</span></td>
                                <td class="text-end">@kiralama.ToplamTutar.ToString("N2") ₺</td>
                                <td>@kiralama.OdemeDurumu</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => BelgeOnizle(kiralama, RentACarBelgeTuru.Sozlesme)" title="Sözleşme taslağını ön izle">
                                        <i class="bi bi-file-earmark-text me-1"></i>Sözleşme
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => BelgeOnizle(kiralama, RentACarBelgeTuru.TeslimIade)" title="Teslim/iade tutanağını ön izle">
                                        <i class="bi bi-clipboard-check me-1"></i>Teslim/iade
                                    </button>
                                    @if (kiralama.Durum == KiralamaDurumu.Rezervasyon)
                                    {
                                        <MKFiloServis.Web.Components.Shared.YetkiKontrol Yetki="rentacar.rezervasyon.yaz" GerekliYetkiAdi="Rent a Car Araç Teslimi">
                                            <Yetkili>
                                                <button class="btn btn-sm btn-outline-success me-1" @onclick="() => AracIslemPenceresiAc(kiralama, false)">
                                                    <i class="bi bi-box-arrow-up-right me-1"></i>Kiralamaya dönüştür
                                                </button>
                                            </Yetkili>
                                        </MKFiloServis.Web.Components.Shared.YetkiKontrol>
                                    }
                                    else if (kiralama.Durum == KiralamaDurumu.Aktif)
                                    {
                                        <MKFiloServis.Web.Components.Shared.YetkiKontrol Yetki="rentacar.rezervasyon.yaz" GerekliYetkiAdi="Rent a Car Araç İadesi">
                                            <Yetkili>
                                                <button class="btn btn-sm btn-outline-warning me-1" @onclick="() => AracIslemPenceresiAc(kiralama, true)">
                                                    <i class="bi bi-box-arrow-in-down-left me-1"></i>İadeyi kaydet
                                                </button>
                                            </Yetkili>
                                        </MKFiloServis.Web.Components.Shared.YetkiKontrol>
                                    }
                                    @if (kiralama.Durum == KiralamaDurumu.Rezervasyon)
                                    {
                                        <MKFiloServis.Web.Components.Shared.YetkiKontrol Yetki="rentacar.rezervasyon.yaz" GerekliYetkiAdi="Rent a Car Rezervasyon Düzenleme">
                                            <Yetkili>
                                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => DuzenlemePenceresiAc(kiralama)">
                                                    <i class="bi bi-pencil me-1"></i>Düzenle
                                                </button>
                                            </Yetkili>
                                        </MKFiloServis.Web.Components.Shared.YetkiKontrol>
                                        <MKFiloServis.Web.Components.Shared.YetkiKontrol Yetki="rentacar.rezervasyon.iptal" GerekliYetkiAdi="Rent a Car Rezervasyon İptali">
                                            <Yetkili>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => IptalPenceresiAc(kiralama.Id)">
                                                    <i class="bi bi-x-circle me-1"></i>İptal
                                                </button>
                                            </Yetkili>
                                        </MKFiloServis.Web.Components.Shared.YetkiKontrol>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    }

    @if (onizlenenKiralama is not null)
    {
        <div class="rentacar-document-preview modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,.55);">
            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header d-print-none">
                        <div>
                            <h5 class="modal-title">@BelgeBasligi</h5>
                            <small class="text-muted">Ön izleme — bilgileri kontrol edin, ardından yazdırın veya PDF olarak kaydedin.</small>
                        </div>
                        <button type="button" class="btn-close" aria-label="Kapat" @onclick="BelgeOnizlemeyiKapat"></button>
                    </div>
                    <div class="modal-body bg-body-secondary">
                        <article class="rentacar-print-sheet bg-white mx-auto p-4 p-md-5">
                            <header class="text-center border-bottom pb-3 mb-4">
                                <h2 class="h4 mb-1">@(onizlenenBelgeTuru == RentACarBelgeTuru.Sozlesme ? "ARAÇ KİRALAMA SÖZLEŞMESİ TASLAĞI" : "ARAÇ TESLİM / İADE TUTANAĞI")</h2>
                                <div class="text-muted">Sözleşme / kayıt no: @(onizlenenKiralama.SozlesmeNo ?? "-")</div>
                            </header>

                            <div class="alert alert-warning py-2 d-print-none">
                                Bu belge, sistem verilerinden oluşturulan kontrol taslağıdır. Resmî/yasal kullanımdan önce şirket yetkilisi ve hukuk danışmanı tarafından incelenip onaylanmalıdır.
                            </div>
                            <p class="small border rounded p-2 d-none d-print-block">
                                Taslak belge — resmî kullanım öncesinde yetkili onayı ve mevzuata uygunluk kontrolü gerekir.
                            </p>

                            <h3 class="h6 mt-4">Kiraya veren</h3>
                            <p>
                                <strong>@BelgeDegeri(onizlenenKiralama.FirmaUnvan)</strong><br />
                                @if (!string.IsNullOrWhiteSpace(onizlenenKiralama.FirmaVergiDairesi) || !string.IsNullOrWhiteSpace(onizlenenKiralama.FirmaVergiNo))
                                {
                                    <span>Vergi dairesi/no: @BelgeDegeri(onizlenenKiralama.FirmaVergiDairesi) / @BelgeDegeri(onizlenenKiralama.FirmaVergiNo)<br /></span>
                                }
                                @BelgeDegeri(onizlenenKiralama.FirmaAdres)<br />
                                @BelgeDegeri(onizlenenKiralama.FirmaTelefon)
                            </p>

                            <h3 class="h6 mt-4">Kiracı</h3>
                            <p>
                                <strong>@onizlenenKiralama.MusteriUnvan</strong><br />
                                @if (!string.IsNullOrWhiteSpace(onizlenenKiralama.MusteriKimlikNo))
                                {
                                    <span>T.C. kimlik no: @onizlenenKiralama.MusteriKimlikNo<br /></span>
                                }
                                @if (!string.IsNullOrWhiteSpace(onizlenenKiralama.MusteriVergiNo))
                                {
