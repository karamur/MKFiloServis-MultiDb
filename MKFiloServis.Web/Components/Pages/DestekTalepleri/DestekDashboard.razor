@page "/destek-talepleri/dashboard"
@rendermode InteractiveServer
@using MKFiloServis.Web.Services.Destek
@inject IDestekTalebiService DestekService

<PageTitle>Destek Dashboard</PageTitle>

<div class="container-fluid pb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div><h3 class="mb-1"><i class="bi bi-speedometer2 text-primary me-2"></i>Destek Dashboard</h3><div class="text-muted small">Talepler, ekip performansı ve dönem eğilimleri</div></div>
        <a class="btn btn-outline-primary" href="/destek-talepleri"><i class="bi bi-ticket-detailed me-1"></i>Tüm Talepler</a>
    </div>

    @if (yetkisiz)
    {
        <div class="alert alert-warning">Bu ekran destek yöneticisi veya destek personeli yetkisi gerektirir.</div>
    }
    else if (hata != null)
    {
        <div class="alert alert-danger">@hata <button class="btn btn-sm btn-outline-danger ms-2" @onclick="YukleAsync">Yeniden dene</button></div>
    }
    else if (yukleniyor)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else if (genel != null && donem != null)
    {
        <div class="row g-2 mb-3">
            @foreach (var kart in new (string Baslik, string Deger, string Renk)[] {
                ("Toplam talep", genel.ToplamTalepSayisi.ToString(), "primary"),
                ("Açık", genel.AcikTalepSayisi.ToString(), "warning"),
                ("Onay bekleyen", genel.OnayBekleyenTalepSayisi.ToString(), "info"),
                ("SLA aşımı", genel.SlaAsildiSayisi.ToString(), "danger"),
                ("Bugün açılan", genel.BugunAcilanTalepSayisi.ToString(), "success"),
                ("Bugün kapanan", genel.BugunKapatilanTalepSayisi.ToString(), "secondary") })
            {
                <div class="col-6 col-lg-2"><div class="card h-100 border-0 shadow-sm"><div class="card-body py-3"><div class="small text-muted">@kart.Baslik</div><div class="fs-3 fw-bold text-@kart.Renk">@kart.Deger</div></div></div></div>
            }
        </div>

        <div class="card mb-3 shadow-sm">
            <div class="card-header fw-semibold">Dönem raporu</div>
            <div class="card-body">
                <div class="row g-2 align-items-end mb-3">
                    <div class="col-sm-4 col-lg-3"><label class="form-label" for="destekBaslangic">Başlangıç</label><input id="destekBaslangic" type="date" class="form-control" @bind="baslangic" @bind:format="yyyy-MM-dd" /></div>
                    <div class="col-sm-4 col-lg-3"><label class="form-label" for="destekBitis">Bitiş</label><input id="destekBitis" type="date" class="form-control" @bind="bitis" @bind:format="yyyy-MM-dd" /></div>
                    <div class="col-sm-4 col-lg-3"><label class="form-label" for="destekDepartman">Departman</label><select id="destekDepartman" class="form-select" @bind="departmanId"><option value="">Tüm departmanlar</option>@foreach (var d in departmanlar) { <option value="@d.Id">@d.Ad</option> }</select></div>
                    <div class="col-lg-3"><button class="btn btn-primary w-100" @onclick="YukleAsync" disabled="@yukleniyor"><i class="bi bi-arrow-clockwise me-1"></i>Raporu güncelle</button></div>
                </div>
                <div class="row g-2 text-center">
                    <div class="col-6 col-lg-3"><div class="border rounded p-3"><div class="fs-4 fw-bold">@donem.ToplamAcilanTalep</div><div class="small text-muted">Açılan</div></div></div>
                    <div class="col-6 col-lg-3"><div class="border rounded p-3"><div class="fs-4 fw-bold">@donem.ToplamKapatilanTalep</div><div class="small text-muted">Kapanan</div></div></div>
                    <div class="col-6 col-lg-3"><div class="border rounded p-3"><div class="fs-4 fw-bold">@donem.ToplamSlaAsimi</div><div class="small text-muted">SLA aşımı</div></div></div>
                    <div class="col-6 col-lg-3"><div class="border rounded p-3"><div class="fs-4 fw-bold">@donem.OrtalamaCozumSuresiDakika.ToString("N0") dk</div><div class="small text-muted">Ortalama çözüm</div></div></div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-lg-6"><div class="card h-100 shadow-sm"><div class="card-header fw-semibold">Durum dağılımı · tüm zamanlar</div><div class="card-body">@foreach (var x in genel.DurumDagilimi.OrderByDescending(x => x.Value)) { <div class="d-flex justify-content-between small mb-1"><span>@DestekKurallari.Etiket(x.Key)</span><strong>@x.Value</strong></div><div class="progress mb-2" style="height:8px"><div class="progress-bar" style="width:@Yuzde(x.Value, genel.ToplamTalepSayisi)%"></div></div> }</div></div></div>
            <div class="col-lg-6"><div class="card h-100 shadow-sm"><div class="card-header fw-semibold">Kaynak dağılımı · tüm zamanlar</div><div class="card-body">@foreach (var x in genel.KaynakDagilimi.OrderByDescending(x => x.Value)) { <div class="d-flex justify-content-between small mb-1"><span>@DestekKurallari.KaynakEtiketi(x.Key)</span><strong>@x.Value</strong></div><div class="progress mb-2" style="height:8px"><div class="progress-bar bg-info" style="width:@Yuzde(x.Value, genel.ToplamTalepSayisi)%"></div></div> }</div></div></div>
            <div class="col-lg-6"><div class="card h-100 shadow-sm"><div class="card-header fw-semibold">Açık talepler · departman</div><div class="card-body">@foreach (var x in genel.DepartmanDagilimi.OrderByDescending(x => x.Value)) { <div class="d-flex justify-content-between small mb-1"><span>@x.Key</span><strong>@x.Value</strong></div><div class="progress mb-2" style="height:8px"><div class="progress-bar bg-warning" style="width:@Yuzde(x.Value, genel.AcikTalepSayisi)%"></div></div> }</div></div></div>
            <div class="col-lg-6"><div class="card h-100 shadow-sm"><div class="card-header fw-semibold">Hizmet kalitesi · tüm zamanlar</div><div class="card-body"><p>İlk yanıt: <strong>@Saat(genel.OrtalamaIlkYanitSuresiSaat)</strong></p><p>Çözüm: <strong>@Saat(genel.OrtalamaCozumSuresiSaat)</strong></p><p class="mb-0">Memnuniyet: <strong>@(genel.OrtalamaMemuniyetPuani?.ToString("N1") ?? "—") / 5</strong></p></div></div></div>
        </div>

        <div class="card mb-3 shadow-sm"><div class="card-header fw-semibold">Günlük eğilim · seçilen dönem</div><div class="table-responsive" style="max-height:360px;overflow:auto"><table class="table table-sm table-hover mb-0"><thead class="table-light"><tr><th>Tarih</th><th class="text-end">Açılan</th><th class="text-end">Kapanan</th></tr></thead><tbody>@foreach (var gun in donem.GunlukTrend.OrderByDescending(x => x.Tarih)) { <tr><td>@gun.Tarih.ToString("dd.MM.yyyy")</td><td class="text-end">@gun.AcilanTalep</td><td class="text-end">@gun.KapatilanTalep</td></tr> }</tbody></table></div></div>
        <div class="card mb-3 shadow-sm"><div class="card-header fw-semibold">Ekip performansı · seçilen dönem</div><div class="table-responsive"><table class="table table-sm table-hover mb-0"><thead class="table-light"><tr><th>Personel</th><th class="text-end">Atanan</th><th class="text-end">Çözülen</th><th class="text-end">Yanıt</th><th class="text-end">SLA aşımı</th><th class="text-end">Ort. çözüm</th></tr></thead><tbody>@foreach (var kisi in performans) { <tr><td>@kisi.KullaniciAdi</td><td class="text-end">@kisi.AtananTalepSayisi</td><td class="text-end">@kisi.CozulenTalepSayisi</td><td class="text-end">@kisi.ToplamYanitSayisi</td><td class="text-end">@kisi.SlaAsimSayisi</td><td class="text-end">@kisi.OrtalamaCozumSuresiDakika.ToString("N0") dk</td></tr> }</tbody></table></div></div>
        <div class="card shadow-sm"><div class="card-header fw-semibold">Son talepler</div><div class="table-responsive"><table class="table table-sm table-hover mb-0"><thead class="table-light"><tr><th>No</th><th>Konu</th><th>Durum</th><th>Departman</th><th>Oluşturulma</th></tr></thead><tbody>@foreach (var talep in genel.SonTalepler) { <tr><td><a href="/destek-talepleri/@talep.Id">@talep.TalepNo</a></td><td>@talep.Konu</td><td><DestekDurumRozeti Durum="talep.Durum" /></td><td>@talep.Departman?.Ad</td><td>@MKFiloServis.Shared.Time.BusinessTime.LocalAt(talep.CreatedAt).ToString("dd.MM.yyyy HH:mm")</td></tr> }</tbody></table></div></div>
    }
</div>

@code {
    private DateTime baslangic = DateTime.Today.AddDays(-29);
    private DateTime bitis = DateTime.Today;
    private int? departmanId;
    private bool yukleniyor = true;
    private bool yetkisiz;
    private string? hata;
    private DestekDashboardStats? genel;
    private DestekRaporStats? donem;
    private List<DestekPerformansRapor> performans = [];
    private List<DestekDepartman> departmanlar = [];

    protected override async Task OnInitializedAsync() => await YukleAsync();

    private async Task YukleAsync()
    {
        yukleniyor = true;
        hata = null;
        try
        {
            var aktor = await DestekService.GetAktifKullaniciAsync();
            if (aktor?.Personel != true) { yetkisiz = true; return; }
            if (bitis.Date < baslangic.Date) throw new InvalidOperationException("Bitiş tarihi başlangıçtan önce olamaz.");
            var tz = TimeZoneInfo.FindSystemTimeZoneById("Europe/Istanbul");
            var ilk = TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(baslangic.Date, DateTimeKind.Unspecified), tz);
            var son = TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(bitis.Date.AddDays(1), DateTimeKind.Unspecified), tz).AddTicks(-1);
            departmanlar = await DestekService.GetDepartmanlarAsync(pasiflerDahil: true);
            genel = await DestekService.GetDashboardStatsAsync();
            donem = await DestekService.GetRaporStatsAsync(ilk, son, departmanId);
            performans = await DestekService.GetPersonelPerformansRaporuAsync(ilk, son, departmanId);
        }
        catch (Exception ex) { hata = ex.GetBaseException().Message; }
        finally { yukleniyor = false; }
    }

    private static int Yuzde(int sayi, int toplam) => toplam <= 0 ? 0 : Math.Clamp((int)Math.Round(sayi * 100.0 / toplam), 0, 100);
    private static string Saat(double? deger) => deger.HasValue ? $"{deger.Value:N1} sa" : "—";
}
