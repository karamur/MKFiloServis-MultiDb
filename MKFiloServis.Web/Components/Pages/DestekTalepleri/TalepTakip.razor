@page "/destek-talepleri/talep-takip/{TalepId:int}"
@rendermode InteractiveServer
@inject IDestekTalebiService DestekService
@inject IToastService ToastService
@inject NavigationManager Navigation

<PageTitle>Talep Takip - @detay?.Talep.TalepNo</PageTitle>

@if (yukleniyor)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2">Yükleniyor...</p>
    </div>
}
else if (detay == null)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-2"></i>@(yuklemeHatasi ?? "Talep bulunamadı ya da bu talebi görme yetkiniz yok.")
        <a href="destek-talepleri/taleplerim" class="alert-link ms-2">Taleplerime Dön</a>
    </div>
}
else
{
    var talep = detay.Talep;
    <div class="container-fluid">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <a href="destek-talepleri/taleplerim" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Geri</a>
                <span class="h4 mb-0"><span class="text-muted">#</span>@talep.TalepNo</span>
                <DestekDurumRozeti Durum="talep.Durum" />
                <DestekOncelikRozeti Oncelik="talep.Oncelik" />
            </div>
            @if (detay.Isleyebilir)
            {
                <a href="destek-talepleri/@talep.Id" class="btn btn-outline-primary btn-sm"><i class="bi bi-headset me-1"></i>Ekip görünümü</a>
            }
        </div>

        <div class="alert @(OnemliDurum(talep.Durum) ? "alert-info" : "alert-light border") d-flex flex-wrap align-items-center gap-2">
            <i class="bi @DestekKurallari.Ikon(talep.Durum) fs-5"></i>
            <div class="flex-grow-1">@DestekKurallari.TalepEdenAciklamasi(talep.Durum)</div>
            @* Bu ekran talep edenindir: yalnız sahibin işlemleri (gönder, onayla, itiraz) gösterilir. *@
            <DestekEylemDugmeleri Eylemler="@(detay.Eylemler.Where(e => (e.Roller & DestekRol.Sahip) != 0).ToList())" OnSec="EylemSec" Devre="kaydediliyor" Kucuk="true" />
        </div>

        <div class="row g-3">
            <div class="col-lg-8">
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                            @foreach (var adim in DestekKurallari.TakipAdimlari(talep.Durum))
                            {
                                var gecildi = DestekKurallari.AdimGecildi(talep.Durum, adim);
                                var simdiki = adim == talep.Durum || (adim == DestekDurum.Islemde && talep.Durum == DestekDurum.BilgiBekleniyor);
                                <div class="text-center flex-fill" style="min-width: 72px;">
                                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center text-white @(simdiki ? "bg-primary" : gecildi ? "bg-success" : "bg-secondary bg-opacity-50")"
                                         style="width: 40px; height: 40px;">
                                        <i class="bi @DestekKurallari.Ikon(adim)"></i>
                                    </div>
                                    <div class="small mt-1 @(simdiki ? "fw-bold" : string.Empty)">@DestekKurallari.Etiket(adim)</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header"><h5 class="mb-0">@talep.Konu</h5></div>
                    <div class="card-body">
                        <DestekMetni Metin="@talep.Aciklama" />
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header"><h6 class="mb-0"><i class="bi bi-chat-dots me-2"></i>Mesajlar</h6></div>
                    <div class="card-body">
                        <DestekYazisma Yanitlar="detay.Yanitlar" Ekler="detay.Ekler" TalepEdenAdi="@talep.MusteriAdi" />
                    </div>
                    @if (detay.MesajYazilabilir)
                    {
                        <div class="card-footer">
                            @if (talep.Durum == DestekDurum.BilgiBekleniyor)
                            {
                                <div class="small text-info-emphasis mb-2"><i class="bi bi-info-circle me-1"></i>Yanıtınızı gönderdiğinizde talep yeniden işleme alınır.</div>
                            }
                            <label class="visually-hidden" for="ttMesaj">Mesajınız</label>
                            <textarea id="ttMesaj" class="form-control mb-2" rows="3" @bind="yeniMesaj" @bind:event="oninput" placeholder="Mesajınızı yazın..."></textarea>
                            <div class="text-end">
                                <button class="btn btn-primary" @onclick="MesajGonderAsync" disabled="@(kaydediliyor || string.IsNullOrWhiteSpace(yeniMesaj))">
                                    @if (kaydediliyor)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    <i class="bi bi-send me-1"></i>Gönder
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <DestekEkler TalepId="talep.Id" Ekler="detay.Ekler" YuklemeAcik="@(talep.Durum != DestekDurum.Kapali)" OnDegisti="YukleAsync" />
            </div>

            <div class="col-lg-4">
                <div class="card mb-3">
                    <div class="card-header"><h6 class="mb-0"><i class="bi bi-person-badge me-2"></i>İlgilenen Yetkili</h6></div>
                    <div class="card-body">
                        @if (talep.AtananKullanici != null)
                        {
                            <div class="d-flex align-items-center">
                                <i class="bi bi-person-circle fs-2 text-primary me-3"></i>
                                <div>
                                    <strong>@talep.AtananKullanici.AdSoyad</strong>
                                    <div class="small text-muted">@talep.Departman?.Ad</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-muted text-center small"><i class="bi bi-hourglass-split fs-3 d-block mb-2"></i>Talebiniz henüz bir yetkiliye atanmadı.</div>
                        }
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header"><h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>Talep Bilgileri</h6></div>
                    <div class="card-body small">
                        <div class="d-flex justify-content-between mb-1"><span class="text-muted">Departman</span><span>@(talep.Departman?.Ad ?? "-")</span></div>
                        <div class="d-flex justify-content-between mb-1"><span class="text-muted">Kategori</span><span>@(talep.Kategori?.Ad ?? "-")</span></div>
                        <div class="d-flex justify-content-between mb-1"><span class="text-muted">Oluşturulma</span><span>@MKFiloServis.Shared.Time.BusinessTime.LocalAt(talep.CreatedAt).ToString("dd.MM.yyyy HH:mm")</span></div>
                        @if (talep.KapatilmaTarihi.HasValue)
                        {
                            <div class="d-flex justify-content-between mb-1"><span class="text-muted">Kapanma</span><span>@MKFiloServis.Shared.Time.BusinessTime.LocalAt(talep.KapatilmaTarihi.Value).ToString("dd.MM.yyyy HH:mm")</span></div>
                        }
                        @if (talep.MemnuniyetPuani.HasValue)
                        {
                            <div class="d-flex justify-content-between"><span class="text-muted">Memnuniyetiniz</span><span class="text-warning">@(new string('★', talep.MemnuniyetPuani.Value))</span></div>
                        }
                    </div>
                </div>

                <div class="card">
                    <div class="card-header"><h6 class="mb-0"><i class="bi bi-clock-history me-2"></i>Geçmiş</h6></div>
                    <div class="card-body p-0" style="max-height: 420px; overflow-y: auto;">
                        <DestekZamanCizelgesi Aktiviteler="detay.Aktiviteler" TalepEdenGorunumu="true" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <DestekEylemPenceresi Tanim="acikEylem" TalepBasligi="@($"{talep.TalepNo} · {talep.Konu}")" Kaydediliyor="kaydediliyor"
                          OnOnayla="EylemOnaylandiAsync" OnKapat="() => acikEylem = null" />
}

@code {
    [Parameter] public int TalepId { get; set; }

    private DestekTalepDetayi? detay;
    private bool yukleniyor = true;
    private bool kaydediliyor;
    private string? yuklemeHatasi;
    private string yeniMesaj = string.Empty;
    private DestekEylemTanimi? acikEylem;

    protected override async Task OnParametersSetAsync()
    {
        await YukleAsync();
    }

    private async Task YukleAsync()
    {
        try
        {
            yuklemeHatasi = null;
            detay = await DestekService.GetDetayAsync(TalepId);
            if (detay?.Talep.Durum == DestekDurum.Taslak)
                Navigation.NavigateTo($"destek-talepleri/talep-giris/{TalepId}");
        }
        catch (Exception ex)
        {
            detay = null;
            yuklemeHatasi = $"Talep yüklenemedi: {ex.GetBaseException().Message}";
        }
        finally
        {
            yukleniyor = false;
        }
    }

    private static bool OnemliDurum(DestekDurum durum) => durum is DestekDurum.BilgiBekleniyor or DestekDurum.Cozuldu;

    private async Task MesajGonderAsync()
    {
        if (string.IsNullOrWhiteSpace(yeniMesaj)) return;

        kaydediliyor = true;
        try
        {
            await DestekService.YanitEkleAsync(TalepId, new DestekYanitIstegi { Icerik = yeniMesaj });
            yeniMesaj = string.Empty;
            ToastService.ShowSuccess("Mesajınız gönderildi.");
            await YukleAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Mesaj gönderilemedi: {ex.GetBaseException().Message}");
        }
        finally
        {
            kaydediliyor = false;
        }
    }

    private async Task EylemSec(DestekEylemTanimi tanim)
    {
        if (tanim.NotZorunlu || tanim.Eylem == DestekEylem.Onayla)
        {
            acikEylem = tanim;
            return;
        }
        await EylemUygulaAsync(tanim, new DestekEylemIstegi());
    }

    private Task EylemOnaylandiAsync(DestekEylemIstegi istek) => acikEylem == null ? Task.CompletedTask : EylemUygulaAsync(acikEylem, istek);

    private async Task EylemUygulaAsync(DestekEylemTanimi tanim, DestekEylemIstegi istek)
    {
        kaydediliyor = true;
        try
        {
            await DestekService.EylemUygulaAsync(TalepId, tanim.Eylem, istek);
            acikEylem = null;
            ToastService.ShowSuccess(tanim.Eylem switch
            {
                DestekEylem.Onayla => "Teşekkürler, talep kapatıldı.",
                DestekEylem.ItirazEt => "İtirazınız iletildi; talep yeniden işleme alındı.",
                _ => "İşlem tamamlandı."
            });
            await YukleAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.GetBaseException().Message);
        }
        finally
        {
            kaydediliyor = false;
        }
    }
}
