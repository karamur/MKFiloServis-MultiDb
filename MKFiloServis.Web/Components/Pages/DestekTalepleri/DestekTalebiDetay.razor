@page "/destek-talepleri/{TalepId:int}"
@rendermode InteractiveServer
@inject IDestekTalebiService DestekService
@inject IToastService ToastService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Destek Talebi - @detay?.Talep.TalepNo</PageTitle>

@if (yukleniyor)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2">Yükleniyor...</p>
    </div>
}
else if (detay == null)
{
    <div class="alert alert-warning d-flex justify-content-between align-items-start">
        <div>
            <i class="bi bi-exclamation-triangle me-2"></i>@(yuklemeHatasi ?? "Talep bulunamadı ya da bu talebi görme yetkiniz yok.")
            <a href="destek-talepleri" class="alert-link d-block mt-2">Listeye Dön</a>
        </div>
        <button class="btn btn-outline-warning btn-sm" @onclick="YukleAsync"><i class="bi bi-arrow-clockwise me-1"></i>Tekrar Dene</button>
    </div>
}
else
{
    var talep = detay.Talep;
    <div class="container-fluid">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <a href="destek-talepleri" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Liste</a>
                <span class="h4 mb-0"><span class="text-muted">#</span>@talep.TalepNo</span>
                <DestekDurumRozeti Durum="talep.Durum" />
                <DestekOncelikRozeti Oncelik="talep.Oncelik" />
                @if (talep.SlaAsildi)
                {
                    <span class="badge bg-danger"><i class="bi bi-alarm me-1"></i>SLA aşıldı</span>
                }
                @if (talep.Kaynak == DestekKaynak.HataBildirimi)
                {
                    <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle"><i class="bi bi-bug me-1"></i>Hata bildirimi</span>
                }
            </div>
            <div class="d-flex flex-wrap gap-2">
                <DestekEylemDugmeleri Eylemler="detay.Eylemler" OnSec="EylemSec" Devre="kaydediliyor" Kucuk="true" />
                @if (detay.Isleyebilir)
                {
                    <div class="btn-group">
                        <button class="btn btn-outline-primary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-gear me-1"></i>Diğer
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (DestekKurallari.AcikMi(talep.Durum))
                            {
                                <li><button class="dropdown-item" @onclick="AtamaAcAsync"><i class="bi bi-person-plus me-2"></i>Ata</button></li>
                                <li><button class="dropdown-item" @onclick="TransferAc"><i class="bi bi-arrow-right-circle me-2"></i>Departmana Aktar</button></li>
                            }
                            <li><button class="dropdown-item" @onclick="OncelikAc"><i class="bi bi-flag me-2"></i>Öncelik Değiştir</button></li>
                            <li><button class="dropdown-item" @onclick="EtiketAc"><i class="bi bi-tags me-2"></i>Etiketler</button></li>
                            @if (aktor?.Silebilir == true)
                            {
                                <li><hr class="dropdown-divider" /></li>
                                <li><button class="dropdown-item text-danger" @onclick="SilAsync"><i class="bi bi-trash me-2"></i>Talebi Sil</button></li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-8">
                <div class="card mb-3">
                    <div class="card-header"><strong>@talep.Konu</strong></div>
                    <div class="card-body">
                        <DestekMetni Metin="@talep.Aciklama" />
                        @if (!string.IsNullOrWhiteSpace(talep.Etiketler))
                        {
                            <div class="mt-3">
                                @foreach (var etiket in talep.Etiketler.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                {
                                    <span class="badge bg-secondary bg-opacity-25 text-body border me-1"><i class="bi bi-tag me-1"></i>@etiket</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="card-footer small text-muted">
                        <i class="bi bi-clock me-1"></i>@MKFiloServis.Shared.Time.BusinessTime.LocalAt(talep.CreatedAt).ToString("dd.MM.yyyy HH:mm")
                        <span class="ms-2">· <i class="bi bi-person me-1"></i>@(talep.OlusturanKullanici?.AdSoyad ?? talep.MusteriAdi)</span>
                        <span class="ms-2">· @DestekKurallari.KaynakEtiketi(talep.Kaynak)</span>
                    </div>
                </div>

                <DestekEkler TalepId="talep.Id" Ekler="detay.Ekler" YuklemeAcik="@(talep.Durum != DestekDurum.Kapali)" OnDegisti="YukleAsync" />

                <div class="card mb-3">
                    <div class="card-header"><i class="bi bi-chat-dots me-2"></i>Yazışma (@detay.Yanitlar.Count)</div>
                    <div class="card-body">
                        <DestekYazisma Yanitlar="detay.Yanitlar" Ekler="detay.Ekler" EkipGorunumu="true" TalepEdenAdi="@talep.MusteriAdi" />
                    </div>
                    @if (detay.MesajYazilabilir && detay.Isleyebilir)
                    {
                        <div class="card-footer">
                            @if (hazirYanitlar.Count > 0)
                            {
                                <select class="form-select form-select-sm mb-2" aria-label="Hazır yanıt" value="@(hazirYanitId?.ToString() ?? string.Empty)" @onchange="HazirYanitSec">
                                    <option value="">Hazır yanıt seçin (isteğe bağlı)...</option>
                                    @foreach (var hazir in hazirYanitlar)
                                    {
                                        <option value="@hazir.Id">@hazir.Ad</option>
                                    }
                                </select>
                            }
                            <label class="visually-hidden" for="dtYanit">Yanıt</label>
                            <textarea id="dtYanit" class="form-control mb-2" rows="4" @bind="yanitMetni" @bind:event="oninput"
                                      placeholder="@(dahiliNot ? "Yalnız ekibin göreceği not..." : "Talep edene yanıtınız...")"></textarea>
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <div class="d-flex flex-wrap gap-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="dtDahili" @bind="dahiliNot" />
                                        <label class="form-check-label small" for="dtDahili"><i class="bi bi-lock me-1"></i>Dahili not (talep eden görmez)</label>
                                    </div>
                                    @if (BilgiIstenebilir)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="dtBilgi" @bind="bilgiIste" disabled="@dahiliNot" />
                                            <label class="form-check-label small" for="dtBilgi"><i class="bi bi-question-circle me-1"></i>Talep edenden bilgi bekle</label>
                                        </div>
                                    }
                                </div>
                                <button class="btn @(dahiliNot ? "btn-warning" : "btn-primary")" @onclick="YanitGonderAsync"
                                        disabled="@(kaydediliyor || string.IsNullOrWhiteSpace(yanitMetni))">
                                    @if (kaydediliyor)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    <i class="bi @(dahiliNot ? "bi-lock" : "bi-send") me-1"></i>@(dahiliNot ? "Not Ekle" : "Yanıtla")
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card mb-3">
                    <div class="card-header"><i class="bi bi-person me-2"></i>Talep Eden</div>
                    <div class="card-body small">
                        <p class="mb-1 fw-bold">@talep.MusteriAdi</p>
                        @if (!string.IsNullOrWhiteSpace(talep.MusteriEmail))
                        {
                            <p class="mb-1"><i class="bi bi-envelope me-2"></i><a href="mailto:@talep.MusteriEmail">@talep.MusteriEmail</a></p>
                        }
                        @if (!string.IsNullOrWhiteSpace(talep.MusteriTelefon))
                        {
                            <p class="mb-1"><i class="bi bi-telephone me-2"></i><a href="tel:@talep.MusteriTelefon">@talep.MusteriTelefon</a></p>
                        }
                        @if (talep.Cari != null)
                        {
                            <p class="mb-0"><i class="bi bi-building me-2"></i>@talep.Cari.Unvan</p>
                        }
                        @if (talep.OlusturanKullaniciId == null)
                        {
                            <p class="mb-0 text-muted"><i class="bi bi-info-circle me-1"></i>Hesabı olmayan müşteri adına açıldı; onayı destek ekibi kapatır.</p>
                        }
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-person-badge me-2"></i>Atama</span>
                        @if (detay.Isleyebilir && DestekKurallari.AcikMi(talep.Durum))
                        {
                            <button class="btn btn-outline-primary btn-sm" @onclick="AtamaAcAsync" title="Ata"><i class="bi bi-pencil"></i></button>
                        }
                    </div>
                    <div class="card-body small">
                        @if (talep.AtananKullanici != null)
                        {
                            <div><i class="bi bi-person-check me-2 text-success"></i><strong>@talep.AtananKullanici.AdSoyad</strong></div>
                        }
                        else
                        {
                            <div class="text-muted"><i class="bi bi-person-x me-2"></i>Atanmamış</div>
                        }
                        <div class="text-muted mt-1"><i class="bi bi-diagram-3 me-2"></i>@(talep.Departman?.Ad ?? "-")@(talep.Kategori != null ? $" · {talep.Kategori.Ad}" : string.Empty)</div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header"><i class="bi bi-alarm me-2"></i>Süreler</div>
                    <div class="card-body small">
                        @if (talep.SlaBitisTarihi.HasValue)
                        {
                            var kalan = talep.SlaBitisTarihi.Value - DateTime.UtcNow;
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">SLA bitişi</span>
                                <span>@MKFiloServis.Shared.Time.BusinessTime.LocalAt(talep.SlaBitisTarihi.Value).ToString("dd.MM.yyyy HH:mm")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">SLA durumu</span>
                                @if (!DestekKurallari.AcikMi(talep.Durum))
                                {
                                    <span class="text-muted">Tamamlandı</span>
                                }
                                else if (talep.SlaAsildi || kalan < TimeSpan.Zero)
                                {
                                    <span class="badge bg-danger">Aşıldı</span>
                                }
                                else if (kalan.TotalHours < 4)
                                {
                                    <span class="badge bg-warning text-dark">@((int)kalan.TotalHours) sa @kalan.Minutes dk kaldı</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@((int)kalan.TotalHours) saat kaldı</span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-muted mb-1">SLA tanımlı değil</div>
                        }
                        <div class="d-flex justify-content-between mb-1"><span class="text-muted">İlk yanıt</span><span>@Sure(talep.IlkYanitSuresiDakika)</span></div>
                        <div class="d-flex justify-content-between mb-1"><span class="text-muted">Çözüm süresi</span><span>@Sure(talep.CozumSuresiDakika)</span></div>
                        @if (talep.KapatilmaTarihi.HasValue)
                        {
                            <div class="d-flex justify-content-between mb-1"><span class="text-muted">Kapanma</span><span>@MKFiloServis.Shared.Time.BusinessTime.LocalAt(talep.KapatilmaTarihi.Value).ToString("dd.MM.yyyy HH:mm")</span></div>
                        }
                        @if (talep.MemnuniyetPuani.HasValue)
                        {
                            <div class="d-flex justify-content-between"><span class="text-muted">Memnuniyet</span><span class="text-warning">@(new string('★', talep.MemnuniyetPuani.Value))<span class="text-muted">@(new string('☆', 5 - talep.MemnuniyetPuani.Value))</span></span></div>
                            @if (!string.IsNullOrWhiteSpace(talep.MemnuniyetYorumu))
                            {
                                <div class="mt-1 fst-italic">"@talep.MemnuniyetYorumu"</div>
                            }
                        }
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(talep.DahiliNotlar))
                {
                    <div class="card mb-3">
                        <div class="card-header"><i class="bi bi-lock me-2"></i>Eski dahili notlar</div>
                        <div class="card-body small"><DestekMetni Metin="@talep.DahiliNotlar" /></div>
                    </div>
                }

                <div class="card">
                    <div class="card-header"><i class="bi bi-clock-history me-2"></i>Geçmiş</div>
                    <div class="card-body p-0" style="max-height: 420px; overflow-y: auto;">
                        <DestekZamanCizelgesi Aktiviteler="detay.Aktiviteler" Limit="50" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <DestekEylemPenceresi Tanim="acikEylem" TalepBasligi="@($"{talep.TalepNo} · {talep.Konu}")" Kaydediliyor="kaydediliyor"
                          OnOnayla="EylemOnaylandiAsync" OnKapat="() => acikEylem = null" />

    @if (pencere == Pencere.Atama)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i>Talep Ata</h5>
                        <button type="button" class="btn-close" @onclick="PencereKapat"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label" for="dtAtanan">Atanacak kişi</label>
                        <select id="dtAtanan" class="form-select mb-3" @bind="secilenKullaniciId">
                            <option value="">Seçiniz...</option>
                            @if (atanabilirler.Any(a => a.DepartmanUyesi))
                            {
                                <optgroup label="@($"{talep.Departman?.Ad} üyeleri")">
                                    @foreach (var kisi in atanabilirler.Where(a => a.DepartmanUyesi))
                                    {
                                        <option value="@kisi.Id">@kisi.AdSoyad</option>
                                    }
                                </optgroup>
                            }
                            <optgroup label="Destek ve yazılım ekibi">
                                @foreach (var kisi in atanabilirler.Where(a => !a.DepartmanUyesi))
                                {
                                    <option value="@kisi.Id">@kisi.AdSoyad@(kisi.YazilimEkibi ? " (yazılım)" : string.Empty)</option>
                                }
                            </optgroup>
                        </select>
                        <label class="form-label" for="dtAtamaNot">Not (isteğe bağlı, yalnız ekip görür)</label>
                        <textarea id="dtAtamaNot" class="form-control" rows="2" @bind="pencereNotu"></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="PencereKapat">İptal</button>
                        <button type="button" class="btn btn-primary" @onclick="AtaAsync" disabled="@(kaydediliyor || secilenKullaniciId == null)">
                            <i class="bi bi-check-lg me-1"></i>Ata
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (pencere == Pencere.Oncelik)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-flag me-2"></i>Öncelik Değiştir</h5>
                        <button type="button" class="btn-close" @onclick="PencereKapat"></button>
                    </div>
                    <div class="modal-body">
                        <select class="form-select" @bind="secilenOncelik" aria-label="Öncelik">
                            @foreach (var oncelik in Enum.GetValues<DestekOncelik>())
                            {
                                <option value="@oncelik">@DestekKurallari.OncelikEtiketi(oncelik)</option>
                            }
                        </select>
                        <div class="form-text">Açık talepte SLA süresi yeni önceliğe göre şimdiden yeniden başlar.</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="PencereKapat">İptal</button>
                        <button type="button" class="btn btn-primary" @onclick="OncelikKaydetAsync" disabled="@kaydediliyor"><i class="bi bi-check-lg me-1"></i>Kaydet</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (pencere == Pencere.Transfer)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-arrow-right-circle me-2"></i>Departmana Aktar</h5>
                        <button type="button" class="btn-close" @onclick="PencereKapat"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label" for="dtDepartman">Hedef departman</label>
                        <select id="dtDepartman" class="form-select mb-3" @bind="secilenDepartmanId">
                            <option value="">Seçiniz...</option>
                            @foreach (var departman in departmanlar.Where(d => d.Id != talep.DepartmanId))
                            {
                                <option value="@departman.Id">@departman.Ad@(departman.Id == detay.YazilimDepartmanId ? " (yazılım ekibi)" : string.Empty)</option>
                            }
                        </select>
                        <label class="form-label" for="dtTransferNot">Gerekçe <span class="text-danger">*</span></label>
                        <textarea id="dtTransferNot" class="form-control" rows="3" @bind="pencereNotu" @bind:event="oninput" placeholder="Yalnız ekip görür"></textarea>
                        <div class="form-text">Atama kaldırılır; hedef departmanın üyelerine bildirim gider.</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="PencereKapat">İptal</button>
                        <button type="button" class="btn btn-primary" @onclick="TransferEtAsync"
                                disabled="@(kaydediliyor || secilenDepartmanId == null || string.IsNullOrWhiteSpace(pencereNotu))">
                            <i class="bi bi-arrow-right me-1"></i>Aktar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (pencere == Pencere.Etiket)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-tags me-2"></i>Etiketler</h5>
                        <button type="button" class="btn-close" @onclick="PencereKapat"></button>
                    </div>
                    <div class="modal-body">
                        <input class="form-control" @bind="pencereNotu" placeholder="Virgülle ayırın: fatura, yazdırma, acil" aria-label="Etiketler" />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="PencereKapat">İptal</button>
                        <button type="button" class="btn btn-primary" @onclick="EtiketKaydetAsync" disabled="@kaydediliyor"><i class="bi bi-check-lg me-1"></i>Kaydet</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    private enum Pencere { Yok, Atama, Oncelik, Transfer, Etiket }

    [Parameter] public int TalepId { get; set; }

    private DestekTalepDetayi? detay;
    private DestekKullanici? aktor;
    private List<DestekHazirYanit> hazirYanitlar = new();
    private List<DestekDepartman> departmanlar = new();
    private List<DestekAtanabilirKullanici> atanabilirler = new();

    private bool yukleniyor = true;
    private bool kaydediliyor;
    private string? yuklemeHatasi;

    private string yanitMetni = string.Empty;
    private bool dahiliNot;
    private bool bilgiIste;
    private int? hazirYanitId;

    private DestekEylemTanimi? acikEylem;
    private Pencere pencere;
    private string? pencereNotu;
    private int? secilenKullaniciId;
    private int? secilenDepartmanId;
    private DestekOncelik secilenOncelik;

    private bool BilgiIstenebilir => detay != null &&
        DestekKurallari.IzinliMi(DestekEylem.BilgiIste, detay.Talep.Durum, detay.Rol);

    protected override async Task OnParametersSetAsync()
    {
        await YukleAsync();
    }

    private async Task YukleAsync()
    {
        try
        {
            yuklemeHatasi = null;
            aktor ??= await DestekService.GetAktifKullaniciAsync();
            detay = await DestekService.GetDetayAsync(TalepId);
            if (detay != null && DestekErisim.YalnizSahip(detay.Rol))
            {
                // Ekip yetkisi olmayan talep sahibi kendi takip ekranını kullanır.
                Navigation.NavigateTo($"destek-talepleri/talep-takip/{TalepId}");
                return;
            }

            if (detay != null && detay.Isleyebilir)
            {
                hazirYanitlar = await DestekService.GetHazirYanitlarAsync(detay.Talep.DepartmanId, detay.Talep.KategoriId);
                if (departmanlar.Count == 0)
                    departmanlar = await DestekService.GetDepartmanlarAsync();
            }
        }
        catch (Exception ex)
        {
            detay = null;
            yuklemeHatasi = $"Talep yüklenemedi: {ex.GetBaseException().Message}";
        }
        finally
        {
            yukleniyor = false;
        }
    }

    private static string Sure(int? dakika) => dakika switch
    {
        null => "—",
        < 60 => $"{dakika} dk",
        < 1440 => $"{dakika / 60} sa {dakika % 60} dk",
        _ => $"{dakika / 1440} gün {dakika % 1440 / 60} sa"
    };

    private void HazirYanitSec(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var id))
        {
            hazirYanitId = null;
            return;
        }

        var hazir = hazirYanitlar.FirstOrDefault(h => h.Id == id);
        if (hazir == null) return;
        hazirYanitId = id;
        yanitMetni = HtmlSanitizerHelper.DuzMetin(hazir.Icerik);
    }

    private async Task YanitGonderAsync()
    {
        if (string.IsNullOrWhiteSpace(yanitMetni)) return;

        kaydediliyor = true;
        try
        {
            await DestekService.YanitEkleAsync(TalepId, new DestekYanitIstegi
            {
                Icerik = yanitMetni,
                DahiliNot = dahiliNot,
                BilgiIste = bilgiIste && !dahiliNot,
                HazirYanitId = hazirYanitId
            });
            ToastService.ShowSuccess(dahiliNot ? "Dahili not eklendi." : "Yanıt gönderildi.");
            yanitMetni = string.Empty;
            dahiliNot = false;
            bilgiIste = false;
            hazirYanitId = null;
            await YukleAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Gönderilemedi: {ex.GetBaseException().Message}");
        }
        finally
        {
            kaydediliyor = false;
        }
    }

    private async Task EylemSec(DestekEylemTanimi tanim)
    {
        if (tanim.NotZorunlu || tanim.Eylem is DestekEylem.Onayla or DestekEylem.YenidenAc)
        {
            acikEylem = tanim;
            return;
        }
        await EylemUygulaAsync(tanim, new DestekEylemIstegi());
    }

    private Task EylemOnaylandiAsync(DestekEylemIstegi istek) => acikEylem == null ? Task.CompletedTask : EylemUygulaAsync(acikEylem, istek);

    private async Task EylemUygulaAsync(DestekEylemTanimi tanim, DestekEylemIstegi istek)
    {
        kaydediliyor = true;
        try
        {
            await DestekService.EylemUygulaAsync(TalepId, tanim.Eylem, istek);
            acikEylem = null;
            ToastService.ShowSuccess($"{tanim.Etiket}: tamamlandı.");
            await YukleAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.GetBaseException().Message);
        }
        finally
        {
            kaydediliyor = false;
        }
    }

    private async Task AtamaAcAsync()
    {
        try
        {
            atanabilirler = await DestekService.GetAtanabilirKullanicilarAsync(detay?.Talep.DepartmanId);
            secilenKullaniciId = detay?.Talep.AtananKullaniciId;
            pencereNotu = null;
            pencere = Pencere.Atama;
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Kişiler yüklenemedi: {ex.GetBaseException().Message}");
        }
    }

    private async Task AtaAsync()
    {
        if (secilenKullaniciId == null) return;
        await PencereIslemiAsync(() => DestekService.AtaAsync(TalepId, secilenKullaniciId.Value, pencereNotu), "Talep atandı.");
    }

    private void OncelikAc()
    {
        secilenOncelik = detay?.Talep.Oncelik ?? DestekOncelik.Normal;
        pencere = Pencere.Oncelik;
    }

    private Task OncelikKaydetAsync() =>
        PencereIslemiAsync(() => DestekService.OncelikDegistirAsync(TalepId, secilenOncelik), "Öncelik güncellendi.");

    private void TransferAc()
    {
        secilenDepartmanId = null;
        pencereNotu = null;
        pencere = Pencere.Transfer;
    }

    private async Task TransferEtAsync()
    {
        if (secilenDepartmanId == null) return;
        await PencereIslemiAsync(() => DestekService.TransferEtAsync(TalepId, secilenDepartmanId.Value, pencereNotu ?? string.Empty), "Talep aktarıldı.");
    }

    private void EtiketAc()
    {
        pencereNotu = detay?.Talep.Etiketler;
        pencere = Pencere.Etiket;
    }

    private Task EtiketKaydetAsync() =>
        PencereIslemiAsync(() => DestekService.EtiketleriGuncelleAsync(TalepId, pencereNotu), "Etiketler güncellendi.");

    private async Task PencereIslemiAsync(Func<Task> islem, string basariMesaji)
    {
        kaydediliyor = true;
        try
        {
            await islem();
            pencere = Pencere.Yok;
            ToastService.ShowSuccess(basariMesaji);
            await YukleAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.GetBaseException().Message);
        }
        finally
        {
            kaydediliyor = false;
        }
    }

    private void PencereKapat() => pencere = Pencere.Yok;

    private async Task SilAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"{detay?.Talep.TalepNo} talebi silinsin mi? Bu işlem listelerden kaldırır."))
            return;

        try
        {
            await DestekService.SilAsync(TalepId);
            ToastService.ShowSuccess("Talep silindi.");
            Navigation.NavigateTo("destek-talepleri");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Silinemedi: {ex.GetBaseException().Message}");
        }
    }
}
