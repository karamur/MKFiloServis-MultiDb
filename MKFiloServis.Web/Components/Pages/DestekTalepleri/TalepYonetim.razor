@page "/destek-talepleri/yonetim"
@rendermode InteractiveServer
@inject IDestekTalebiService DestekService
@inject IToastService ToastService

<PageTitle>Talep Yönetimi</PageTitle>

<div class="container-fluid">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h3 class="mb-0"><i class="bi bi-kanban me-2 text-primary"></i>Talep Yönetimi</h3>
        @if (!yetkisiz)
        {
            <div class="d-flex flex-wrap align-items-center gap-2">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="tyBana" @bind="yalnizBana" />
                    <label class="form-check-label small" for="tyBana">Yalnız bana atananlar</label>
                </div>
                <select class="form-select form-select-sm" style="width: auto;" @bind="departmanId" aria-label="Departman">
                    <option value="">Tüm departmanlar</option>
                    @foreach (var departman in talepler.Where(t => t.Departman != null).Select(t => t.Departman!).DistinctBy(d => d.Id).OrderBy(d => d.Ad))
                    {
                        <option value="@departman.Id">@departman.Ad</option>
                    }
                </select>
                <a href="destek-talepleri" class="btn btn-outline-secondary btn-sm"><i class="bi bi-list me-1"></i>Liste</a>
                <button class="btn btn-outline-primary btn-sm" @onclick="YukleAsync"><i class="bi bi-arrow-clockwise me-1"></i>Yenile</button>
            </div>
        }
    </div>

    @if (yetkisiz)
    {
        <div class="alert alert-warning">
            <i class="bi bi-shield-lock me-2"></i>Bu pano destek ekibi içindir (destektalebi.yaz ya da destektalebi.yazilim yetkisi gerekir).
        </div>
    }
    else if (yukleniyor)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
    }
    else
    {
        @if (yuklemeHatasi != null)
        {
            <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-2"></i>@yuklemeHatasi</div>
        }

        <div class="row g-3 pano">
            @foreach (var sutun in DestekKurallari.PanoSutunlari)
            {
                var kartlar = Gorunen.Where(t => t.Durum == sutun).ToList();
                <div class="col-12 col-md-6 col-xl">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span class="fw-semibold"><i class="bi @DestekKurallari.Ikon(sutun) me-2"></i>@SutunBasligi(sutun)</span>
                            <span class="badge @DestekKurallari.RozetSinifi(sutun)">@kartlar.Count</span>
                        </div>
                        <div class="card-body p-2 pano-sutun">
                            @if (kartlar.Count == 0)
                            {
                                <div class="text-center text-muted small py-3"><i class="bi bi-inbox d-block fs-4 mb-1"></i>Talep yok</div>
                            }
                            @foreach (var talep in kartlar)
                            {
                                <div class="card mb-2 shadow-sm @(talep.SlaAsildi ? "border-danger" : talep.Oncelik >= DestekOncelik.Acil ? "border-warning" : string.Empty)">
                                    <div class="card-body p-2">
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <a href="destek-talepleri/@talep.Id" class="small text-decoration-none fw-semibold">@talep.TalepNo</a>
                                            <DestekOncelikRozeti Oncelik="talep.Oncelik" />
                                        </div>
                                        <div class="small fw-bold mb-1 text-truncate" title="@talep.Konu">
                                            @if (talep.Kaynak == DestekKaynak.HataBildirimi)
                                            {
                                                <i class="bi bi-bug text-danger me-1" title="Hata bildirimi"></i>
                                            }
                                            @talep.Konu
                                        </div>
                                        <div class="small text-muted text-truncate"><i class="bi bi-person me-1"></i>@talep.MusteriAdi</div>
                                        <div class="small text-muted text-truncate"><i class="bi bi-diagram-3 me-1"></i>@(talep.Departman?.Ad ?? "-")</div>
                                        <div class="small text-truncate @(talep.AtananKullanici != null ? "text-success" : "text-muted")">
                                            <i class="bi bi-person-check me-1"></i>@(talep.AtananKullanici?.AdSoyad ?? "Atanmamış")
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mt-2">
                                            <small class="text-muted" title="Son aktivite">
                                                @if (talep.SlaAsildi)
                                                {
                                                    <span class="badge bg-danger me-1">SLA</span>
                                                }
                                                @MKFiloServis.Shared.Time.BusinessTime.LocalAt(talep.SonAktiviteTarihi).ToString("dd.MM HH:mm")
                                            </small>
                                            <div class="btn-group btn-group-sm">
                                                @if (talep.Durum == DestekDurum.Yeni && aktor?.Personel == true)
                                                {
                                                    <button class="btn btn-primary" title="Üstlen" disabled="@kaydediliyor" @onclick="() => UstlenAsync(talep)"><i class="bi bi-person-check"></i></button>
                                                }
                                                <a href="destek-talepleri/@talep.Id" class="btn btn-outline-secondary" title="Aç"><i class="bi bi-box-arrow-up-right"></i></a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<DestekTalebi> talepler = new();
    private DestekKullanici? aktor;
    private bool yukleniyor = true;
    private bool kaydediliyor;
    private bool yetkisiz;
    private bool yalnizBana;
    private int? departmanId;
    private string? yuklemeHatasi;

    private IEnumerable<DestekTalebi> Gorunen => talepler
        .Where(t => !yalnizBana || t.AtananKullaniciId == aktor?.Id)
        .Where(t => departmanId == null || t.DepartmanId == departmanId);

    protected override async Task OnInitializedAsync()
    {
        aktor = await DestekService.GetAktifKullaniciAsync();
        if (aktor?.EkipUyesi != true)
        {
            yetkisiz = true;
            yukleniyor = false;
            return;
        }
        await YukleAsync();
    }

    private async Task YukleAsync()
    {
        yukleniyor = true;
        yuklemeHatasi = null;
        try
        {
            talepler = await DestekService.GetPanoAsync();
        }
        catch (Exception ex)
        {
            yuklemeHatasi = $"Talepler yüklenemedi: {ex.GetBaseException().Message}";
        }
        finally
        {
            yukleniyor = false;
        }
    }

    private static string SutunBasligi(DestekDurum durum) => durum switch
    {
        DestekDurum.Yeni => "Yeni (atama bekliyor)",
        DestekDurum.Cozuldu => "Çözüldü (onay bekliyor)",
        _ => DestekKurallari.Etiket(durum)
    };

    private async Task UstlenAsync(DestekTalebi talep)
    {
        kaydediliyor = true;
        try
        {
            await DestekService.EylemUygulaAsync(talep.Id, DestekEylem.Ustlen);
            ToastService.ShowSuccess($"{talep.TalepNo} üstlenildi.");
            await YukleAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.GetBaseException().Message);
        }
        finally
        {
            kaydediliyor = false;
        }
    }
}
