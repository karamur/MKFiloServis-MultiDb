@page "/destek-talepleri/taleplerim"
@rendermode InteractiveServer
@inject IDestekTalebiService DestekService
@inject IToastService ToastService
@inject AppIssueStateService AppIssueState
@inject IJSRuntime JS

<PageTitle>Taleplerim</PageTitle>

<div class="container-fluid">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h3 class="mb-1"><i class="bi bi-ticket-detailed-fill text-primary me-2"></i>Taleplerim</h3>
            <div class="text-muted small">Destek taleplerinizi buradan takip edebilir ve ekiple mesajlaşabilirsiniz.</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (aktor?.EkipUyesi == true)
            {
                <a href="destek-talepleri" class="btn btn-outline-secondary"><i class="bi bi-list me-1"></i>Tüm Talepler</a>
            }
            <button type="button" class="btn btn-outline-danger" @onclick="() => AppIssueState.RequestReportForm()">
                <i class="bi bi-bug me-1"></i>Sorun Bildir
            </button>
            <a href="destek-talepleri/talep-giris" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Yeni Talep</a>
        </div>
    </div>

    @if (yuklemeHatasi != null)
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-start">
            <div><i class="bi bi-exclamation-triangle me-2"></i>@yuklemeHatasi</div>
            <button class="btn btn-outline-warning btn-sm" @onclick="YukleAsync"><i class="bi bi-arrow-clockwise me-1"></i>Tekrar Dene</button>
        </div>
    }

    @if (bekleyenSayisi > 0)
    {
        <div class="alert alert-info d-flex align-items-center gap-2">
            <i class="bi bi-hand-index-thumb fs-5"></i>
            <div>
                <strong>@bekleyenSayisi talep sizi bekliyor.</strong>
                Destek ekibi sizden bilgi istedi ya da çözümü incelemenizi bekliyor.
                <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="() => Sec(Suzgec.Bekleyen)">Göster</button>
            </div>
        </div>
    }

    <div class="d-flex flex-wrap gap-2 mb-3" role="group" aria-label="Durum süzgeci">
        @foreach (var secenek in Enum.GetValues<Suzgec>())
        {
            <button type="button" class="btn btn-sm @(suzgec == secenek ? "btn-primary" : "btn-outline-primary")" @onclick="() => Sec(secenek)">
                @SuzgecEtiketi(secenek) <span class="badge @(suzgec == secenek ? "bg-light text-dark" : "bg-primary") ms-1">@Say(secenek)</span>
            </button>
        }
    </div>

    @if (yukleniyor)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
    }
    else if (!Gorunen.Any())
    {
        <div class="alert alert-light border text-center py-4">
            <i class="bi bi-inbox fs-3 d-block mb-2 text-muted"></i>
            @if (talepler.Count == 0)
            {
                <span>Henüz talebiniz yok. Bir sorun yaşadığınızda <strong>Sorun Bildir</strong> ya da <a href="destek-talepleri/talep-giris">Yeni Talep</a> ile destek ekibine ulaşabilirsiniz.</span>
            }
            else
            {
                <span>Bu süzgece uyan talep yok.</span>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 140px;">Talep No</th>
                        <th>Konu</th>
                        <th style="width: 150px;">Durum</th>
                        <th class="d-none d-sm-table-cell" style="width: 160px;">Son Güncelleme</th>
                        <th style="width: 130px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var talep in Gorunen)
                    {
                        var bekliyor = talep.Durum is DestekDurum.BilgiBekleniyor or DestekDurum.Cozuldu;
                        <tr class="@(bekliyor ? "table-info" : string.Empty)">
                            <td>
                                <span class="fw-bold text-primary">@talep.TalepNo</span>
                            </td>
                            <td>
                                <div class="text-truncate" style="max-width: 320px;" title="@talep.Konu">@talep.Konu</div>
                                @if (talep.Kaynak == DestekKaynak.HataBildirimi)
                                {
                                    <small class="text-muted"><i class="bi bi-bug me-1"></i>Hata bildirimi</small>
                                }
                            </td>
                            <td>
                                <DestekDurumRozeti Durum="talep.Durum" Baslik="@DestekKurallari.TalepEdenAciklamasi(talep.Durum)" />
                                @if (bekliyor)
                                {
                                    <div class="small text-info-emphasis">@(talep.Durum == DestekDurum.Cozuldu ? "Onayınız bekleniyor" : "Yanıtınız bekleniyor")</div>
                                }
                            </td>
                            <td class="d-none d-sm-table-cell"><small>@MKFiloServis.Shared.Time.BusinessTime.LocalAt(talep.SonAktiviteTarihi).ToString("dd.MM.yyyy HH:mm")</small></td>
                            <td class="text-end">
                                @if (talep.Durum == DestekDurum.Taslak)
                                {
                                    <div class="btn-group btn-group-sm">
                                        <a href="destek-talepleri/talep-giris/@talep.Id" class="btn btn-outline-primary" title="Düzenle"><i class="bi bi-pencil"></i></a>
                                        <button class="btn btn-outline-success" title="Gönder" @onclick="() => GonderAsync(talep)"><i class="bi bi-send"></i></button>
                                        <button class="btn btn-outline-danger" title="Sil" @onclick="() => SilAsync(talep)"><i class="bi bi-trash"></i></button>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-inline-flex gap-1">
                                        <a href="destek-talepleri/talep-takip/@talep.Id" class="btn btn-sm @(bekliyor ? "btn-info" : "btn-outline-info")">
                                            <i class="bi bi-eye me-1"></i>@(bekliyor ? "Yanıtla" : "Takip Et")
                                        </a>
                                        @if (talep.Durum == DestekDurum.Yeni)
                                        {
                                            <button class="btn btn-sm btn-outline-danger" title="Talebi iptal et" aria-label="Talebi iptal et" @onclick="() => IptalEtAsync(talep)">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private enum Suzgec { Tumu, Bekleyen, Acik, Taslak, Kapali, IptalEdilenler }

    private List<DestekTalebi> talepler = new();
    private DestekKullanici? aktor;
    private Suzgec suzgec = Suzgec.Tumu;
    private bool yukleniyor = true;
    private string? yuklemeHatasi;

    private int bekleyenSayisi => Say(Suzgec.Bekleyen);

    private IEnumerable<DestekTalebi> Gorunen => talepler.Where(t => Uyar(t, suzgec));

    protected override async Task OnInitializedAsync()
    {
        await YukleAsync();
    }

    private async Task YukleAsync()
    {
        yukleniyor = true;
        yuklemeHatasi = null;
        try
        {
            aktor = await DestekService.GetAktifKullaniciAsync();
            talepler = await DestekService.GetTaleplerimAsync();
        }
        catch (Exception ex)
        {
            yuklemeHatasi = $"Talepler yüklenemedi: {ex.GetBaseException().Message}";
        }
        finally
        {
            yukleniyor = false;
        }
    }

    private void Sec(Suzgec secenek) => suzgec = secenek;

    private int Say(Suzgec secenek) => talepler.Count(t => Uyar(t, secenek));

    private static bool Uyar(DestekTalebi talep, Suzgec secenek) => secenek switch
    {
        Suzgec.Bekleyen => talep.Durum is DestekDurum.BilgiBekleniyor or DestekDurum.Cozuldu,
        Suzgec.Acik => DestekKurallari.AcikMi(talep.Durum),
        Suzgec.Taslak => talep.Durum == DestekDurum.Taslak,
        Suzgec.Kapali => talep.Durum == DestekDurum.Kapali,
        Suzgec.IptalEdilenler => talep.Durum == DestekDurum.IptalEdildi,
        _ => true
    };

    private static string SuzgecEtiketi(Suzgec secenek) => secenek switch
    {
        Suzgec.Bekleyen => "Sizi bekleyen",
        Suzgec.Acik => "Açık",
        Suzgec.Taslak => "Taslak",
        Suzgec.Kapali => "Kapanan",
        Suzgec.IptalEdilenler => "İptal Edilenler",
        _ => "Tümü"
    };

    private async Task GonderAsync(DestekTalebi talep)
    {
        try
        {
            await DestekService.EylemUygulaAsync(talep.Id, DestekEylem.Gonder);
            ToastService.ShowSuccess($"{talep.TalepNo} gönderildi.");
            await YukleAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Gönderilemedi: {ex.GetBaseException().Message}");
        }
    }

    private async Task SilAsync(DestekTalebi talep)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"{talep.TalepNo} taslağı silinsin mi?"))
            return;

        try
        {
            await DestekService.TaslakSilAsync(talep.Id);
            ToastService.ShowSuccess("Taslak silindi.");
            await YukleAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Silinemedi: {ex.GetBaseException().Message}");
        }
    }

    private async Task IptalEtAsync(DestekTalebi talep)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"{talep.TalepNo} iptal edilsin mi? Talep, İptal Edilenler bölümünde kalacak."))
            return;
        try
        {
            await DestekService.YeniTalebiIptalEtAsync(talep.Id);
            ToastService.ShowSuccess("Talep iptal edildi.");
            suzgec = Suzgec.IptalEdilenler;
            await YukleAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"İptal edilemedi: {ex.GetBaseException().Message}");
        }
    }
}
