@page "/destek-talepleri/talep-giris"
@page "/destek-talepleri/talep-giris/{TalepId:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@inject IDestekTalebiService DestekService
@inject IToastService ToastService
@inject NavigationManager Navigation

<PageTitle>@(TalepId > 0 ? "Taslağı Düzenle" : "Yeni Destek Talebi")</PageTitle>

<div class="container-fluid">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h3 class="mb-0">
            <i class="bi bi-ticket-detailed-fill text-primary me-2"></i>@(TalepId > 0 ? "Taslağı Düzenle" : "Yeni Destek Talebi")
        </h3>
        <a href="destek-talepleri/taleplerim" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Taleplerime Dön
        </a>
    </div>

    @if (yukleniyor)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Yükleniyor...</span></div>
        </div>
    }
    else if (yuklemeHatasi != null)
    {
        <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-2"></i>@yuklemeHatasi</div>
    }
    else
    {
        @if (hataBildirimi)
        {
            <div class="alert alert-warning">
                <i class="bi bi-bug me-2"></i><strong>Hata bildirimi.</strong>
                Aşağıdaki bilgiler talebe eklenecek: sayfa <code>@(hataSayfasi ?? "-")</code>@(string.IsNullOrWhiteSpace(hataMesaji) ? string.Empty : $", hata: {hataMesaji}")
            </div>
        }

        <div class="row g-3">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-file-earmark-text me-2"></i>Talep Bilgileri</h5>
                    </div>
                    <div class="card-body">
                        @if (talep.Id > 0)
                        {
                            <div class="mb-3 p-3 rounded border">
                                <small class="text-muted">Talep No</small>
                                <div class="fw-bold">@talep.TalepNo <DestekDurumRozeti Durum="talep.Durum" Sinif="ms-2" /></div>
                            </div>
                        }

                        <div class="row">
                            @if (!hataBildirimi)
                            {
                                <div class="col-md-6 mb-3">
                                    <label class="form-label" for="tgDepartman">Departman <span class="text-danger">*</span></label>
                                    <select id="tgDepartman" class="form-select" @bind="talep.DepartmanId">
                                        <option value="0">-- Seçiniz --</option>
                                        @foreach (var departman in departmanlar)
                                        {
                                            <option value="@departman.Id">@departman.Ad</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label" for="tgKategori">Kategori</label>
                                    <select id="tgKategori" class="form-select" @bind="talep.KategoriId">
                                        <option value="">-- Seçiniz --</option>
                                        @foreach (var kategori in kategoriler.Where(k => talep.DepartmanId == 0 || k.DepartmanId == null || k.DepartmanId == talep.DepartmanId))
                                        {
                                            <option value="@kategori.Id">@kategori.Ad</option>
                                        }
                                    </select>
                                </div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="tgKonu">Konu <span class="text-danger">*</span></label>
                            <input id="tgKonu" type="text" class="form-control" @bind="talep.Konu" maxlength="500"
                                   placeholder="Talebin konusunu kısaca yazın" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="tgAciklama">Açıklama <span class="text-danger">*</span></label>
                            <textarea id="tgAciklama" class="form-control" rows="6" @bind="talep.Aciklama"
                                      placeholder="Ne yapmaya çalışıyordunuz, ne oldu? Hata mesajı varsa yazın."></textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="tgOncelik">Öncelik</label>
                                <select id="tgOncelik" class="form-select" @bind="talep.Oncelik">
                                    @foreach (var oncelik in Enum.GetValues<DestekOncelik>())
                                    {
                                        <option value="@oncelik">@DestekKurallari.OncelikEtiketi(oncelik)</option>
                                    }
                                </select>
                            </div>
                            @if (!hataBildirimi)
                            {
                                <div class="col-md-6 mb-3">
                                    <label class="form-label" for="tgEposta">İletişim e-postası</label>
                                    <input id="tgEposta" type="email" class="form-control" @bind="talep.MusteriEmail" placeholder="E-posta adresiniz" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label" for="tgTelefon">İletişim telefonu</label>
                                    <input id="tgTelefon" type="tel" class="form-control" @bind="talep.MusteriTelefon" maxlength="20" placeholder="Telefon numaranız" />
                                </div>
                            }
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="tgDosya">Dosya / ekran görüntüsü</label>
                                <InputFile id="tgDosya" class="form-control" multiple OnChange="DosyaSecildi" />
                                <div class="form-text">
                                    @if (secilenDosyalar.Count > 0)
                                    {
                                        @($"{secilenDosyalar.Count} dosya seçildi: {string.Join(", ", secilenDosyalar.Select(d => d.Name))}")
                                    }
                                    else
                                    {
                                        @($"En fazla {EnFazlaDosya} dosya, her biri {ayarlar.MaksimumDosyaBoyutuMB} MB")
                                    }
                                </div>
                            </div>
                        </div>

                        <hr />
                        <div class="d-flex flex-wrap justify-content-between gap-2">
                            <div>
                                @if (!hataBildirimi)
                                {
                                    <button type="button" class="btn btn-outline-secondary" @onclick="() => KaydetAsync(taslak: true)" disabled="@kaydediliyor">
                                        <i class="bi bi-file-earmark me-1"></i>Taslak Kaydet
                                    </button>
                                }
                            </div>
                            <div class="d-flex gap-2">
                                <a href="destek-talepleri/taleplerim" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i>İptal</a>
                                <button type="button" class="btn btn-success" @onclick="() => KaydetAsync(taslak: false)" disabled="@kaydediliyor">
                                    @if (kaydediliyor)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    <i class="bi bi-send me-1"></i>Gönder
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card mb-3">
                    <div class="card-header"><h6 class="mb-0"><i class="bi bi-signpost-split me-2"></i>Talebiniz nasıl ilerler?</h6></div>
                    <div class="card-body small">
                        <ol class="ps-3 mb-0">
                            <li class="mb-2"><strong>Yeni:</strong> talebiniz destek ekibine iletilir.</li>
                            <li class="mb-2"><strong>İşlemde:</strong> bir yetkili üzerinde çalışır; gerekirse sizden <strong>bilgi ister</strong>.</li>
                            <li class="mb-2"><strong>Yazılım Ekibinde:</strong> program hatasıysa yazılım ekibi inceler.</li>
                            <li class="mb-2"><strong>Çözüldü:</strong> çözümü siz onaylarsınız ya da "sorun devam ediyor" dersiniz.</li>
                            <li><strong>Kapandı.</strong></li>
                        </ol>
                        <div class="alert alert-info small mt-3 mb-0">
                            <i class="bi bi-bell me-1"></i>Her adımda sağ üstteki zil simgesinden bildirim alırsınız.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private const int EnFazlaDosya = 5;

    [Parameter] public int TalepId { get; set; }

    // Hata sayfası / bağlantı koptu çubuğundaki "Sorunu bildir" bağlantısı bu sayfayı açar.
    [SupplyParameterFromQuery(Name = "kaynak")] public string? Kaynak { get; set; }
    [SupplyParameterFromQuery(Name = "sayfa")] public string? SayfaParametresi { get; set; }
    [SupplyParameterFromQuery(Name = "mesaj")] public string? MesajParametresi { get; set; }

    private DestekTalebi talep = new() { Oncelik = DestekOncelik.Normal };
    private List<DestekDepartman> departmanlar = new();
    private List<DestekKategori> kategoriler = new();
    private DestekGenelAyarlar ayarlar = new();
    private List<IBrowserFile> secilenDosyalar = new();

    private bool yukleniyor = true;
    private bool kaydediliyor;
    private string? yuklemeHatasi;
    private bool hataBildirimi;
    private string? hataSayfasi;
    private string? hataMesaji;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var aktor = await DestekService.GetAktifKullaniciAsync();
            departmanlar = await DestekService.GetDepartmanlarAsync();
            kategoriler = await DestekService.GetKategorilerAsync();
            ayarlar = await DestekService.GetGenelAyarlarAsync();

            if (TalepId > 0)
            {
                var detay = await DestekService.GetDetayAsync(TalepId);
                if (detay == null || !detay.Sahip)
                {
                    yuklemeHatasi = "Talep bulunamadı ya da bu talebi düzenleme yetkiniz yok.";
                    return;
                }
                if (detay.Talep.Durum != DestekDurum.Taslak)
                {
                    // Gönderilmiş talep düzenlenmez; takip ekranında mesajla bilgi eklenir.
                    Navigation.NavigateTo($"destek-talepleri/talep-takip/{TalepId}");
                    return;
                }
                talep = detay.Talep;
            }
            else
            {
                talep = new DestekTalebi
                {
                    Oncelik = DestekOncelik.Normal,
                    MusteriAdi = aktor?.AdSoyad ?? string.Empty,
                    MusteriEmail = aktor?.Email ?? string.Empty,
                    DepartmanId = departmanlar.Count == 1 ? departmanlar[0].Id : 0
                };

                if (string.Equals(Kaynak, "hata", StringComparison.OrdinalIgnoreCase))
                {
                    hataBildirimi = true;
                    hataSayfasi = string.IsNullOrWhiteSpace(SayfaParametresi) ? null : SayfaParametresi;
                    hataMesaji = string.IsNullOrWhiteSpace(MesajParametresi) ? null : MesajParametresi;
                    talep.Konu = hataMesaji != null ? $"Hata: {(hataMesaji.Length > 150 ? hataMesaji[..150] : hataMesaji)}" : string.Empty;
                }
            }
        }
        catch (Exception ex)
        {
            yuklemeHatasi = $"Veriler yüklenirken hata: {ex.GetBaseException().Message}";
        }
        finally
        {
            yukleniyor = false;
        }
    }

    private void DosyaSecildi(InputFileChangeEventArgs e)
    {
        secilenDosyalar = e.GetMultipleFiles(EnFazlaDosya).ToList();
        if (e.FileCount > EnFazlaDosya)
            ToastService.ShowWarning($"En fazla {EnFazlaDosya} dosya eklenebilir; ilk {EnFazlaDosya} dosya alındı.");
    }

    private async Task KaydetAsync(bool taslak)
    {
        if (string.IsNullOrWhiteSpace(talep.Konu) && !hataBildirimi)
        {
            ToastService.ShowWarning("Konu alanı zorunludur.");
            return;
        }
        if (string.IsNullOrWhiteSpace(talep.Aciklama))
        {
            ToastService.ShowWarning("Açıklama alanı zorunludur.");
            return;
        }
        if (!hataBildirimi && talep.DepartmanId == 0)
        {
            ToastService.ShowWarning("Departman seçimi zorunludur.");
            return;
        }

        kaydediliyor = true;
        try
        {
            DestekTalebi kayit;
            if (hataBildirimi)
            {
                kayit = await DestekService.HataBildirimiOlusturAsync(new SorunBildirimi
                {
                    Konu = talep.Konu,
                    Aciklama = talep.Aciklama,
                    Oncelik = talep.Oncelik,
                    Sayfa = hataSayfasi,
                    HataMesaji = hataMesaji,
                    HataZamaniUtc = DateTime.UtcNow
                });
            }
            else if (talep.Id > 0)
            {
                kayit = await DestekService.TaslakGuncelleAsync(talep, gonder: !taslak);
            }
            else
            {
                kayit = await DestekService.TalepOlusturAsync(talep, taslak);
            }

            await DosyalariYukleAsync(kayit.Id);

            if (taslak)
            {
                ToastService.ShowSuccess("Taslak kaydedildi.");
                if (TalepId == 0)
                    Navigation.NavigateTo($"destek-talepleri/talep-giris/{kayit.Id}");
                else
                    talep = kayit;
            }
            else
            {
                ToastService.ShowSuccess($"Talebiniz gönderildi. Talep No: {kayit.TalepNo}");
                Navigation.NavigateTo($"destek-talepleri/talep-takip/{kayit.Id}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Kayıt sırasında hata: {ex.GetBaseException().Message}");
        }
        finally
        {
            kaydediliyor = false;
        }
    }

    private async Task DosyalariYukleAsync(int talepId)
    {
        var sinir = ayarlar.MaksimumDosyaBoyutuMB * 1024L * 1024L;
        foreach (var dosya in secilenDosyalar)
        {
            try
            {
                if (dosya.Size > sinir)
                    throw new InvalidOperationException($"{dosya.Name}: dosya en fazla {ayarlar.MaksimumDosyaBoyutuMB} MB olabilir.");
                await using var akis = dosya.OpenReadStream(sinir);
                await DestekService.EkYukleAsync(talepId, dosya.Name, dosya.ContentType, akis, dosya.Size);
            }
            catch (Exception ex)
            {
                ToastService.ShowWarning($"Dosya eklenemedi — {ex.GetBaseException().Message}");
            }
        }
        secilenDosyalar.Clear();
    }
}
