@page "/destek-talepleri"
@rendermode InteractiveServer
@inject IDestekTalebiService DestekService
@inject ICariService CariService
@inject IToastService ToastService
@inject IJSRuntime JS

<PageTitle>Destek Talepleri</PageTitle>

<div class="container-fluid">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h3 class="mb-0"><i class="bi bi-ticket-detailed-fill text-primary me-2"></i>Destek Talepleri</h3>
        @if (aktor?.EkipUyesi == true)
        {
            <div class="d-flex flex-wrap gap-2">
                <a href="destek-talepleri/yonetim" class="btn btn-outline-primary"><i class="bi bi-kanban me-1"></i>Talep Yönetimi</a>
                <a href="destek-talepleri/bilgi-bankasi" class="btn btn-outline-info"><i class="bi bi-book me-1"></i>Bilgi Bankası</a>
                @if (aktor.TanimYonetir)
                {
                    <a href="destek-talepleri/ayarlar" class="btn btn-outline-secondary"><i class="bi bi-sliders me-1"></i>Ayarlar</a>
                }
                @if (aktor.Personel)
                {
                    <button class="btn btn-primary" @onclick="YeniTalepAc"><i class="bi bi-plus-lg me-1"></i>Müşteri Adına Talep</button>
                }
            </div>
        }
    </div>

    @if (yetkisiz)
    {
        <div class="alert alert-warning">
            <i class="bi bi-shield-lock me-2"></i>Bu ekran destek ekibi içindir (destektalebi.yaz ya da destektalebi.yazilim yetkisi gerekir).
            Kendi taleplerinizi <a href="destek-talepleri/taleplerim" class="alert-link">Taleplerim</a> ekranından izleyebilirsiniz.
        </div>
    }
    else
    {
        @if (yuklemeHatasi != null)
        {
            <div class="alert alert-warning d-flex justify-content-between align-items-start mb-3">
                <div><i class="bi bi-exclamation-triangle me-2"></i>@yuklemeHatasi</div>
                <button class="btn btn-outline-warning btn-sm" @onclick="SayfayiYenileAsync"><i class="bi bi-arrow-clockwise me-1"></i>Tekrar Dene</button>
            </div>
        }

        @if (stats != null)
        {
            <div class="row g-2 mb-3">
                <div class="col-6 col-md-4 col-xl-2"><div class="card text-center h-100"><div class="card-body py-2"><div class="h5 mb-0 text-primary">@stats.AcikTalepSayisi</div><small class="text-muted">Açık</small></div></div></div>
                <div class="col-6 col-md-4 col-xl-2"><div class="card text-center h-100"><div class="card-body py-2"><div class="h5 mb-0 text-success">@stats.OnayBekleyenTalepSayisi</div><small class="text-muted">Onay bekleyen</small></div></div></div>
                <div class="col-6 col-md-4 col-xl-2"><div class="card text-center h-100"><div class="card-body py-2"><div class="h5 mb-0">@stats.BugunAcilanTalepSayisi</div><small class="text-muted">Bugün açılan</small></div></div></div>
                <div class="col-6 col-md-4 col-xl-2"><div class="card text-center h-100"><div class="card-body py-2"><div class="h5 mb-0">@stats.BugunKapatilanTalepSayisi</div><small class="text-muted">Bugün kapanan</small></div></div></div>
                <div class="col-6 col-md-4 col-xl-2"><div class="card text-center h-100 @(stats.SlaAsildiSayisi > 0 ? "border-danger" : string.Empty)"><div class="card-body py-2"><div class="h5 mb-0 @(stats.SlaAsildiSayisi > 0 ? "text-danger" : string.Empty)">@stats.SlaAsildiSayisi</div><small class="text-muted">SLA aşımı (açık)</small></div></div></div>
                <div class="col-6 col-md-4 col-xl-2"><div class="card text-center h-100"><div class="card-body py-2"><div class="h5 mb-0">@(stats.OrtalamaCozumSuresiSaat?.ToString("0.#") ?? "—")@(stats.OrtalamaCozumSuresiSaat.HasValue ? " sa" : string.Empty)</div><small class="text-muted">Ort. çözüm</small></div></div></div>
            </div>
        }

        <div class="card mb-3">
            <div class="card-body py-2">
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-4 col-xl-3">
                        <label class="form-label small mb-1" for="dlArama">Arama</label>
                        <input id="dlArama" type="text" class="form-control form-control-sm" placeholder="Talep no, konu, kişi, etiket (Enter)"
                               @bind="filter.AramaMetni" @bind:event="oninput" @onkeyup="AramaTusAsync" />
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <label class="form-label small mb-1" for="dlDurum">Durum</label>
                        <select id="dlDurum" class="form-select form-select-sm" @bind="filter.Durum" @bind:after="AraAsync">
                            <option value="">Tümü</option>
                            @foreach (var durum in DestekKurallari.EkipDurumlari)
                            {
                                <option value="@durum">@DestekKurallari.Etiket(durum)</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-4 col-xl-1">
                        <label class="form-label small mb-1" for="dlOncelik">Öncelik</label>
                        <select id="dlOncelik" class="form-select form-select-sm" @bind="filter.Oncelik" @bind:after="AraAsync">
                            <option value="">Tümü</option>
                            @foreach (var oncelik in Enum.GetValues<DestekOncelik>())
                            {
                                <option value="@oncelik">@DestekKurallari.OncelikEtiketi(oncelik)</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <label class="form-label small mb-1" for="dlDepartman">Departman</label>
                        <select id="dlDepartman" class="form-select form-select-sm" @bind="filter.DepartmanId" @bind:after="AraAsync">
                            <option value="">Tümü</option>
                            @foreach (var departman in departmanlar)
                            {
                                <option value="@departman.Id">@departman.Ad</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <label class="form-label small mb-1" for="dlAtanan">Atanan</label>
                        <select id="dlAtanan" class="form-select form-select-sm" @bind="filter.AtananKullaniciId" @bind:after="AraAsync">
                            <option value="">Tümü</option>
                            <option value="0">Atanmamış</option>
                            @if (aktor != null)
                            {
                                <option value="@aktor.Id">Bana atananlar</option>
                            }
                            @foreach (var kisi in atanabilirler.Where(a => a.Id != aktor?.Id))
                            {
                                <option value="@kisi.Id">@kisi.AdSoyad</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <label class="form-label small mb-1" for="dlKaynak">Kaynak</label>
                        <select id="dlKaynak" class="form-select form-select-sm" @bind="filter.Kaynak" @bind:after="AraAsync">
                            <option value="">Tümü</option>
                            @foreach (var kaynak in Enum.GetValues<DestekKaynak>())
                            {
                                <option value="@kaynak">@DestekKurallari.KaynakEtiketi(kaynak)</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 d-flex flex-wrap gap-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="dlAcik" @bind="sadeceAcik" @bind:after="AraAsync" />
                            <label class="form-check-label small" for="dlAcik">Yalnız açık talepler</label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="dlSla" @bind="slaAsildi" @bind:after="AraAsync" />
                            <label class="form-check-label small" for="dlSla">SLA aşılanlar</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (yukleniyor)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
        }
        else if (sonuc == null || sonuc.Items.Count == 0)
        {
            <div class="alert alert-light border text-center"><i class="bi bi-inbox me-2"></i>Süzgece uyan destek talebi yok.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 140px;">Talep No</th>
                            <th>Konu</th>
                            <th class="d-none d-md-table-cell" style="width: 160px;">Talep Eden</th>
                            <th class="d-none d-lg-table-cell" style="width: 120px;">Departman</th>
                            <th style="width: 90px;">Öncelik</th>
                            <th style="width: 140px;">Durum</th>
                            <th class="d-none d-lg-table-cell" style="width: 130px;">Atanan</th>
                            <th class="d-none d-xl-table-cell" style="width: 100px;">SLA</th>
                            <th class="d-none d-md-table-cell" style="width: 110px;">Son Aktivite</th>
                            <th style="width: 80px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var talep in sonuc.Items)
                        {
                            <tr class="@(talep.SlaAsildi && DestekKurallari.AcikMi(talep.Durum) ? "table-danger" : string.Empty)">
                                <td>
                                    <a href="destek-talepleri/@talep.Id" class="text-decoration-none fw-bold">@talep.TalepNo</a>
                                    @if (talep.Kaynak == DestekKaynak.HataBildirimi)
                                    {
                                        <i class="bi bi-bug text-danger ms-1" title="Program içi hata bildirimi"></i>
                                    }
                                </td>
                                <td>
                                    <span class="text-truncate d-inline-block" style="max-width: 280px;" title="@talep.Konu">@talep.Konu</span>
                                    @if (!string.IsNullOrEmpty(talep.Etiketler))
                                    {
                                        <div>
                                            @foreach (var etiket in talep.Etiketler.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Take(3))
                                            {
                                                <span class="badge bg-secondary bg-opacity-25 text-body border me-1">@etiket</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="d-none d-md-table-cell"><small>@talep.MusteriAdi</small></td>
                                <td class="d-none d-lg-table-cell"><small>@talep.Departman?.Ad</small></td>
                                <td><DestekOncelikRozeti Oncelik="talep.Oncelik" /></td>
                                <td><DestekDurumRozeti Durum="talep.Durum" /></td>
                                <td class="d-none d-lg-table-cell"><small class="@(talep.AtananKullanici == null ? "text-muted" : string.Empty)">@(talep.AtananKullanici?.AdSoyad ?? "Atanmamış")</small></td>
                                <td class="d-none d-xl-table-cell">@SlaRozeti(talep)</td>
                                <td class="d-none d-md-table-cell">
                                    <small title="@MKFiloServis.Shared.Time.BusinessTime.LocalAt(talep.SonAktiviteTarihi).ToString("dd.MM.yyyy HH:mm")">@GoreliZaman(talep.SonAktiviteTarihi)</small>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="destek-talepleri/@talep.Id" class="btn btn-outline-primary" title="Aç"><i class="bi bi-eye"></i></a>
                                        @if (DestekKurallari.AcikMi(talep.Durum) || aktor?.Silebilir == true)
                                        {
                                            <button class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" title="İşlemler"></button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                @if (DestekKurallari.AcikMi(talep.Durum))
                                                {
                                                    <li><button class="dropdown-item" @onclick="() => AtamaAc(talep)"><i class="bi bi-person-plus me-2"></i>Ata</button></li>
                                                }
                                                @if (aktor?.Silebilir == true)
                                                {
                                                    <li><button class="dropdown-item text-danger" @onclick="() => SilAsync(talep)"><i class="bi bi-trash me-2"></i>Sil</button></li>
                                                }
                                            </ul>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2">
                <small class="text-muted">Toplam @sonuc.TotalCount kayıt</small>
                @if (sonuc.TotalPages > 1)
                {
                    <nav aria-label="Sayfalama">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(filter.Page <= 1 ? "disabled" : string.Empty)"><button class="page-link" @onclick="() => SayfaAsync(filter.Page - 1)">Önceki</button></li>
                            @for (var i = Math.Max(1, filter.Page - 2); i <= Math.Min(sonuc.TotalPages, filter.Page + 2); i++)
                            {
                                var sayfa = i;
                                <li class="page-item @(sayfa == filter.Page ? "active" : string.Empty)"><button class="page-link" @onclick="() => SayfaAsync(sayfa)">@sayfa</button></li>
                            }
                            <li class="page-item @(filter.Page >= sonuc.TotalPages ? "disabled" : string.Empty)"><button class="page-link" @onclick="() => SayfaAsync(filter.Page + 1)">Sonraki</button></li>
                        </ul>
                    </nav>
                }
            </div>
        }
    }
</div>

@if (yeniTalepAcik)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Müşteri Adına Destek Talebi</h5>
                    <button type="button" class="btn-close" @onclick="() => yeniTalepAcik = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="ytCari">İlişkili cari</label>
                            <select id="ytCari" class="form-select" @bind="yeniTalep.CariId" @bind:after="CariSecildi">
                                <option value="">Seçiniz...</option>
                                @foreach (var cari in cariler)
                                {
                                    <option value="@cari.Id">@cari.Unvan</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ytAd">Müşteri adı <span class="text-danger">*</span></label>
                            <input id="ytAd" class="form-control" @bind="yeniTalep.MusteriAdi" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ytEposta">E-posta</label>
                            <input id="ytEposta" type="email" class="form-control" @bind="yeniTalep.MusteriEmail" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ytTelefon">Telefon</label>
                            <input id="ytTelefon" class="form-control" @bind="yeniTalep.MusteriTelefon" maxlength="20" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ytDepartman">Departman <span class="text-danger">*</span></label>
                            <select id="ytDepartman" class="form-select" @bind="yeniTalep.DepartmanId">
                                <option value="0">Seçiniz...</option>
                                @foreach (var departman in departmanlar)
                                {
                                    <option value="@departman.Id">@departman.Ad</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ytKategori">Kategori</label>
                            <select id="ytKategori" class="form-select" @bind="yeniTalep.KategoriId">
                                <option value="">Seçiniz...</option>
                                @foreach (var kategori in kategoriler.Where(k => k.DepartmanId == null || k.DepartmanId == yeniTalep.DepartmanId))
                                {
                                    <option value="@kategori.Id">@kategori.Ad</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ytOncelik">Öncelik</label>
                            <select id="ytOncelik" class="form-select" @bind="yeniTalep.Oncelik">
                                @foreach (var oncelik in Enum.GetValues<DestekOncelik>())
                                {
                                    <option value="@oncelik">@DestekKurallari.OncelikEtiketi(oncelik)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ytKaynak">Kaynak</label>
                            <select id="ytKaynak" class="form-select" @bind="yeniTalep.Kaynak">
                                @foreach (var kaynak in Enum.GetValues<DestekKaynak>().Where(k => k != DestekKaynak.HataBildirimi))
                                {
                                    <option value="@kaynak">@DestekKurallari.KaynakEtiketi(kaynak)</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="ytKonu">Konu <span class="text-danger">*</span></label>
                            <input id="ytKonu" class="form-control" @bind="yeniTalep.Konu" maxlength="500" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="ytAciklama">Açıklama <span class="text-danger">*</span></label>
                            <textarea id="ytAciklama" class="form-control" rows="5" @bind="yeniTalep.Aciklama"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="ytEtiket">Etiketler</label>
                            <input id="ytEtiket" class="form-control" @bind="yeniTalep.Etiketler" placeholder="Virgülle ayırın: fatura, yazdırma" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => yeniTalepAcik = false">İptal</button>
                    <button type="button" class="btn btn-primary" @onclick="YeniTalepKaydetAsync" disabled="@kaydediliyor">
                        @if (kaydediliyor)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-check-lg me-1"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (atanacakTalep != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i>Talep Ata</h5>
                    <button type="button" class="btn-close" @onclick="() => atanacakTalep = null"></button>
                </div>
                <div class="modal-body">
                    <p class="small"><strong>@atanacakTalep.TalepNo</strong> · @atanacakTalep.Konu</p>
                    <label class="form-label" for="dlAtanacak">Atanacak kişi</label>
                    <select id="dlAtanacak" class="form-select" @bind="secilenKullaniciId">
                        <option value="">Seçiniz...</option>
                        @foreach (var kisi in atanabilirler)
                        {
                            <option value="@kisi.Id">@kisi.AdSoyad@(kisi.YazilimEkibi ? " (yazılım)" : string.Empty)</option>
                        }
                    </select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => atanacakTalep = null">İptal</button>
                    <button type="button" class="btn btn-primary" @onclick="AtaAsync" disabled="@(kaydediliyor || secilenKullaniciId == null)"><i class="bi bi-check-lg me-1"></i>Ata</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private DestekTalebiFilterParams filter = new() { Page = 1, PageSize = 20 };
    private PagedResult<DestekTalebi>? sonuc;
    private DestekDashboardStats? stats;
    private DestekKullanici? aktor;
    private List<DestekDepartman> departmanlar = new();
    private List<DestekKategori> kategoriler = new();
    private List<DestekAtanabilirKullanici> atanabilirler = new();
    private List<Cari> cariler = new();

    private bool yukleniyor = true;
    private bool kaydediliyor;
    private bool yetkisiz;
    private string? yuklemeHatasi;
    private bool sadeceAcik = true;
    private bool slaAsildi;

    private bool yeniTalepAcik;
    private DestekTalebi yeniTalep = new();
    private DestekTalebi? atanacakTalep;
    private int? secilenKullaniciId;

    protected override async Task OnInitializedAsync()
    {
        await SayfayiYenileAsync();
    }

    private async Task SayfayiYenileAsync()
    {
        yuklemeHatasi = null;
        aktor = await DestekService.GetAktifKullaniciAsync();
        if (aktor?.EkipUyesi != true)
        {
            yetkisiz = true;
            yukleniyor = false;
            return;
        }

        try
        {
            departmanlar = await DestekService.GetDepartmanlarAsync(pasiflerDahil: true);
            kategoriler = await DestekService.GetKategorilerAsync();
            atanabilirler = await DestekService.GetAtanabilirKullanicilarAsync(null);
        }
        catch (Exception ex)
        {
            yuklemeHatasi = ex.GetBaseException().Message;
        }

        await AraAsync();
        await IstatistikYukleAsync();
    }

    private async Task IstatistikYukleAsync()
    {
        try
        {
            stats = await DestekService.GetDashboardStatsAsync();
        }
        catch (Exception ex)
        {
            stats = null;
            yuklemeHatasi ??= $"İstatistikler yüklenemedi: {ex.GetBaseException().Message}";
        }
    }

    private async Task AraAsync()
    {
        filter.Page = 1;
        await ListeYukleAsync();
    }

    private async Task ListeYukleAsync()
    {
        yukleniyor = true;
        try
        {
            filter.SadeceAcik = sadeceAcik ? true : null;
            filter.SlaAsildi = slaAsildi ? true : null;
            sonuc = await DestekService.GetPagedAsync(filter);
        }
        catch (Exception ex)
        {
            sonuc = null;
            yuklemeHatasi ??= $"Talepler yüklenemedi: {ex.GetBaseException().Message}";
        }
        finally
        {
            yukleniyor = false;
        }
    }

    private async Task AramaTusAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await AraAsync();
    }

    private async Task SayfaAsync(int sayfa)
    {
        filter.Page = Math.Max(1, sayfa);
        await ListeYukleAsync();
    }

    private static RenderFragment SlaRozeti(DestekTalebi talep) => builder =>
    {
        if (!talep.SlaBitisTarihi.HasValue || !DestekKurallari.AcikMi(talep.Durum))
        {
            builder.AddMarkupContent(0, "<span class=\"text-muted\">-</span>");
            return;
        }

        var kalan = talep.SlaBitisTarihi.Value - DateTime.UtcNow;
        var (sinif, metin) = talep.SlaAsildi || kalan < TimeSpan.Zero
            ? ("badge bg-danger", "Aşıldı")
            : kalan.TotalHours < 4
                ? ("badge bg-warning text-dark", $"{(int)kalan.TotalHours} sa {kalan.Minutes} dk")
                : ("small text-success", $"{(int)kalan.TotalHours} sa");
        builder.OpenElement(1, "span");
        builder.AddAttribute(2, "class", sinif);
        builder.AddContent(3, metin);
        builder.CloseElement();
    };

    private static string GoreliZaman(DateTime utc)
    {
        var fark = DateTime.UtcNow - utc;
        if (fark.TotalMinutes < 1) return "Az önce";
        if (fark.TotalMinutes < 60) return $"{(int)fark.TotalMinutes} dk önce";
        if (fark.TotalHours < 24) return $"{(int)fark.TotalHours} saat önce";
        if (fark.TotalDays < 7) return $"{(int)fark.TotalDays} gün önce";
        return MKFiloServis.Shared.Time.BusinessTime.LocalAt(utc).ToString("dd.MM.yyyy");
    }

    private async Task YeniTalepAc()
    {
        yeniTalep = new DestekTalebi
        {
            Oncelik = DestekOncelik.Normal,
            Kaynak = DestekKaynak.Telefon,
            DepartmanId = departmanlar.FirstOrDefault(d => d.Aktif)?.Id ?? 0
        };
        if (cariler.Count == 0)
        {
            try
            {
                cariler = (await CariService.GetAllAsync()).Where(c => c.Aktif).OrderBy(c => c.Unvan).ToList();
            }
            catch
            {
                cariler = new();
            }
        }
        yeniTalepAcik = true;
    }

    private void CariSecildi()
    {
        var cari = cariler.FirstOrDefault(c => c.Id == yeniTalep.CariId);
        if (cari == null) return;
        yeniTalep.MusteriAdi = cari.Unvan;
        yeniTalep.MusteriEmail = cari.Email ?? string.Empty;
        yeniTalep.MusteriTelefon = cari.Telefon;
    }

    private async Task YeniTalepKaydetAsync()
    {
        kaydediliyor = true;
        try
        {
            var kayit = await DestekService.PersonelTalepOlusturAsync(yeniTalep);
            ToastService.ShowSuccess($"Talep açıldı: {kayit.TalepNo}");
            yeniTalepAcik = false;
            await ListeYukleAsync();
            await IstatistikYukleAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.GetBaseException().Message);
        }
        finally
        {
            kaydediliyor = false;
        }
    }

    private void AtamaAc(DestekTalebi talep)
    {
        atanacakTalep = talep;
        secilenKullaniciId = talep.AtananKullaniciId;
    }

    private async Task AtaAsync()
    {
        if (atanacakTalep == null || secilenKullaniciId == null) return;

        kaydediliyor = true;
        try
        {
            await DestekService.AtaAsync(atanacakTalep.Id, secilenKullaniciId.Value);
            ToastService.ShowSuccess($"{atanacakTalep.TalepNo} atandı.");
            atanacakTalep = null;
            await ListeYukleAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.GetBaseException().Message);
        }
        finally
        {
            kaydediliyor = false;
        }
    }

    private async Task SilAsync(DestekTalebi talep)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"{talep.TalepNo} talebi silinsin mi?"))
            return;

        try
        {
            await DestekService.SilAsync(talep.Id);
            ToastService.ShowSuccess("Talep silindi.");
            await ListeYukleAsync();
            await IstatistikYukleAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.GetBaseException().Message);
        }
    }
}
