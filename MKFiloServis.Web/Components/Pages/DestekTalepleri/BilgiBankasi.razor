@page "/destek-talepleri/bilgi-bankasi"
@rendermode InteractiveServer
@inject IDestekTalebiService DestekService
@inject IToastService ToastService
@inject IJSRuntime JS

<PageTitle>Bilgi Bankası - MK Filo Servis</PageTitle>

<div class="container-fluid">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h4 class="mb-0"><i class="bi bi-book me-2"></i>Bilgi Bankası</h4>
        <div class="d-flex flex-wrap gap-2">
            <a href="/destek-talepleri/taleplerim" class="btn btn-outline-primary btn-sm"><i class="bi bi-ticket-detailed me-1"></i>Taleplerim</a>
            @if (aktor?.MakaleYazar == true)
            {
                <button class="btn btn-primary btn-sm" @onclick="YeniMakale"><i class="bi bi-plus-lg me-1"></i>Yeni Makale</button>
            }
        </div>
    </div>

    @if (kapali)
    {
        <div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>Bilgi bankası şu an kullanıma kapalı. Sorununuz için <a href="/destek-talepleri/talep-giris" class="alert-link">destek talebi</a> açabilirsiniz.</div>
    }
    else
    {
        @if (yuklemeHatasi != null)
        {
            <div class="alert alert-warning d-flex justify-content-between align-items-start mb-3">
                <div><i class="bi bi-exclamation-triangle me-2"></i>@yuklemeHatasi</div>
                <button class="btn btn-outline-warning btn-sm" @onclick="SayfayiYenileAsync"><i class="bi bi-arrow-clockwise me-1"></i>Tekrar Dene</button>
            </div>
        }

        <div class="card mb-3">
            <div class="card-body py-2">
                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label small mb-1" for="bbArama">Arama</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input id="bbArama" type="text" class="form-control" @bind="filter.AramaMetni" @bind:event="oninput" @onkeyup="AramaTusAsync" placeholder="Sorununuzu yazın (Enter)" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-1" for="bbKategori">Kategori</label>
                        <select id="bbKategori" class="form-select form-select-sm" @bind="filter.KategoriId" @bind:after="SuzAsync">
                            <option value="">Tüm Kategoriler</option>
                            @foreach (var kategori in kategoriler)
                            {
                                <option value="@kategori.Id">@kategori.Ad</option>
                            }
                        </select>
                    </div>
                    @if (aktor?.MakaleYazar == true)
                    {
                        <div class="col-md-2">
                            <label class="form-label small mb-1" for="bbDurum">Durum</label>
                            <select id="bbDurum" class="form-select form-select-sm" @bind="filter.Durum" @bind:after="SuzAsync">
                                <option value="">Tümü</option>
                                @foreach (var durum in Enum.GetValues<BilgiBankasiDurum>())
                                {
                                    <option value="@durum">@DurumEtiketi(durum)</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="col-md-2">
                        <button class="btn btn-outline-secondary btn-sm w-100" @onclick="FiltreleriTemizleAsync"><i class="bi bi-x-circle me-1"></i>Temizle</button>
                    </div>
                </div>
            </div>
        </div>

        @if (aktor?.MakaleYazar == true && ozet != null)
        {
            <div class="row g-2 mb-3">
                <div class="col-6 col-md-3"><div class="card text-center"><div class="card-body py-2"><div class="h5 mb-0">@ozet.Toplam</div><small class="text-muted">Makale</small></div></div></div>
                <div class="col-6 col-md-3"><div class="card text-center"><div class="card-body py-2"><div class="h5 mb-0 text-success">@ozet.Yayinda</div><small class="text-muted">Yayında</small></div></div></div>
                <div class="col-6 col-md-3"><div class="card text-center"><div class="card-body py-2"><div class="h5 mb-0 text-warning">@ozet.Taslak</div><small class="text-muted">Taslak</small></div></div></div>
                <div class="col-6 col-md-3"><div class="card text-center"><div class="card-body py-2"><div class="h5 mb-0 text-info">@ozet.ToplamGoruntulenme</div><small class="text-muted">Görüntülenme</small></div></div></div>
            </div>
        }

        @if (yukleniyor)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
        }
        else if (sonuc == null || sonuc.Items.Count == 0)
        {
            <div class="alert alert-light border text-center">
                <i class="bi bi-info-circle me-2"></i>Makale bulunamadı.
                Aradığınızı bulamadıysanız <a href="/destek-talepleri/talep-giris">destek talebi açın</a>.
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var makale in sonuc.Items)
                {
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="card h-100 @(makale.Durum == BilgiBankasiDurum.Yayinda ? string.Empty : "border-warning")">
                            <div class="card-header d-flex justify-content-between align-items-center py-2">
                                <span class="badge" style="background-color: @(makale.Kategori?.Renk ?? "#6c757d")">@(makale.Kategori?.Ad ?? "Genel")</span>
                                @if (aktor?.MakaleYazar == true)
                                {
                                    <span class="badge @DurumRozeti(makale.Durum)">@DurumEtiketi(makale.Durum)</span>
                                }
                            </div>
                            <div class="card-body">
                                <h6 class="card-title"><i class="bi @(makale.Kategori?.Simge ?? "bi-file-text") me-1"></i>@makale.Baslik</h6>
                                <p class="card-text text-muted small">@(makale.Ozet?.Length > 140 ? makale.Ozet[..140] + "..." : makale.Ozet)</p>
                                @if (!string.IsNullOrWhiteSpace(makale.Etiketler))
                                {
                                    @foreach (var etiket in makale.Etiketler.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Take(3))
                                    {
                                        <span class="badge bg-secondary bg-opacity-25 text-body border me-1">@etiket</span>
                                    }
                                }
                            </div>
                            <div class="card-footer bg-transparent d-flex justify-content-between align-items-center py-2">
                                <small class="text-muted">
                                    <i class="bi bi-eye me-1"></i>@makale.GoruntulemeSayisi
                                    <i class="bi bi-hand-thumbs-up ms-2 me-1"></i>@makale.YararliBulmaSayisi
                                </small>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" @onclick="() => OkuAsync(makale)" title="Oku"><i class="bi bi-book-half me-1"></i>Oku</button>
                                    @if (aktor?.MakaleYazar == true)
                                    {
                                        <button class="btn btn-outline-primary" @onclick="() => MakaleDuzenle(makale)" title="Düzenle"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-outline-danger" @onclick="() => MakaleSilAsync(makale)" title="Sil"><i class="bi bi-trash"></i></button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (sonuc.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <small class="text-muted">Toplam @sonuc.TotalCount kayıt</small>
                    <nav aria-label="Sayfalama">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(filter.Page <= 1 ? "disabled" : string.Empty)"><button class="page-link" @onclick="() => SayfaAsync(filter.Page - 1)">Önceki</button></li>
                            @for (var i = Math.Max(1, filter.Page - 2); i <= Math.Min(sonuc.TotalPages, filter.Page + 2); i++)
                            {
                                var sayfa = i;
                                <li class="page-item @(sayfa == filter.Page ? "active" : string.Empty)"><button class="page-link" @onclick="() => SayfaAsync(sayfa)">@sayfa</button></li>
                            }
                            <li class="page-item @(filter.Page >= sonuc.TotalPages ? "disabled" : string.Empty)"><button class="page-link" @onclick="() => SayfaAsync(filter.Page + 1)">Sonraki</button></li>
                        </ul>
                    </nav>
                </div>
            }
        }
    }
</div>

@if (okunan != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-book-half me-2"></i>@okunan.Baslik</h5>
                    <button type="button" class="btn-close" @onclick="() => okunan = null"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(okunan.Ozet))
                    {
                        <p class="lead fs-6 text-muted">@okunan.Ozet</p>
                    }
                    <DestekMetni Metin="@okunan.Icerik" Html="true" />
                </div>
                <div class="modal-footer justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        @if (oyVerildi)
                        {
                            <span class="small text-success"><i class="bi bi-check-circle me-1"></i>Geri bildiriminiz için teşekkürler.</span>
                        }
                        else
                        {
                            <span class="small text-muted">Bu makale işinize yaradı mı?</span>
                            <button class="btn btn-outline-success btn-sm" @onclick="() => OyAsync(true)"><i class="bi bi-hand-thumbs-up"></i></button>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => OyAsync(false)"><i class="bi bi-hand-thumbs-down"></i></button>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        <a href="/destek-talepleri/talep-giris" class="btn btn-outline-primary btn-sm">Sorunum çözülmedi, talep aç</a>
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => okunan = null">Kapat</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (duzenlenen != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-file-text me-2"></i>@(duzenlenen.Id > 0 ? "Makale Düzenle" : "Yeni Makale")</h5>
                    <button type="button" class="btn-close" @onclick="() => duzenlenen = null"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="bmBaslik">Başlık <span class="text-danger">*</span></label>
                        <input id="bmBaslik" type="text" class="form-control" @bind="duzenlenen.Baslik" maxlength="500" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="bmKategori">Kategori</label>
                            <select id="bmKategori" class="form-select" @bind="duzenlenen.KategoriId">
                                <option value="">-- Seçiniz --</option>
                                @foreach (var kategori in kategoriler)
                                {
                                    <option value="@kategori.Id">@kategori.Ad</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="bmDurum">Durum</label>
                            <select id="bmDurum" class="form-select" @bind="duzenlenen.Durum">
                                @foreach (var durum in Enum.GetValues<BilgiBankasiDurum>())
                                {
                                    <option value="@durum">@DurumEtiketi(durum)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="bmOzet">Özet</label>
                        <textarea id="bmOzet" class="form-control" rows="2" @bind="duzenlenen.Ozet"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="bmIcerik">İçerik <span class="text-danger">*</span></label>
                        <textarea id="bmIcerik" class="form-control" rows="10" @bind="duzenlenen.Icerik"></textarea>
                        <div class="form-text">Düz metin; satır sonları korunur.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="bmEtiket">Etiketler</label>
                        <input id="bmEtiket" type="text" class="form-control" @bind="duzenlenen.Etiketler" placeholder="anahtar1, anahtar2" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => duzenlenen = null">İptal</button>
                    <button type="button" class="btn btn-primary" @onclick="KaydetAsync" disabled="@kaydediliyor">
                        @if (kaydediliyor)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private BilgiBankasiFilterParams filter = new() { Page = 1, PageSize = 12, SortBy = "CreatedAt", SortDesc = true };
    private PagedResult<DestekBilgiBankasi>? sonuc;
    private BilgiBankasiOzeti? ozet;
    private List<DestekKategori> kategoriler = new();
    private DestekKullanici? aktor;
    private DestekBilgiBankasi? duzenlenen;
    private DestekBilgiBankasi? okunan;
    private bool oyVerildi;
    private bool yukleniyor = true;
    private bool kaydediliyor;
    private bool kapali;
    private string? yuklemeHatasi;

    protected override async Task OnInitializedAsync()
    {
        await SayfayiYenileAsync();
    }

    private async Task SayfayiYenileAsync()
    {
        yuklemeHatasi = null;
        try
        {
            aktor = await DestekService.GetAktifKullaniciAsync();
            var ayarlar = await DestekService.GetGenelAyarlarAsync();
            kapali = !ayarlar.BilgiBankasiAcik && aktor?.MakaleYazar != true;
            kategoriler = await DestekService.GetKategorilerAsync();
        }
        catch (Exception ex)
        {
            yuklemeHatasi = ex.GetBaseException().Message;
        }

        if (!kapali)
            await YukleAsync();
    }

    private async Task YukleAsync()
    {
        yukleniyor = true;
        try
        {
            sonuc = await DestekService.GetBilgiBankasiPagedAsync(filter);
            if (aktor?.MakaleYazar == true)
                ozet = await DestekService.GetBilgiBankasiOzetiAsync();
        }
        catch (Exception ex)
        {
            sonuc = null;
            yuklemeHatasi ??= $"Bilgi bankası yüklenemedi: {ex.GetBaseException().Message}";
        }
        finally
        {
            yukleniyor = false;
        }
    }

    private async Task SuzAsync()
    {
        filter.Page = 1;
        await YukleAsync();
    }

    private async Task AramaTusAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SuzAsync();
    }

    private async Task FiltreleriTemizleAsync()
    {
        filter = new BilgiBankasiFilterParams { Page = 1, PageSize = 12, SortBy = "CreatedAt", SortDesc = true };
        await YukleAsync();
    }

    private async Task SayfaAsync(int sayfa)
    {
        filter.Page = Math.Max(1, sayfa);
        await YukleAsync();
    }

    private async Task OkuAsync(DestekBilgiBankasi makale)
    {
        okunan = makale;
        oyVerildi = false;
        try
        {
            await DestekService.IncrementBilgiBankasiGoruntulenmeAsync(makale.Id);
            makale.GoruntulemeSayisi++;
        }
        catch
        {
            // Görüntülenme sayacı okumayı engellemez.
        }
    }

    private async Task OyAsync(bool yararli)
    {
        if (okunan == null) return;
        try
        {
            await DestekService.YararliBulAsync(okunan.Id, yararli);
            if (yararli) okunan.YararliBulmaSayisi++;
            oyVerildi = true;
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.GetBaseException().Message);
        }
    }

    private void YeniMakale() => duzenlenen = new DestekBilgiBankasi { Durum = BilgiBankasiDurum.Taslak };

    private void MakaleDuzenle(DestekBilgiBankasi makale) => duzenlenen = new DestekBilgiBankasi
    {
        Id = makale.Id,
        Baslik = makale.Baslik,
        Ozet = makale.Ozet,
        Icerik = makale.Icerik,
        KategoriId = makale.KategoriId,
        Etiketler = makale.Etiketler,
        Durum = makale.Durum,
        Slug = makale.Slug,
        SeoBaslik = makale.SeoBaslik,
        SeoAciklama = makale.SeoAciklama
    };

    private async Task KaydetAsync()
    {
        if (duzenlenen == null) return;
        if (string.IsNullOrWhiteSpace(duzenlenen.Baslik) || string.IsNullOrWhiteSpace(duzenlenen.Icerik))
        {
            ToastService.ShowWarning("Başlık ve içerik zorunludur.");
            return;
        }

        kaydediliyor = true;
        try
        {
            await DestekService.BilgiBankasiKaydetAsync(duzenlenen);
            ToastService.ShowSuccess(duzenlenen.Id > 0 ? "Makale güncellendi." : "Makale oluşturuldu.");
            duzenlenen = null;
            await YukleAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Makale kaydedilemedi: {ex.GetBaseException().Message}");
        }
        finally
        {
            kaydediliyor = false;
        }
    }

    private async Task MakaleSilAsync(DestekBilgiBankasi makale)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"'{makale.Baslik}' makalesi silinsin mi?"))
            return;

        try
        {
            await DestekService.BilgiBankasiSilAsync(makale.Id);
            ToastService.ShowSuccess("Makale silindi.");
            await YukleAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Makale silinemedi: {ex.GetBaseException().Message}");
        }
    }

    private static string DurumEtiketi(BilgiBankasiDurum durum) => durum switch
    {
        BilgiBankasiDurum.Taslak => "Taslak",
        BilgiBankasiDurum.IncelemeBekliyor => "İnceleme Bekliyor",
        BilgiBankasiDurum.Yayinda => "Yayında",
        BilgiBankasiDurum.Arsiv => "Arşiv",
        _ => durum.ToString()
    };

    private static string DurumRozeti(BilgiBankasiDurum durum) => durum switch
    {
        BilgiBankasiDurum.Taslak => "bg-warning text-dark",
        BilgiBankasiDurum.IncelemeBekliyor => "bg-info text-dark",
        BilgiBankasiDurum.Yayinda => "bg-success",
        _ => "bg-secondary"
    };
}
