    #region Excel Import

    private void ExcelImportModalAc()
    {
        if (disposed || isLoading || isImporting) return;
        ImportModalKapat();
        showImportModal = true;
    }

    private void ImportModalKapat()
    {
        System.Threading.Interlocked.Increment(ref importModalSurumu);
        showImportModal = false;
        importFile = null;
        importResult = null;
        // isImporting tüm ekran için işlem kilididir; modal kapansa da devam eder.
    }

    private void DosyaSecildi(InputFileChangeEventArgs e)
    {
        if (disposed || !showImportModal || isImporting) return;
        System.Threading.Interlocked.Increment(ref importModalSurumu);
        importFile = e.File;
        importResult = null;
    }

    private bool ImportIslemiGuncel(long surum, IBrowserFile dosya, int? firmaId, bool tumFirmalar)
        => !disposed && showImportModal && ReferenceEquals(importFile, dosya) &&
           surum == System.Threading.Volatile.Read(ref importModalSurumu) &&
           AktifFirmaProvider.AktifFirmaId == firmaId && AktifFirmaProvider.TumFirmalar == tumFirmalar;

    private async Task SablonIndir()
    {
        try
        {
            var bytes = await AracService.GetExcelSablonAsync();
            await JS.InvokeVoidAsync("downloadFileFromBase64", "arac_sablon.xlsx", Convert.ToBase64String(bytes));
            ToastService.ShowSuccess("Şablon indirildi!");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Hata: {ex.Message}");
        }
    }

    private async Task ExcelImportYap()
    {
        if (disposed || !showImportModal || isLoading || isImporting || importFile == null) return;
        var dosya = importFile;
        var surum = System.Threading.Volatile.Read(ref importModalSurumu);
        var firmaId = AktifFirmaProvider.AktifFirmaId;
        var tumFirmalar = AktifFirmaProvider.TumFirmalar;
        if (tumFirmalar || firmaId is not > 0)
        {
            ToastService.ShowWarning("Araç aktarımı için tek bir firma seçin.");
            return;
        }
        isImporting = true;
        importResult = null;
        StateHasChanged();
        try
        {
            using var stream = new MemoryStream();
            await using var source = dosya.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            await source.CopyToAsync(stream);
            // Dosya okunurken seçim değişmişse henüz servis yazımı başlatılmaz.
            if (!ImportIslemiGuncel(surum, dosya, firmaId, tumFirmalar)) return;
            var sonuc = await AracService.ImportFromExcelAsync(stream.ToArray());
            var kayitVar = sonuc.ImportedCount > 0 || sonuc.UpdatedCount > 0;
            if (!ImportIslemiGuncel(surum, dosya, firmaId, tumFirmalar))
            {
                // The dialog or company changed while the service was saving rows.
                // Never write its result into a new dialog, but do report commits.
                if (!disposed)
                {
                    ToastService.ShowWarning($"Önceki firma ({firmaId}) araç aktarımı bitti: {sonuc.ImportedCount} eklendi, {sonuc.UpdatedCount} güncellendi, {sonuc.ErrorCount} hata. İlgili firma listesini kontrol edin.");
                    if (kayitVar) await LoadData();
                }
                return;
            }
            importResult = sonuc;
            if (!sonuc.Success || sonuc.ErrorCount > 0)
                ToastService.ShowWarning($"Aktarım tamamı başarılı değil: {sonuc.ImportedCount} eklendi, {sonuc.UpdatedCount} güncellendi. Ayrıntıları kontrol edin.");
            else
                ToastService.ShowSuccess($"{sonuc.ImportedCount} araç eklendi, {sonuc.UpdatedCount} güncellendi.");
            // Okuma sonunda hata olsa da daha önce commit edilen satırlar listeye yansıtılır.
            if (kayitVar) await LoadData();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Araç Excel aktarımı başarısız. Firma: {FirmaId}", firmaId);
            if (ImportIslemiGuncel(surum, dosya, firmaId, tumFirmalar))
            {
                importResult = new AracImportResult
                {
                    Success = false,
                    Errors = new List<string> { "Aktarım tamamlanamadı. Dosyayı ve firma seçimini kontrol edin." }
                };
                ToastService.ShowError("Aktarım tamamlanamadı. Dosyayı ve firma seçimini kontrol edin.");
            }
            else if (!disposed)
            {
                ToastService.ShowWarning($"Önceki firma ({firmaId}) araç aktarımı hata verdi; bazı satırlar kaydedilmiş olabilir. İlgili firma listesini kontrol edin.");
                await LoadData();
            }
        }
        finally
        {
            // Kilit tutulduğu sürece başka aktarım başlayamaz; yalnız bu işlem kilidi bırakır.
            isImporting = false;
            if (!disposed) StateHasChanged();
        }
    }

    #endregion

    #region Plaka Geçmişi

    private void PlakaGecmisiAc(Arac arac)
    {
        if (disposed || isLoading) return;
        var guncelArac = tumAraclar.FirstOrDefault(a => a.Id == arac.Id);
        if (guncelArac == null) return;
        PlakaGecmisiKapat();
        seciliArac = guncelArac;
        plakaGecmisi = new List<AracPlaka>(guncelArac.PlakaGecmisi);
        yeniPlaka = new AracPlaka();
        yeniPlakaGirisTarihi = DateTime.Today;
        yeniPlakaCikisTarihi = null;
        showPlakaGecmisiModal = true;
    }

    private void PlakaGecmisiKapat()
    {
        System.Threading.Interlocked.Increment(ref plakaModalSurumu);
        showPlakaGecmisiModal = false;
        seciliArac = null;
        plakaGecmisi = null;
        isPlakaKaydediliyor = false;
    }

    private bool PlakaIslemiGuncel(long surum, int aracId, int? firmaId, bool tumFirmalar)
        => !disposed && showPlakaGecmisiModal && seciliArac?.Id == aracId &&
           surum == System.Threading.Volatile.Read(ref plakaModalSurumu) &&
           AktifFirmaProvider.AktifFirmaId == firmaId && AktifFirmaProvider.TumFirmalar == tumFirmalar;

    private Task YeniPlakaEkle()
    {
        if (seciliArac == null || string.IsNullOrWhiteSpace(yeniPlaka.Plaka)) return Task.CompletedTask;
        var istek = new AracPlaka
        {
            AracId = seciliArac.Id,
            Plaka = yeniPlaka.Plaka.Trim().ToUpperInvariant(),
            GirisTarihi = yeniPlakaGirisTarihi,
            CikisTarihi = yeniPlakaCikisTarihi,
            IslemTipi = yeniPlaka.IslemTipi,
            Aciklama = yeniPlaka.Aciklama
        };
        return PlakaIsleminiYurut(() => AracService.AddPlakaToAracAsync(istek), "Yeni plaka eklendi.", true);
    }

    private bool PlakaSecimeAit(AracPlaka plaka)
        => seciliArac != null && plaka.AracId == seciliArac.Id &&
           plakaGecmisi?.Any(p => p.Id == plaka.Id) == true;

    private Task PlakaSil(AracPlaka plaka)
    {
        if (!PlakaSecimeAit(plaka)) return Task.CompletedTask;
        var plakaId = plaka.Id;
        return PlakaIsleminiYurut(() => AracService.DeletePlakaFromAracAsync(plakaId), "Plaka silindi.");
    }

    private Task PlakayiKapat(AracPlaka plaka)
    {
        if (!PlakaSecimeAit(plaka)) return Task.CompletedTask;
        var plakaId = plaka.Id;
        var cikisTarihi = DateTime.Today;
        return PlakaIsleminiYurut(async () =>
        {
            await AracService.ClosePlakaAsync(plakaId, cikisTarihi);
            return true;
        }, "Plaka kapatıldı.");
    }

    private async Task PlakaIsleminiYurut(Func<Task<bool>> islem, string basariMesaji, bool formuTemizle = false)
    {
        if (disposed || !showPlakaGecmisiModal || seciliArac == null || isPlakaKaydediliyor || isLoading) return;
        var aracId = seciliArac.Id;
        var surum = System.Threading.Volatile.Read(ref plakaModalSurumu);
        var firmaId = AktifFirmaProvider.AktifFirmaId;
        var tumFirmalar = AktifFirmaProvider.TumFirmalar;
        if (tumFirmalar || !firmaId.HasValue || firmaId.Value <= 0 || seciliArac.FirmaId != firmaId)
        {
            ToastService.ShowWarning("Plaka işlemi için aracın firmasını seçin.");
            return;
        }
        isPlakaKaydediliyor = true;
        StateHasChanged();
        try
        {
            var basarili = await islem();
            if (!PlakaIslemiGuncel(surum, aracId, firmaId, tumFirmalar)) return;
            if (!basarili)
            {
                ToastService.ShowError("Plaka işlemi tamamlanamadı. Listeyi yenileyip tekrar deneyin.");
                return;
            }
            ToastService.ShowSuccess(basariMesaji);
            var yukleme = LoadData();
            var listeSurumu = System.Threading.Volatile.Read(ref listeYuklemeSurumu);
            await yukleme;
            if (!PlakaIslemiGuncel(surum, aracId, firmaId, tumFirmalar)) return;
            if (!ListeYuklemesiGuncel(listeSurumu, firmaId, tumFirmalar) || isLoading)
            {
                PlakaGecmisiKapat();
                return;
            }
            var guncelArac = tumAraclar.FirstOrDefault(a => a.Id == aracId);
            if (guncelArac == null)
            {
                PlakaGecmisiKapat();
                return;
            }
            seciliArac = guncelArac;
            plakaGecmisi = new List<AracPlaka>(guncelArac.PlakaGecmisi);
            if (formuTemizle)
            {
                yeniPlaka = new AracPlaka();
                yeniPlakaGirisTarihi = DateTime.Today;
                yeniPlakaCikisTarihi = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Plaka geçmişi işlemi başarısız. Araç: {AracId}, Firma: {FirmaId}", aracId, firmaId);
            if (PlakaIslemiGuncel(surum, aracId, firmaId, tumFirmalar))
                ToastService.ShowError("Plaka işlemi tamamlanamadı. Listeyi yenileyip tekrar deneyin.");
        }
        finally
        {
            if (PlakaIslemiGuncel(surum, aracId, firmaId, tumFirmalar))
            {
                isPlakaKaydediliyor = false;
                StateHasChanged();
            }
        }
    }

