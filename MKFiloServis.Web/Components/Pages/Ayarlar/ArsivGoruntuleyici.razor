@page "/ayarlar/arsiv-goruntuleyici"
@using MKFiloServis.Web.Helpers
@using MKFiloServis.Web.Services
@using MKFiloServis.Web.Services.Interfaces
@inject ISecureFileService SecureFileService
@inject ArchiveBrowserService ArchiveBrowser
@inject IToastService ToastService
@inject IJSRuntime JS
@inject IKullaniciService KullaniciService
@rendermode InteractiveServer

<PageTitle>Arşiv Dosya Görüntüleyici</PageTitle>

<YetkiKontrol Yetki="@MKFiloServis.Shared.Entities.Yetkiler.ArsivGoruntuleyiciOku" GerekliYetkiAdi="Arşiv Dosya Görüntüleyici">
<Yetkili>
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3><i class="bi bi-archive-fill me-2"></i>Arşiv Dosya Görüntüleyici</h3>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/ayarlar/firmalar">Ayarlar</a></li>
                    <li class="breadcrumb-item active">Arşiv Dosya Görüntüleyici</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-outline-primary" @onclick="YenileAsync" disabled="@isLoading">
            <i class="bi bi-arrow-clockwise me-1"></i>Yenile
        </button>
    </div>

    <div class="alert alert-info py-2">
        <i class="bi bi-shield-lock me-1"></i>
        Sunucudaki uygulama dizininin <code>Depo</code> ve <code>Arşiv</code> alanları ve alt dizinleri görüntülenir. Yeni dosyalar uygulama anahtarlarıyla
        korunur. Anahtarı bulunmayan eski şifreli dosyalar listelenir ancak açılamaz.
    </div>

    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small mb-1">Bilgisayar / Dizin</label>
                    <select class="form-select form-select-sm" @bind="seciliDizin" @bind:after="YenileAsync">
                        <option value="">Uygulama Dizini (Depo + Arşiv)</option>
                        <option value="Depo">Depo</option>
                        <option value="Arsiv">Arşiv</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small mb-1">Dosya Ara</label>
                    <input type="text" class="form-control form-control-sm" @bind="filtreArama" @bind:event="oninput" @bind:after="FiltreUygula"
                           placeholder="Dosya adı veya klasör..." />
                </div>
                <div class="col-md-4 text-end">
                    <span class="badge bg-secondary">@filtrelenmisDosyalar.Count / @tumDosyalar.Count dosya</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="small text-muted mb-2"><i class="bi bi-pc-display me-1"></i>Bilgisayar (sunucu) / @ArchiveBrowser.StorageRoot</div>
            <nav aria-label="Arşiv dizin yolu" class="d-flex flex-wrap align-items-center gap-1 mb-2">
                <button class="btn btn-sm btn-outline-secondary" @onclick='() => DizinSecAsync("")'>Dizin</button>
                @foreach (var yol in DizinKirimlari())
                {
                    <span class="text-muted">/</span>
                    <button class="btn btn-sm @(seciliDizin == yol.RelativePath ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => DizinSecAsync(yol.RelativePath)">@yol.Name</button>
                }
            </nav>
            @if (altDizinler.Count > 0)
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var dizin in altDizinler)
                    {
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => DizinSecAsync(dizin.RelativePath)">
                            <i class="bi bi-folder me-1"></i>@dizin.Name
                        </button>
                    }
                </div>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <div class="mt-2 text-muted">Arşiv taranıyor...</div>
        </div>
    }
    else if (!filtrelenmisDosyalar.Any())
    {
        <div class="alert alert-warning">
            <i class="bi bi-info-circle me-1"></i>Seçilen dizinde aramaya uygun dosya bulunamadı.
        </div>
    }
    else
    {
        <div class="card">
            <div class="table-responsive" style="max-height: 60vh; overflow-y: auto;">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th style="width:36px;"></th>
                            <th>Dosya Adı</th>
                            <th>Klasör</th>
                            <th>Format</th>
                            <th class="text-end">Boyut</th>
                            <th>Tarih</th>
                            <th class="text-end" style="width:200px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dosya in filtrelenmisDosyalar)
                        {
                            <tr>
                                <td><i class="bi @GetDosyaIcon(dosya.Uzanti)"></i></td>
                                <td class="text-break">@dosya.GorunenAd</td>
                                <td class="small text-muted text-break">@dosya.Klasor</td>
                                <td><span class="badge @GetFormatBadge(dosya.Format)">@GetFormatText(dosya.Format)</span></td>
                                <td class="text-end small">@FormatDosyaBoyutu(dosya.Boyut)</td>
                                <td class="small">@dosya.Tarih.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-info" title="Ön İzle"
                                            @onclick="() => OnIzlemeAc(dosya)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary" title="Yazdır"
                                            @onclick="() => Yazdir(dosya)">
                                        <i class="bi bi-printer"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-success" title="Kopyala / İndir (şifresi çözülmüş)"
                                            @onclick="() => Indir(dosya)">
                                        <i class="bi bi-download"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Ön İzleme Modalı -->
@if (showPreviewModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content" style="height: 90vh;">
                <div class="modal-header bg-primary text-white py-2">
                    <h6 class="modal-title text-truncate">
                        <i class="bi bi-eye me-2"></i>@previewFileName
                    </h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="OnIzlemeKapat"></button>
                </div>
                <div class="modal-body p-0 d-flex align-items-center justify-content-center" style="overflow:auto;">
                    @if (isPreviewLoading)
                    {
                        <div class="text-center">
                            <div class="spinner-border text-primary"></div>
                            <div class="mt-2 text-muted">Dosya şifresi çözülüyor...</div>
                        </div>
                    }
                    else if (previewError != null)
                    {
                        <div class="alert alert-warning m-3">@previewError</div>
                    }
                    else if (previewType == "pdf")
                    {
                        <iframe src="@previewDataUrl" style="width:100%; height:100%; border:none;"></iframe>
                    }
                    else if (previewType == "image")
                    {
                        <img src="@previewDataUrl" style="max-width:100%; max-height:100%;" />
                    }
                </div>
                <div class="modal-footer py-2">
                    @if (previewDosya != null)
                    {
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => Yazdir(previewDosya)">
                            <i class="bi bi-printer me-1"></i>Yazdır
                        </button>
                        <button class="btn btn-outline-success btn-sm" @onclick="() => Indir(previewDosya)">
                            <i class="bi bi-download me-1"></i>Kopyala / İndir
                        </button>
                    }
                    <button class="btn btn-secondary btn-sm" @onclick="OnIzlemeKapat">Kapat</button>
                </div>
            </div>
        </div>
    </div>
}

</Yetkili>
</YetkiKontrol>
@code {
    private sealed class ArsivDosya
    {
        public string RelativePath { get; set; } = string.Empty;
        public string GorunenAd { get; set; } = string.Empty;
        public string Klasor { get; set; } = string.Empty;
        public string Uzanti { get; set; } = string.Empty;
        public long Boyut { get; set; }
        public DateTime Tarih { get; set; }
        public ArchiveFileFormat Format { get; set; }
    }

    private List<ArsivDosya> tumDosyalar = new();
    private List<ArsivDosya> filtrelenmisDosyalar = new();
    private bool isLoading = true;

    private List<ArchiveDirectoryItem> altDizinler = new();
    private string seciliDizin = "Arsiv";
    private string filtreArama = string.Empty;

    private bool showPreviewModal = false;
    private bool isPreviewLoading = false;
    private string? previewDataUrl;
    private string previewType = string.Empty;
    private string previewFileName = string.Empty;
    private string? previewError;
    private ArsivDosya? previewDosya;

    protected override async Task OnInitializedAsync()
    {
        if (!await GoruntulemeYetkisiVarMiAsync()) return;
        await YenileAsync();
    }

    private async Task YenileAsync()
    {
        if (!await GoruntulemeYetkisiVarMiAsync()) return;
        isLoading = true;
        StateHasChanged();
        try
        {
            altDizinler = ArchiveBrowser.GetDirectories(seciliDizin).ToList();
            tumDosyalar = await Task.Run(() => ArchiveBrowser.GetFiles(seciliDizin)
                .Select(d => new ArsivDosya
                {
                    RelativePath = d.StorageRelativePath,
                    GorunenAd = d.DisplayName,
                    Klasor = d.Directory,
                    Uzanti = d.Extension,
                    Boyut = d.Size,
                    Tarih = d.ModifiedAt,
                    Format = d.Format
                })
                .ToList());
            FiltreUygula();
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Arşiv taranamadı: " + ex.Message);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task DizinSecAsync(string relativePath)
    {
        seciliDizin = relativePath;
        await YenileAsync();
    }

    private IEnumerable<ArchiveDirectoryItem> DizinKirimlari()
    {
        var yol = string.Empty;
        foreach (var parca in seciliDizin.Split('/', StringSplitOptions.RemoveEmptyEntries))
        {
            yol = string.IsNullOrEmpty(yol) ? parca : $"{yol}/{parca}";
            yield return new ArchiveDirectoryItem(parca, yol);
        }
    }

    private void FiltreUygula()
    {
        IEnumerable<ArsivDosya> liste = tumDosyalar;

        if (!string.IsNullOrWhiteSpace(filtreArama))
        {
            var arama = filtreArama.Trim().Trim('"').Replace('\\', '/');
            var storageRoot = ArchiveBrowser.StorageRoot.Replace('\\', '/').TrimEnd('/');
            if (arama.StartsWith(storageRoot + "/", StringComparison.OrdinalIgnoreCase))
                arama = arama[(storageRoot.Length + 1)..];
            liste = liste.Where(d =>
                d.GorunenAd.Contains(arama, StringComparison.OrdinalIgnoreCase) ||
                d.Klasor.Contains(arama, StringComparison.OrdinalIgnoreCase) ||
                d.RelativePath.Contains(arama, StringComparison.OrdinalIgnoreCase));
        }

        filtrelenmisDosyalar = liste.ToList();
        StateHasChanged();
    }

    private async Task<byte[]?> DosyaCoz(ArsivDosya dosya)
    {
        if (!await GoruntulemeYetkisiVarMiAsync()) return null;
        ArchiveBrowser.ValidateStorageRelativePath(dosya.RelativePath);
        if (dosya.Format == ArchiveFileFormat.Plain)
            return await File.ReadAllBytesAsync(ArchiveBrowser.ValidateStorageRelativePath(dosya.RelativePath));

        var bytes = await SecureFileService.ReadDecryptedAsync(dosya.RelativePath);
        if (bytes == null || bytes.Length == 0)
        {
            ToastService.ShowWarning(dosya.Format is ArchiveFileFormat.LegacyAes or ArchiveFileFormat.LegacyEncrypted
                ? "Eski şifreli dosya açılamadı. Orijinal anahtar gereklidir."
                : "Dosya okunamadı veya uygulama anahtarı bulunamadı.");
            return null;
        }
        return bytes;
    }

    private async Task<bool> GoruntulemeYetkisiVarMiAsync()
    {
        var aktif = await KullaniciService.GetAktifKullaniciAsync();
        return aktif is not null && await KullaniciService.YetkiVarMiAsync(aktif.Id, MKFiloServis.Shared.Entities.Yetkiler.ArsivGoruntuleyiciOku);
    }

    private async Task OnIzlemeAc(ArsivDosya dosya)
    {
        showPreviewModal = true;
        isPreviewLoading = true;
        previewDataUrl = null;
        previewType = string.Empty;
        previewError = null;
        previewFileName = dosya.GorunenAd;
        previewDosya = dosya;
        StateHasChanged();

        try
        {
            var bytes = await DosyaCoz(dosya);
            if (bytes == null || bytes.Length == 0)
            {
                previewError = dosya.Format is ArchiveFileFormat.LegacyAes or ArchiveFileFormat.LegacyEncrypted
                    ? "Bu eski şifreli dosyayı açmak için orijinal anahtar gereklidir."
                    : "Dosya okunamadı veya uygulama anahtarı bulunamadı.";
                return;
            }

            var mime = GetMimeType(dosya.Uzanti.TrimStart('.'));

            if (dosya.Uzanti == ".pdf")
            {
                previewType = "pdf";
                previewDataUrl = $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
            }
            else if (dosya.Uzanti is ".jpg" or ".jpeg" or ".png" or ".gif" or ".bmp" or ".webp")
            {
                previewType = "image";
                previewDataUrl = $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
            }
            else
            {
                previewError = $"Bu dosya türü ({dosya.Uzanti}) için ön izleme desteklenmiyor. Dosyayı indirip görüntüleyebilirsiniz.";
            }
        }
        catch (Exception ex)
        {
            previewError = "Ön izleme yüklenemedi: " + ex.Message;
        }
        finally
        {
            isPreviewLoading = false;
            StateHasChanged();
        }
    }

    private void OnIzlemeKapat()
    {
        showPreviewModal = false;
        previewDataUrl = null;
        previewType = string.Empty;
        previewFileName = string.Empty;
        previewError = null;
        previewDosya = null;
    }

    private async Task Yazdir(ArsivDosya dosya)
    {
        try
        {
            var bytes = await DosyaCoz(dosya);
            if (bytes == null) return;

            if (dosya.Uzanti == ".pdf" || dosya.Uzanti is ".jpg" or ".jpeg" or ".png" or ".gif" or ".bmp" or ".webp")
            {
                var mime = GetMimeType(dosya.Uzanti.TrimStart('.'));
                await JS.InvokeVoidAsync("printBase64File", Convert.ToBase64String(bytes), mime);
            }
            else
            {
                ToastService.ShowWarning($"Bu dosya türü ({dosya.Uzanti}) için yazdırma desteklenmiyor. Dosyayı indirip yazdırabilirsiniz.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Yazdırma hatası: " + ex.Message);
        }
    }

    private async Task Indir(ArsivDosya dosya)
    {
        try
        {
            var bytes = await DosyaCoz(dosya);
            if (bytes == null) return;

            var mime = GetMimeType(dosya.Uzanti.TrimStart('.'));
            await JS.InvokeVoidAsync("downloadFileFromBase64", dosya.GorunenAd, Convert.ToBase64String(bytes), mime);
            ToastService.ShowSuccess("Dosya şifresi çözülerek indirildi.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError("İndirme hatası: " + ex.Message);
        }
    }

    private static string GetFormatText(ArchiveFileFormat format) => format switch
    {
        ArchiveFileFormat.DataProtection => "Yeni / Korumalı",
        ArchiveFileFormat.LegacyAes => "Eski / AES",
        ArchiveFileFormat.LegacyEncrypted => "Eski / Şifreli",
        _ => "Düz Dosya"
    };

    private static string GetFormatBadge(ArchiveFileFormat format) => format switch
    {
        ArchiveFileFormat.DataProtection => "bg-success",
        ArchiveFileFormat.LegacyAes => "bg-warning text-dark",
        ArchiveFileFormat.LegacyEncrypted => "bg-danger",
        _ => "bg-secondary"
    };

    private static string GetMimeType(string? extension)
    {
        return extension?.ToLowerInvariant() switch
        {
            "pdf" => "application/pdf",
            "jpg" or "jpeg" => "image/jpeg",
            "png" => "image/png",
            "gif" => "image/gif",
            "bmp" => "image/bmp",
            "webp" => "image/webp",
            "doc" => "application/msword",
            "docx" => "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "xls" => "application/vnd.ms-excel",
            "xlsx" => "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            "txt" => "text/plain",
            "csv" => "text/csv",
            "zip" => "application/zip",
            _ => "application/octet-stream"
        };
    }

    private static string GetDosyaIcon(string uzanti) => uzanti switch
    {
        ".pdf" => "bi-file-earmark-pdf text-danger",
        ".jpg" or ".jpeg" or ".png" or ".gif" or ".bmp" or ".webp" => "bi-file-earmark-image text-primary",
        ".doc" or ".docx" => "bi-file-earmark-word text-primary",
        ".xls" or ".xlsx" => "bi-file-earmark-excel text-success",
        _ => "bi-file-earmark"
    };

    private static string FormatDosyaBoyutu(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024} KB";
        return $"{bytes / 1024.0 / 1024.0:N1} MB";
    }
}
