@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Licensed:ebys")]
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@page "/ayarlar/dosya-migrasyonu"
@using MKFiloServis.Web.Services
@inject DosyaMigrasyonService MigrasyonService
@inject IToastService ToastService
@rendermode InteractiveServer

<PageTitle>Dosya Şifreleme Migrasyonu</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3><i class="bi bi-shield-lock me-2"></i>Dosya Şifreleme Migrasyonu</h3>
            <p class="text-muted mb-0">EBYS, araç, personel özlük, fatura ve eski e-Fatura/Luca webroot dosyaları dahil cari bağı doğrulanan tedarikçi/destek ve ortak evrak dosyalarını şifreli depoya taşır. EBYS firma bağı olmayan yönetici genel kapsamındadır; diğer modüller seçili firmayla sınırlandırılır. Silinmiş dosyalar ve sürüm geçmişi geri alma için taşınır. Eski düz dosyalar otomatik silinmez; geri alma için yerinde korunur.</p>
        </div>
        <button class="btn btn-outline-secondary" @onclick="OnizlemeYukleAsync" disabled="@calisıyor">
            <i class="bi bi-search me-1"></i>Tara
        </button>
    </div>

    @if (ozet == null && !calisıyor)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            Bekleyen dosyaları görmek için <strong>Tara</strong> düğmesine tıklayın.
        </div>
    }

    @if (ozet != null)
    {
        <div class="row mb-4">
            <div class="col-md-4 col-xl-3 mb-2"><div class="card border-warning h-100"><div class="card-body">
                <h6 class="card-title">EBYS <span class="badge bg-warning text-dark">@(ozet.EbysAnaCount + ozet.SilinmisEbysAnaCount + ozet.EbysVersiyonCount + ozet.SilinmisEbysVersiyonCount)</span></h6>
                <div class="small">Ana dosya: <strong>@ozet.EbysAnaCount aktif</strong> / @ozet.SilinmisEbysAnaCount silinmiş</div>
                <div class="small">Sürümler: <strong>@ozet.EbysVersiyonCount aktif</strong> / @ozet.SilinmisEbysVersiyonCount silinmiş</div>
            </div></div></div>
            <div class="col-md-4 col-xl-3 mb-2"><div class="card border-info h-100"><div class="card-body">
                <h6 class="card-title">Araç belgeleri <span class="badge bg-info text-dark">@(ozet.AracEvrakCount + ozet.SilinmisAracEvrakCount + ozet.AracVersiyonCount + ozet.SilinmisAracVersiyonCount)</span></h6>
                <div class="small">Ana dosya: <strong>@ozet.AracEvrakCount aktif</strong> / @ozet.SilinmisAracEvrakCount silinmiş</div>
                <div class="small">Sürümler: <strong>@ozet.AracVersiyonCount aktif</strong> / @ozet.SilinmisAracVersiyonCount silinmiş</div>
            </div></div></div>
            <div class="col-md-4 col-xl-3 mb-2"><div class="card border-primary h-100"><div class="card-body">
                <h6 class="card-title">Personel özlük <span class="badge bg-primary">@(ozet.PersonelEvrakCount + ozet.SilinmisPersonelEvrakCount + ozet.PersonelVersiyonCount + ozet.SilinmisPersonelVersiyonCount)</span></h6>
                <div class="small">Ana dosya: <strong>@ozet.PersonelEvrakCount aktif</strong> / @ozet.SilinmisPersonelEvrakCount silinmiş</div>
                <div class="small">Sürümler: <strong>@ozet.PersonelVersiyonCount aktif</strong> / @ozet.SilinmisPersonelVersiyonCount silinmiş</div>
            </div></div></div>
            <div class="col-md-4 col-xl-3 mb-2"><div class="card border-success h-100"><div class="card-body">
                <h6 class="card-title">Fatura dosyaları <span class="badge bg-success">@(ozet.FaturaPdfCount + ozet.SilinmisFaturaPdfCount + ozet.FaturaXmlCount + ozet.SilinmisFaturaXmlCount)</span></h6>
                <div class="small">PDF: <strong>@ozet.FaturaPdfCount aktif</strong> / @ozet.SilinmisFaturaPdfCount silinmiş</div>
                <div class="small">XML: <strong>@ozet.FaturaXmlCount aktif</strong> / @ozet.SilinmisFaturaXmlCount silinmiş</div>
            </div></div></div>
            <div class="col-md-4 col-xl-3 mb-2"><div class="card border-secondary h-100"><div class="card-body">
                <h6 class="card-title">Ortak evrak <span class="badge bg-secondary">@(ozet.OrtakEvrakCount + ozet.SilinmisOrtakEvrakCount)</span></h6>
                <div class="small"><strong>@ozet.OrtakEvrakCount aktif</strong> / @ozet.SilinmisOrtakEvrakCount silinmiş</div>
            </div></div></div>
            <div class="col-md-4 col-xl-3 mb-2"><div class="card border-warning h-100"><div class="card-body">
                <h6 class="card-title">Tedarikçi ekleri <span class="badge bg-warning text-dark">@(ozet.TedarikciDosyaCount + ozet.SilinmisTedarikciDosyaCount)</span></h6>
                <div class="small">Cari-firma bağı doğrulanan ortak kök dosyaları</div>
                <div class="small"><strong>@ozet.TedarikciDosyaCount aktif</strong> / @ozet.SilinmisTedarikciDosyaCount silinmiş</div>
            </div></div></div>
            <div class="col-md-4 col-xl-3 mb-2"><div class="card border-danger h-100"><div class="card-body">
                <h6 class="card-title">Destek ekleri <span class="badge bg-danger">@(ozet.DestekEkiCount + ozet.SilinmisDestekEkiCount)</span></h6>
                <div class="small">Cari-firma bağı ve <code>uploads/destek</code> yolu doğrulananlar</div>
                <div class="small"><strong>@ozet.DestekEkiCount aktif</strong> / @ozet.SilinmisDestekEkiCount silinmiş</div>
            </div></div></div>
            <div class="col-md-4 col-xl-3 mb-2"><div class="card border-dark h-100"><div class="card-body text-center">
                <div class="fs-2 fw-bold">@ozet.Toplam</div><div class="text-muted small">Toplam bekleyen kayıt</div>
            </div></div></div>
            <div class="col-12 mt-2 d-flex justify-content-end">
                @if (ozet.Toplam == 0)
                {
                    <div class="alert alert-success mb-0">
                        <i class="bi bi-check-circle me-1"></i>Bu kapsamda geçiş bekleyen kayıt yok.
                    </div>
                }
                else
                {
                    <button class="btn btn-danger" @onclick="MigrasyonBaslatAsync" disabled="@calisıyor">
                        <i class="bi bi-play-fill me-1"></i>Migrasyonu Başlat
                    </button>
                }
            </div>
        </div>
    }

    @if (calisıyor)
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span><i class="bi bi-hourglass-split me-1"></i>Migrasyon çalışıyor...</span>
                    <span class="text-muted">@tamamlanan / @toplamAdim</span>
                </div>
                <div class="progress" style="height:8px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated"
                         style="width: @(toplamAdim > 0 ? (tamamlanan * 100 / toplamAdim) : 0)%"></div>
                </div>
            </div>
        </div>
    }

    @if (adimlar.Count > 0)
    {
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="mb-0">Sonuçlar</h6>
            <div>
                <span class="badge bg-success me-1">@adimlar.Count(a => a.Durum == MigrasyonDurum.Basarili) başarılı</span>
                <span class="badge bg-warning text-dark me-1">@adimlar.Count(a => a.Durum == MigrasyonDurum.TemizlikBekliyor) eski dosya doğrulaması bekliyor</span>
                <span class="badge bg-secondary me-1">@adimlar.Count(a => a.Durum == MigrasyonDurum.Atildi) atlandı</span>
                <span class="badge bg-danger">@adimlar.Count(a => a.Durum == MigrasyonDurum.Hata) hata</span>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Dosya</th>
                        <th>Eski Yol</th>
                        <th>Durum</th>
                        <th>Mesaj</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in adimlar.AsEnumerable().Reverse())
                    {
                        <tr>
                            <td class="text-truncate" style="max-width:150px;" title="@a.DosyaAdi">@a.DosyaAdi</td>
                            <td class="text-truncate text-muted small" style="max-width:200px;" title="@a.EskiYol">@a.EskiYol</td>
                            <td>
                                @switch (a.Durum)
                                {
                                    case MigrasyonDurum.Basarili:
                                        <span class="badge bg-success"><i class="bi bi-check"></i> Taşındı</span>
                                        break;
                                    case MigrasyonDurum.Atildi:
                                        <span class="badge bg-secondary"><i class="bi bi-skip-forward"></i> Atlandı</span>
                                        break;
                                    case MigrasyonDurum.Hata:
                                        <span class="badge bg-danger"><i class="bi bi-x"></i> Hata</span>
                                        break;
                                    case MigrasyonDurum.TemizlikBekliyor:
                                        <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle"></i> Temizlik Bekliyor</span>
                                        break;
                                }
                            </td>
                            <td class="small text-muted">@a.Mesaj</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private DosyaMigrasyonOzet? ozet;
    private List<DosyaMigrasyonAdim> adimlar = new();
    private bool calisıyor;
    private int tamamlanan;
    private int toplamAdim;
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        await OnizlemeYukleAsync();
    }

    private async Task OnizlemeYukleAsync()
    {
        calisıyor = true;
        try
        {
            ozet = await MigrasyonService.OnizlemeAsync();
        }
        catch (Exception ex)
        {
            ozet = null;
            ToastService.ShowWarning(ex.Message);
        }
        finally
        {
            calisıyor = false;
        }
    }

    private async Task MigrasyonBaslatAsync()
    {
        if (calisıyor) return;
        adimlar.Clear();
        tamamlanan = 0;
        toplamAdim = ozet?.Toplam ?? 0;
        calisıyor = true;
        _cts = new CancellationTokenSource();

        try
        {
            await foreach (var adim in MigrasyonService.MigrateAsync(_cts.Token))
            {
                adimlar.Add(adim);
                tamamlanan++;
                StateHasChanged();
                await Task.Delay(10); // UI'ın nefes alması için
            }

            var basarili = adimlar.Count(a => a.Durum == MigrasyonDurum.Basarili);
            var temizlikBekliyor = adimlar.Count(a => a.Durum == MigrasyonDurum.TemizlikBekliyor);
            var hata = adimlar.Count(a => a.Durum == MigrasyonDurum.Hata);

            if (hata == 0 && temizlikBekliyor == 0)
                ToastService.ShowSuccess($"Migrasyon tamamlandı: {basarili} dosya şifrelendi.");
            else
                ToastService.ShowWarning($"Tamamlandı: {basarili} başarılı, {temizlikBekliyor} eski dosya doğrulaması bekliyor, {hata} hata.");

            ozet = await MigrasyonService.OnizlemeAsync();
        }
        catch (OperationCanceledException)
        {
            ToastService.ShowInfo("Migrasyon iptal edildi.");
        }
        catch (Exception ex)
        {
            ToastService.ShowWarning($"Migrasyon durdu: {ex.Message}");
        }
        finally
        {
            calisıyor = false;
        }
    }

    public void Dispose() => _cts?.Cancel();
}

