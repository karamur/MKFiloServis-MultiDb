@page "/operasyonel-hakedis"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using MKFiloServis.Shared.Entities
@using MKFiloServis.Web.Services.Interfaces
@using MKFiloServis.Web.Services
@using MKFiloServis.Web.Models
@using Microsoft.JSInterop
@inject IOperasyonelHakedisService HakedisService
@inject IFirmaService FirmaService
@inject ITasimaTedarikciService TedarikciService
@inject IAracService AracService
@inject ICariService CariService
@inject IFiloKomisyonService FiloKomisyonService
@inject IPdfService PdfService
@inject IJSRuntime JS
@inject IAktifFirmaProvider AktifFirmaProvider
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Operasyonel Hakediş</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3><i class="bi bi-receipt-cutoff me-2"></i>Operasyonel Hakediş</h3>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-success" @onclick="ExceleAktarAsync" disabled="@(isBusy || !hakedisler.Any())">
                <i class="bi bi-file-earmark-excel me-1"></i>Excel'e Aktar
            </button>
            <button class="btn btn-success" @onclick="DetayliRaporuExceleAktarAsync" disabled="@(isBusy || !FiltreliRaporSatirlari.Any())">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i>Detaylı Rapor
            </button>
            <button class="btn btn-outline-danger" @onclick="DetayliRaporuPdfAktarAsync" disabled="@(isBusy || !FiltreliRaporSatirlari.Any())">
                <i class="bi bi-file-earmark-pdf me-1"></i>PDF
            </button>
            <button class="btn btn-outline-secondary" @onclick="YukleAsync" disabled="@isBusy">
                <i class="bi bi-arrow-clockwise me-1"></i>Yenile
            </button>
            <button class="btn btn-primary" @onclick="TopluUretAsync" disabled="@isBusy" title="Taslak hakedişleri güncel puantaj verilerinden yeniden üretir">
                <i class="bi bi-arrow-repeat me-1"></i>Güncelle
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(hataMesaji))
    {
        <div class="alert alert-danger">@hataMesaji</div>
    }

    @if (!string.IsNullOrWhiteSpace(bilgiMesaji))
    {
        <div class="alert alert-success">@bilgiMesaji</div>
    }

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label small mb-1">Yıl</label>
                    <InputNumber class="form-control" @bind-Value="yil" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1">Ay</label>
                    <InputNumber class="form-control" @bind-Value="ay" min="1" max="12" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1">Tip</label>
                    <InputSelect class="form-select" @bind-Value="seciliTip">
                        <option value="@HakedisTipi.Kurum">Kurum</option>
                        <option value="@HakedisTipi.Tedarikci">Tedarikçi</option>
                        <option value="@HakedisTipi.Arac">Araç</option>
                    </InputSelect>
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1">Gruplama</label>
                    <select class="form-select form-select-sm" @bind="selectedGrouping">
                        <option value="cari">Cari</option>
                        <option value="referans">Referans</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2 justify-content-end">
                    <button class="btn btn-primary" @onclick="TopluUretAsync" disabled="@isBusy">
                        <i class="bi bi-magic me-1"></i>Toplu Hakediş Üret
                    </button>
                    <button class="btn btn-outline-primary" @onclick="YukleAsync" disabled="@isBusy">
                        <i class="bi bi-list-ul me-1"></i>Listele
                    </button>
                </div>
            </div>
            <div class="row g-2 align-items-end mt-1">
                <div class="col-md-3">
                    <label class="form-label small mb-1">Durum</label>
                    <select class="form-select form-select-sm" @bind="durumFiltre">
                        <option value="">Tümü</option>
                        @foreach (var d in Enum.GetValues<HakedisDurum>())
                        {
                            <option value="@d">@d</option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label small mb-1">Arama (referans / güzergah)</label>
                    <input class="form-control form-control-sm" placeholder="Kelime yazın..." @bind="aramaMetni" @bind:event="oninput" />
                </div>
                <div class="col-md-4 d-flex justify-content-end">
                    @if (!string.IsNullOrWhiteSpace(aramaMetni) || !string.IsNullOrWhiteSpace(durumFiltre))
                    {
                        <button class="btn btn-sm btn-outline-secondary" @onclick="FiltreleriTemizle">
                            <i class="bi bi-x-lg me-1"></i>Filtreleri Temizle
                        </button>
                    }
                </div>
            </div>
            @if (seciliTip == HakedisTipi.Kurum)
            {
                <div class="row g-2 align-items-end mt-1">
                    <div class="col-md-4">
                        <label class="form-label small mb-1">Firmalar</label>
                        <select class="form-select form-select-sm" multiple size="3" @onchange="KurumFiltresiDegisti">
                            @foreach (var kurum in KurumFiltreSecenekleri)
                            {
                                <option value="@kurum.Id">@kurum.Ad</option>
                            }
                        </select>
                        <div class="form-text">Boş bırakılırsa tüm firmalar alınır.</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small mb-1">Güzergâh</label>
                        <select class="form-select form-select-sm" @bind="seciliGuzergahId">
                            <option value="0">Tüm güzergâhlar</option>
                            @foreach (var guzergah in GuzergahFiltreSecenekleri)
                            {
                                <option value="@guzergah.Id">@guzergah.Ad</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4 small text-muted">
                        <i class="bi bi-info-circle me-1"></i>Detaylı rapor; firma, güzergâh, plaka, şoför, sefer ve kesilecek fatura tutarını içerir.
                    </div>
                    <div class="col-md-4 form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox" id="firmalariGrupla" @bind="firmalariGrupla" />
                        <label class="form-check-label" for="firmalariGrupla">Firmaları grupla ve ara toplamları göster</label>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (seciliTip == HakedisTipi.Kurum && FiltreliRaporSatirlari.Any())
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <div>
                    <strong>Firma / Güzergâh Detay Raporu</strong>
                    <div class="small text-muted">Rapor dönemi: @ay.ToString("D2")/@yil</div>
                </div>
                <span class="small text-muted">@FiltreliRaporSatirlari.Count satır</span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-striped table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Firma</th>
                            <th>Güzergâh</th>
                            <th>Plaka</th>
                            <th>Şoför</th>
                            <th class="text-end">Sefer</th>
                            <th class="text-end">Birim Fiyat</th>
                            <th class="text-end">Kesilecek Fatura</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var grup in DetayRaporGruplari)
                        {
                            @if (firmalariGrupla)
                            {
                                <tr class="table-primary"><td colspan="7" class="fw-bold">FİRMA: @grup.Key</td></tr>
                            }
                            @foreach (var satir in grup)
                            {
                                <tr>
                                    <td>@satir.Firma</td>
                                    <td>@satir.Guzergah</td>
                                    <td>@satir.Plaka</td>
                                    <td>@satir.Sofor</td>
                                    <td class="text-end">@satir.SeferSayisi.ToString("N2")</td>
                                    <td class="text-end">@satir.BirimFiyat.ToString("N2") ₺</td>
                                    <td class="text-end fw-semibold">@satir.FaturaTutari.ToString("N2") ₺</td>
                                </tr>
                            }
                            @if (firmalariGrupla)
                            {
                                <tr class="table-light fw-bold">
                                    <td colspan="4">@grup.Key Ara Toplam</td>
                                    <td class="text-end">@grup.Sum(x => x.SeferSayisi).ToString("N2")</td>
                                    <td></td>
                                    <td class="text-end">@grup.Sum(x => x.FaturaTutari).ToString("N2") ₺</td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="4">GENEL TOPLAM</td>
                            <td class="text-end">@FiltreliRaporSatirlari.Sum(x => x.SeferSayisi).ToString("N2")</td>
                            <td></td>
                            <td class="text-end">@FiltreliRaporSatirlari.Sum(x => x.FaturaTutari).ToString("N2") ₺</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }

    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <div class="card border-0 bg-primary text-white shadow-sm">
                <div class="card-body py-2">
                    <div class="small opacity-75">Toplam</div>
                    <div class="fs-4 fw-bold">@hakedisler.Count</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-success text-white shadow-sm">
                <div class="card-body py-2">
                    <div class="small opacity-75">Taslak</div>
                    <div class="fs-4 fw-bold">@hakedisler.Count(x => x.Durum == HakedisDurum.Taslak)</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-warning text-dark shadow-sm">
                <div class="card-body py-2">
                    <div class="small">Onaylı</div>
                    <div class="fs-4 fw-bold">@hakedisler.Count(x => x.Durum == HakedisDurum.Onaylandi)</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-secondary text-white shadow-sm">
                <div class="card-body py-2">
                    <div class="small opacity-75">Faturalı</div>
                    <div class="fs-4 fw-bold">@hakedisler.Count(x => x.Durum == HakedisDurum.Faturalandi)</div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 border-start border-success border-4 shadow-sm">
                <div class="card-body py-2">
                    <div class="small text-success fw-semibold">Sefer × Gelir Genel Toplam</div>
                    <div class="fs-4 fw-bold text-success">@ToplamSeferGelir.ToString("N2") ₺</div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 border-start border-danger border-4 shadow-sm">
                <div class="card-body py-2">
                    <div class="small text-danger fw-semibold">Sefer × Gider Genel Toplam</div>
                    <div class="fs-4 fw-bold text-danger">@ToplamSeferGider.ToString("N2") ₺</div>
                </div>
            </div>
        </div>

        @if (puantajDonemOzeti is not null)
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm @(MutabakatSorunuVar ? "border-start border-4 border-warning" : "border-start border-4 border-success")">
                    <div class="card-body py-2">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-1">
                            <div class="fw-semibold">Tek Paket Mutabakat Özeti (Puantaj ↔ Hakediş)</div>
                            @if (MutabakatSorunuVar)
                            {
                                <span class="badge bg-warning text-dark">Fark Var</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Uyumlu</span>
                            }
                        </div>
                        <div class="row g-2 small">
                            <div class="col-md-4">
                                <div>Puantaj Sefer: <strong>@puantajDonemOzeti.ToplamSefer.ToString("N2")</strong></div>
                                <div>Hakediş Sefer: <strong>@HakedisToplamSefer.ToString("N2")</strong></div>
                                <div>Fark: <strong class="@(Math.Abs(SeferFarki) > 0.01m ? "text-warning" : "text-success")">@SeferFarki.ToString("N2")</strong></div>
                            </div>
                            <div class="col-md-4">
                                <div>Puantaj Gelir: <strong>@puantajDonemOzeti.ToplamGelir.ToString("N2") ₺</strong></div>
                                <div>Hakediş Gelir: <strong>@HakedisToplamGelir.ToString("N2") ₺</strong></div>
                                <div>Fark: <strong class="@(Math.Abs(GelirFarki) > 0.01m ? "text-warning" : "text-success")">@GelirFarki.ToString("N2") ₺</strong></div>
                            </div>
                            <div class="col-md-4">
                                <div>Puantaj Gider: <strong>@puantajDonemOzeti.ToplamGider.ToString("N2") ₺</strong></div>
                                <div>Hakediş Gider: <strong>@HakedisToplamGider.ToString("N2") ₺</strong></div>
                                <div>Fark: <strong class="@(Math.Abs(GiderFarki) > 0.01m ? "text-warning" : "text-success")">@GiderFarki.ToString("N2") ₺</strong></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (isBusy)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <strong>@yil/@ay Dönemi - @GetTipText(seciliTip) Hakedişleri</strong>
                <small class="text-muted">Seçilen satırlar için toplu işlem yapılabilir.</small>
            </div>
            <div class="card-body border-bottom">
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="TumunuSecKaldir" disabled="@isBusy || !hakedisler.Any()">
                        <i class="bi bi-check2-square me-1"></i>
                        @(TumSeciliMi ? "Seçimi Temizle" : "Tümünü Seç")
                    </button>
                    <button class="btn btn-sm btn-outline-success" @onclick="TopluOnaylaSecilenAsync" disabled="@isBusy || !SeciliTaslakIdler.Any()">
                        <i class="bi bi-check2-circle me-1"></i>Toplu Onayla (@SeciliTaslakIdler.Count)
                    </button>
                    <button class="btn btn-sm btn-outline-primary" @onclick="TopluFaturalaSecilenAsync" disabled="@isBusy || !SeciliFaturalanabilirIdler.Any()">
                        <i class="bi bi-receipt me-1"></i>Toplu Faturala (@SeciliFaturalanabilirIdler.Count)
                    </button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="TopluSilSecilenAsync" disabled="@isBusy || !SeciliSilinebilirIdler.Any()">
                        <i class="bi bi-trash me-1"></i>Toplu Sil (@SeciliSilinebilirIdler.Count)
                    </button>
                    <span class="text-muted small ms-auto">Seçili: <strong>@seciliHakedisIds.Count</strong></span>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:40px">
                                    <input type="checkbox" class="form-check-input" checked="@TumSeciliMi" @onchange="_ => TumunuSecKaldir()" disabled="@isBusy || !hakedisler.Any()" />
                                </th>
                                <th>#</th>
                                <th>Tip</th>
                                <th>Referans</th>
                                <th>Güzergah</th>
                                <th class="text-end">Toplam Sefer</th>
                                <th class="text-end">Tutar</th>
                                <th class="text-end">KDV</th>
                                <th class="text-end">Genel Toplam</th>
                                <th>Durum</th>
                                <th class="text-end">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!FiltreliHakedisler.Any())
                            {
                                <tr><td colspan="11" class="text-center text-muted p-4">Kayıt bulunamadı</td></tr>
                            }
                            else
                            {
                                @foreach (var group in GetGroupedData())
                                {
                                    var isExpanded = expandedGroups.ContainsKey(group.Key) && expandedGroups[group.Key];
                                    <tr style="background-color: #f8f9fa; cursor: pointer;" @onclick="() => ToggleGroup(group.Key)">
                                        <td colspan="11">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi @(isExpanded ? "bi-chevron-down" : "bi-chevron-right")"></i>
                                                <strong>@group.Key</strong>
                                                <span class="badge bg-secondary">@group.Value.Count</span>
                                                <span class="text-muted small ms-auto">
                                                    Toplam: @group.Value.Sum(x => x.GenelToplam).ToString("N2") ₺
                                                </span>
                                            </div>
                                        </td>
                                    </tr>

                                    @if (isExpanded)
                                    {
                                        @foreach (var h in group.Value.OrderByDescending(x => x.Id))
                                        {
                                            <tr>
                                                <td>
                                                    <input type="checkbox" class="form-check-input" checked="@seciliHakedisIds.Contains(h.Id)" @onchange="_ => SecimiDegistir(h.Id)" disabled="@isBusy" />
                                                </td>
                                                <td>@h.Id</td>
                                                <td><span class="badge @GetTipBadge(h.Tip)">@GetTipText(h.Tip)</span></td>
                                                <td title="@GetCariTooltip(h)">@GetReferansAd(h)</td>
                                                <td class="small">
                                                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" @onclick="() => ToggleHakedisDetay(h.Id)" @onclick:stopPropagation="true">
                                                        <i class="bi @(acikHakedisDetaylari.Contains(h.Id) ? "bi-chevron-down" : "bi-chevron-right") me-1"></i>@GetGuzergahOzet(h, kisalt: true)
                                                    </button>
                                                    @if (acikHakedisDetaylari.Contains(h.Id))
                                                    {
                                                        <div class="mt-1 ps-3 border-start">
                                                            @foreach (var d in GetGuzergahDetaylari(h))
                                                            {
                                                                <div class="mb-1">
                                                                    <div class="fw-semibold">@d.Ad</div>
                                                                    <div class="d-flex flex-wrap gap-3 small">
                                                                        <span class="text-success">Gelir: @d.Sefer.ToString("N2") sefer × @d.GelirBirim.ToString("N2") = @d.GelirToplam.ToString("N2") ₺</span>
                                                                        <span class="text-danger">Gider: @d.Sefer.ToString("N2") sefer × @d.GiderBirim.ToString("N2") = @d.GiderToplam.ToString("N2") ₺</span>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </td>
                                                <td class="text-end">@h.ToplamSeferSayisi.ToString("N2")</td>
                                                <td class="text-end">@h.Tutar.ToString("N2")</td>
                                                <td class="text-end">@h.KdvTutar.ToString("N2")</td>
                                                <td class="text-end fw-semibold">@h.GenelToplam.ToString("N2")</td>
                                                <td><span class="badge @GetDurumBadge(h.Durum)">@h.Durum</span></td>
                                                <td class="text-end" style="white-space:nowrap">
                                                    <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => PdfIndirAsync(h.Id)" disabled="@isBusy" title="PDF indir">
                                                        <i class="bi bi-filetype-pdf"></i>
                                                    </button>
                                                    @if (h.Durum == HakedisDurum.Taslak)
                                                    {
                                                        <button class="btn btn-sm btn-outline-success me-1" @onclick="() => OnaylaAsync(h.Id)" disabled="@isBusy">
                                                            <i class="bi bi-check2-circle"></i>
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => SilAsync(h.Id)" disabled="@isBusy">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    }
                                                    else if (h.Durum == HakedisDurum.Onaylandi)
                                                    {
                                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => FaturalaAsync(h.Id)" disabled="@isBusy || h.Tip == HakedisTipi.Arac">
                                                            <i class="bi bi-receipt"></i>
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-warning" @onclick="() => IptalAsync(h.Id)" disabled="@isBusy">
                                                            <i class="bi bi-x-circle"></i>
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }

                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isBusy;
    private string? hataMesaji;
    private string? bilgiMesaji;

    private int yil = DateTime.Today.Year;
    private int ay = DateTime.Today.Month;
    private HakedisTipi seciliTip = HakedisTipi.Kurum;

    private string _selectedGrouping = "cari";
    private string selectedGrouping
    {
        get => _selectedGrouping;
        set
        {
            if (_selectedGrouping != value)
            {
                _selectedGrouping = value;
                expandedGroups.Clear();
            }
        }
    }

    private Dictionary<string, bool> expandedGroups = new();

    private readonly Dictionary<int, string> kurumAdlari = new();
    private readonly Dictionary<int, string> tedarikciAdlari = new();
    private readonly Dictionary<int, string> aracAdlari = new();
    private readonly Dictionary<int, string> aracSahibiAdlari = new();
    private readonly Dictionary<int, Cari> cariDetaylari = new();
    private readonly HashSet<int> seciliHakedisIds = new();

    private List<Hakedis> hakedisler = new();
    private PuantajDonemOzetDto? puantajDonemOzeti;
    private List<int> seciliKurumIdleri = new();
    private int seciliGuzergahId;
    private bool firmalariGrupla = true;

    private string durumFiltre = "";
    private string aramaMetni = "";

    private IEnumerable<(int Id, string Ad)> KurumFiltreSecenekleri => hakedisler
        .Where(h => h.Tip == HakedisTipi.Kurum)
        .Select(h => (h.ReferansId, GetReferansAd(h)))
        .DistinctBy(x => x.ReferansId)
        .OrderBy(x => x.Item2)
        .Select(x => (x.ReferansId, x.Item2));

    private IEnumerable<(int Id, string Ad)> GuzergahFiltreSecenekleri => hakedisler
        .Where(h => h.Tip == HakedisTipi.Kurum)
        .SelectMany(h => h.Detaylar)
        .Where(d => d.GuzergahId.HasValue)
        .Select(d => (d.GuzergahId!.Value, d.Guzergah?.GuzergahAdi ?? $"Güzergâh #{d.GuzergahId}"))
        .DistinctBy(x => x.Item1)
        .OrderBy(x => x.Item2)
        .Select(x => (x.Item1, x.Item2));

    private List<DetayliHakedisRaporSatiri> FiltreliRaporSatirlari => hakedisler
        .Where(h => h.Tip == HakedisTipi.Kurum)
        .Where(h => seciliKurumIdleri.Count == 0 || seciliKurumIdleri.Contains(h.ReferansId))
        .SelectMany(h => h.Detaylar.Select(d => new { Hakedis = h, Detay = d }))
        .Where(x => seciliGuzergahId == 0 || x.Detay.GuzergahId == seciliGuzergahId)
        .GroupBy(x => new
        {
            Firma = GetReferansAd(x.Hakedis),
            Guzergah = x.Detay.Guzergah?.GuzergahAdi ?? $"Güzergâh #{x.Detay.GuzergahId}",
            Plaka = x.Detay.Arac?.AktifPlaka ?? x.Detay.Arac?.Plaka ?? $"Araç #{x.Detay.AracId}",
            Sofor = x.Detay.Sofor?.TamAd ?? $"Şoför #{x.Detay.SoforId}"
        })
        .Select(g =>
        {
            var sefer = g.Sum(x => x.Detay.SeferSayisi);
            var tutar = g.Sum(x => x.Detay.Tutar);
            return new DetayliHakedisRaporSatiri(g.Key.Firma, g.Key.Guzergah, g.Key.Plaka, g.Key.Sofor,
                sefer, sefer > 0 ? tutar / sefer : 0m, tutar);
        })
        .OrderBy(x => x.Firma)
        .ThenBy(x => x.Guzergah)
        .ThenBy(x => x.Plaka)
        .ThenBy(x => x.Sofor)
        .ToList();

    private sealed record DetayliHakedisRaporSatiri(string Firma, string Guzergah, string Plaka, string Sofor,
        decimal SeferSayisi, decimal BirimFiyat, decimal FaturaTutari);

    private IEnumerable<IGrouping<string, DetayliHakedisRaporSatiri>> DetayRaporGruplari =>
        FiltreliRaporSatirlari.GroupBy(x => x.Firma).OrderBy(x => x.Key);

    private List<Hakedis> FiltreliHakedisler
    {
        get
        {
            IEnumerable<Hakedis> sonuc = hakedisler;

            if (!string.IsNullOrWhiteSpace(durumFiltre) && Enum.TryParse<HakedisDurum>(durumFiltre, out var durum))
                sonuc = sonuc.Where(h => h.Durum == durum);

            if (!string.IsNullOrWhiteSpace(aramaMetni))
            {
                var kelimeler = aramaMetni.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                sonuc = sonuc.Where(h =>
                {
                    var metin = $"{GetReferansAd(h)} {GetGuzergahOzet(h)}";
                    return kelimeler.All(k => metin.Contains(k, StringComparison.OrdinalIgnoreCase));
                });
            }

            return sonuc.ToList();
        }
    }

    private void FiltreleriTemizle()
    {
        durumFiltre = "";
        aramaMetni = "";
        seciliKurumIdleri.Clear();
        seciliGuzergahId = 0;
    }

    private void KurumFiltresiDegisti(ChangeEventArgs args)
    {
        seciliKurumIdleri = args.Value switch
        {
            string[] secimler => secimler
                .Select(x => int.TryParse(x, out var id) ? (int?)id : null)
                .Where(x => x.HasValue)
                .Select(x => x!.Value)
                .ToList(),
            IEnumerable<string> secimler => secimler
                .Select(x => int.TryParse(x, out var id) ? (int?)id : null)
                .Where(x => x.HasValue)
                .Select(x => x!.Value)
                .ToList(),
            string secim when int.TryParse(secim, out var id) => new List<int> { id },
            _ => new List<int>()
        };
    }

    private bool TumSeciliMi => FiltreliHakedisler.Any() && FiltreliHakedisler.All(h => seciliHakedisIds.Contains(h.Id));
    private List<int> SeciliTaslakIdler => hakedisler.Where(h => seciliHakedisIds.Contains(h.Id) && h.Durum == HakedisDurum.Taslak).Select(h => h.Id).ToList();
    private List<int> SeciliFaturalanabilirIdler => hakedisler.Where(h => seciliHakedisIds.Contains(h.Id) && h.Durum == HakedisDurum.Onaylandi && h.Tip != HakedisTipi.Arac).Select(h => h.Id).ToList();
    private List<int> SeciliSilinebilirIdler => hakedisler.Where(h => seciliHakedisIds.Contains(h.Id) && h.Durum is not (HakedisDurum.Faturalandi or HakedisDurum.TahsilEdildi or HakedisDurum.Odendi)).Select(h => h.Id).ToList();

    // Gruplama sonuçları
    private Dictionary<string, List<Hakedis>> GetGroupedData()
    {
        var kaynak = FiltreliHakedisler;
        return selectedGrouping switch
        {
            "referans" => kaynak
                .GroupBy(GetReferansAd)
                .OrderBy(g => g.Key)
                .ToDictionary(g => g.Key, g => g.ToList()),

            _ => // "cari" (default)
                kaynak
                    .GroupBy(GetCariGrupAnahtari)
                    .OrderBy(g => g.Key)
                    .ToDictionary(g => g.Key, g => g.ToList()),
        };
    }

    private void ToggleGroup(string groupKey)
    {
        if (!expandedGroups.ContainsKey(groupKey))
            expandedGroups[groupKey] = true;
        else
            expandedGroups[groupKey] = !expandedGroups[groupKey];
    }

    private async Task ExceleAktarAsync()
    {
        try
        {
            if (!FiltreliHakedisler.Any()) return;

            using var workbook = new ClosedXML.Excel.XLWorkbook();
            var ws = workbook.Worksheets.Add("Hakediş");

            var basliklar = new[] { "#", "Tip", "Referans", "Güzergah", "Toplam Sefer", "Birim Fiyat", "Tutar", "KDV Oran %", "KDV Tutar", "Genel Toplam", "Durum" };
            for (var i = 0; i < basliklar.Length; i++)
            {
                var hucre = ws.Cell(1, i + 1);
                hucre.Value = basliklar[i];
                hucre.Style.Font.Bold = true;
                hucre.Style.Fill.BackgroundColor = ClosedXML.Excel.XLColor.LightGray;
            }

            var satir = 2;
            foreach (var h in FiltreliHakedisler.OrderBy(x => GetReferansAd(x)))
            {
                ws.Cell(satir, 1).Value = h.Id;
                ws.Cell(satir, 2).Value = GetTipText(h.Tip);
                ws.Cell(satir, 3).Value = GetReferansAd(h);
                ws.Cell(satir, 4).Value = GetGuzergahOzet(h);
                ws.Cell(satir, 5).Value = h.ToplamSeferSayisi;
                ws.Cell(satir, 6).Value = h.BirimFiyat;
                ws.Cell(satir, 7).Value = h.Tutar;
                ws.Cell(satir, 8).Value = h.KdvOran;
                ws.Cell(satir, 9).Value = h.KdvTutar;
                ws.Cell(satir, 10).Value = h.GenelToplam;
                ws.Cell(satir, 11).Value = h.Durum.ToString();
                satir++;
            }

            // Toplam satırı
            ws.Cell(satir, 4).Value = "TOPLAM";
            ws.Cell(satir, 4).Style.Font.Bold = true;
            foreach (var col in new[] { 5, 7, 9, 10 })
            {
                var hucre = ws.Cell(satir, col);
                hucre.FormulaA1 = $"SUM({ws.Cell(2, col).Address}:{ws.Cell(satir - 1, col).Address})";
                hucre.Style.Font.Bold = true;
            }

            ws.Range(2, 5, satir, 10).Style.NumberFormat.Format = "#,##0.00";
            ws.Columns().AdjustToContents();
            ws.SheetView.FreezeRows(1);

            using var stream = new MemoryStream();
            workbook.SaveAs(stream);
            var dosyaAdi = $"OperasyonelHakedis_{yil}-{ay:D2}_{GetTipText(seciliTip)}.xlsx";
            var base64 = Convert.ToBase64String(stream.ToArray());
            await JS.InvokeVoidAsync("downloadFile", dosyaAdi, base64, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        catch (Exception ex)
        {
            hataMesaji = $"Excel oluşturulurken hata: {ex.Message}";
        }
    }

    private async Task DetayliRaporuExceleAktarAsync()
    {
        try
        {
            var satirlar = FiltreliRaporSatirlari;
            if (!satirlar.Any()) return;

            using var workbook = new ClosedXML.Excel.XLWorkbook();
            var ws = workbook.Worksheets.Add("Firma Güzergah Raporu");
            ws.Cell(1, 1).Value = $"HAKEDİŞ DETAY RAPORU - {ay:D2}/{yil}";
            ws.Range(1, 1, 1, 7).Merge();
            ws.Cell(1, 1).Style.Font.Bold = true;
            ws.Cell(1, 1).Style.Font.FontSize = 14;
            var basliklar = new[] { "Firma", "Güzergâh", "Plaka", "Şoför", "Sefer Sayısı", "Birim Fiyat", "Firmaya Kesilecek Güzergâh Faturası" };
            for (var i = 0; i < basliklar.Length; i++)
            {
                ws.Cell(3, i + 1).Value = basliklar[i];
                ws.Cell(3, i + 1).Style.Font.Bold = true;
                ws.Cell(3, i + 1).Style.Fill.BackgroundColor = ClosedXML.Excel.XLColor.LightBlue;
            }

            var excelSatir = 4;
            foreach (var grup in DetayRaporGruplari)
            {
                if (firmalariGrupla)
                {
                    ws.Cell(excelSatir, 1).Value = $"FİRMA: {grup.Key}";
                    ws.Range(excelSatir, 1, excelSatir, 7).Merge();
                    ws.Range(excelSatir, 1, excelSatir, 7).Style.Font.Bold = true;
                    ws.Range(excelSatir, 1, excelSatir, 7).Style.Fill.BackgroundColor = ClosedXML.Excel.XLColor.LightBlue;
                    excelSatir++;
                }

                foreach (var satir in grup)
                {
                    ws.Cell(excelSatir, 1).Value = satir.Firma;
                    ws.Cell(excelSatir, 2).Value = satir.Guzergah;
                    ws.Cell(excelSatir, 3).Value = satir.Plaka;
                    ws.Cell(excelSatir, 4).Value = satir.Sofor;
                    ws.Cell(excelSatir, 5).Value = satir.SeferSayisi;
                    ws.Cell(excelSatir, 6).Value = satir.BirimFiyat;
                    ws.Cell(excelSatir, 7).Value = satir.FaturaTutari;
                    excelSatir++;
                }

                if (firmalariGrupla)
                {
                    ws.Cell(excelSatir, 1).Value = $"{grup.Key} Ara Toplam";
                    ws.Cell(excelSatir, 5).Value = grup.Sum(x => x.SeferSayisi);
                    ws.Cell(excelSatir, 7).Value = grup.Sum(x => x.FaturaTutari);
                    ws.Range(excelSatir, 1, excelSatir, 7).Style.Font.Bold = true;
