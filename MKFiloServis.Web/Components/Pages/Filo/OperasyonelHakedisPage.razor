            ws.Cell(excelSatir, 1).Value = "GENEL TOPLAM";
            ws.Cell(excelSatir, 5).Value = satirlar.Sum(x => x.SeferSayisi);
            ws.Cell(excelSatir, 7).Value = satirlar.Sum(x => x.FaturaTutari);
            ws.Range(excelSatir, 1, excelSatir, 7).Style.Font.Bold = true;
            ws.Range(4, 5, excelSatir, 7).Style.NumberFormat.Format = "#,##0.00";
            ws.Columns().AdjustToContents();
            ws.SheetView.FreezeRows(3);

            using var stream = new MemoryStream();
            workbook.SaveAs(stream);
            await JS.InvokeVoidAsync("downloadFile", $"Hakedis_Detay_Raporu_{yil}-{ay:D2}.xlsx", Convert.ToBase64String(stream.ToArray()), "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        catch (Exception ex)
        {
            hataMesaji = $"Detaylı rapor oluşturulurken hata: {ex.Message}";
        }
    }

