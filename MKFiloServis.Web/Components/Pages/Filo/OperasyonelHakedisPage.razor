@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Licensed:filoservis")]
@page "/operasyonel-hakedis"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using MKFiloServis.Shared.Entities
@using MKFiloServis.Web.Services.Interfaces
@using MKFiloServis.Web.Services
@using MKFiloServis.Web.Models
@using Microsoft.JSInterop
@inject IOperasyonelHakedisService HakedisService
@inject ITasimaTedarikciService TedarikciService
@inject IAracService AracService
@inject ICariService CariService
@inject IFiloKomisyonService FiloKomisyonService
@inject IPdfService PdfService
@inject IJSRuntime JS
@inject IAktifFirmaProvider AktifFirmaProvider
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Operasyonel Hakediş</PageTitle>

<div class="container-fluid hakedis-sayfa">

    @* ── Başlık, dönem ve hakediş türü ─────────────────────────────────── *@
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
        <div>
            <h3 class="mb-1"><i class="bi bi-receipt-cutoff me-2 text-primary"></i>Operasyonel Hakediş</h3>
            <div class="text-muted small">Dönemi ve hakediş türünü seçin, kapsamı daraltın, önizleyin; sonra hakedişi oluşturun.</div>
        </div>
        <div class="d-flex flex-wrap align-items-end gap-2">
            <div class="input-group input-group-sm hakedis-donem">
                <button type="button" class="btn btn-outline-secondary" title="Önceki ay" @onclick="() => AyGitAsync(-1)" disabled="@isBusy">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <select class="form-select" @bind="ay" @bind:after="DonemDegistiAsync" disabled="@isBusy" aria-label="Ay">
                    @for (var i = 1; i <= 12; i++)
                    {
                        <option value="@i">@AyAdlari[i - 1]</option>
                    }
                </select>
                <input type="number" class="form-control hakedis-yil" @bind="yil" @bind:after="DonemDegistiAsync"
                       min="2000" max="2100" disabled="@isBusy" aria-label="Yıl" />
                <button type="button" class="btn btn-outline-secondary" title="Sonraki ay" @onclick="() => AyGitAsync(1)" disabled="@isBusy">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="BuAyaGitAsync" disabled="@isBusy">Bu ay</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" title="Verileri yeniden yükle" @onclick="TumunuYukleAsync" disabled="@isBusy">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>

    <div class="row g-2 mb-3">
        @foreach (var tur in TurSecenekleri)
        {
            <div class="col-12 col-md-6 col-xl-3">
                <button type="button" class="tur-karti @(seciliTip == tur.Tip ? "aktif" : "")"
                        @onclick="() => TipSecAsync(tur.Tip)" disabled="@isBusy" aria-pressed="@(seciliTip == tur.Tip ? "true" : "false")">
                    <span class="tur-ikon"><i class="bi @tur.Ikon"></i></span>
                    <span class="tur-metin">
                        <span class="fw-semibold d-block">@tur.Baslik</span>
                        <small class="text-muted d-block">@tur.Aciklama</small>
                    </span>
                </button>
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(hataMesaji))
    {
        <div class="alert alert-danger alert-dismissible py-2" role="alert">
            @hataMesaji
            <button type="button" class="btn-close" aria-label="Kapat" @onclick="() => hataMesaji = null"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(bilgiMesaji))
    {
        <div class="alert alert-success alert-dismissible py-2" role="status">
            @bilgiMesaji
            <button type="button" class="btn-close" aria-label="Kapat" @onclick="() => bilgiMesaji = null"></button>
        </div>
    }

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button type="button" class="nav-link @(aktifSekme == Sekme.Hazirla ? "active" : "")" @onclick="() => aktifSekme = Sekme.Hazirla">
                <i class="bi bi-sliders me-1"></i>Hakediş Hazırla
            </button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link @(aktifSekme == Sekme.Hakedisler ? "active" : "")" @onclick="() => aktifSekme = Sekme.Hakedisler">
                <i class="bi bi-card-checklist me-1"></i>Oluşturulan Hakedişler
                <span class="badge rounded-pill @(hakedisler.Count > 0 ? "bg-primary" : "bg-secondary") ms-1">@hakedisler.Count</span>
            </button>
        </li>
    </ul>

    @if (aktifSekme == Sekme.Hazirla)
    {
        @* ── 1) Kapsam / filtreler ─────────────────────────────────────── *@
        <div class="card shadow-sm mb-3">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2 py-2">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <strong><i class="bi bi-funnel me-1"></i>Kapsam</strong>
                    <span class="text-muted small">Filtreler birlikte uygulanır; boş bırakılan filtre "tümü" demektir.</span>
                </div>
                @if (FiltreVar)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="FiltreleriTemizleAsync" disabled="@onizlemeYukleniyor">
                        <i class="bi bi-x-lg me-1"></i>Filtreleri temizle
                    </button>
                }
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="filtre-grup-baslik"><i class="bi bi-person-badge me-1"></i>Araç sahibi</div>
                        <div class="form-label small mb-1">Sahiplik türü</div>
                        <div class="d-flex flex-wrap gap-1 mb-2">
                            @foreach (var tip in SahiplikSecenekleri)
                            {
                                var secili = secSahiplik.Contains(tip);
                                <button type="button" class="btn btn-sm rounded-pill @(secili ? "btn-primary" : "btn-outline-secondary")"
                                        @onclick="() => SahiplikDegistirAsync(tip)" aria-pressed="@(secili ? "true" : "false")">
                                    <i class="bi @SahiplikHelper.GetIcon(tip) me-1"></i>@SahiplikHelper.GetMetin(tip)
                                </button>
                            }
                            @if (!SahiplikSecenekleri.Any())
                            {
                                <span class="text-muted small">Bu dönemde puantaj yok.</span>
                            }
                        </div>
                        <div class="mb-2">
                            <CokluSecim Etiket="Araç sahibi" Secenekler="Ogeler(SahipSecenekleri)" Secili="secSahip" OnDegisti="FiltreDegistiAsync" />
                        </div>
                        <CokluSecim Etiket="Araç (plaka)" Secenekler="Ogeler(AracSecenekleri)" Secili="secArac" OnDegisti="FiltreDegistiAsync" />
                    </div>

                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="filtre-grup-baslik"><i class="bi bi-signpost-split me-1"></i>Güzergâh bilgileri</div>
                        <div class="mb-2">
                            <div class="form-label small mb-1">Müşteri kurum nereden alınsın?</div>
                            <div class="btn-group btn-group-sm w-100" role="group" aria-label="Müşteri kurum kaynağı">
                                <button type="button" class="btn @(musteriKaynagi == HakedisMusteriKaynagi.Eslestirme ? "btn-primary" : "btn-outline-secondary")"
                                        @onclick="() => MusteriKaynagiSecAsync(HakedisMusteriKaynagi.Eslestirme)" disabled="@onizlemeYukleniyor"
                                        title="Eşleştirmedeki &quot;Müşteri Kurum&quot; (eşleştirmesiz puantajda puantajın kendi müşterisi)">
                                    Eşleştirme
                                </button>
                                <button type="button" class="btn @(musteriKaynagi == HakedisMusteriKaynagi.Guzergah ? "btn-primary" : "btn-outline-secondary")"
                                        @onclick="() => MusteriKaynagiSecAsync(HakedisMusteriKaynagi.Guzergah)" disabled="@onizlemeYukleniyor"
                                        title="Güzergâh kartında bağlı olan cari">
                                    Güzergâh kartı
                                </button>
                            </div>
                        </div>
                        <div class="mb-2">
                            <CokluSecim Etiket="Cari / kurum" Secenekler="Ogeler(CariSecenekleri)" Secili="secCari" OnDegisti="FiltreDegistiAsync" />
                        </div>
                        <div class="mb-2">
                            <CokluSecim Etiket="Güzergâh" Secenekler="Ogeler(GuzergahSecenekleri)" Secili="secGuzergah" OnDegisti="FiltreDegistiAsync" />
                        </div>
                        <CokluSecim Etiket="Servis türü" Secenekler="ServisOgeleri" Secili="secServis" OnDegisti="FiltreDegistiAsync" />
                    </div>

                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="filtre-grup-baslik"><i class="bi bi-link-45deg me-1"></i>Eşleştirme bilgileri</div>
                        <div class="mb-2">
                            <CokluSecim Etiket="Eşleştirme (kurum • güzergâh • araç • şoför)" Secenekler="Ogeler(EslestirmeSecenekleri)" Secili="secEslestirme" OnDegisti="FiltreDegistiAsync" />
                        </div>
                        <CokluSecim Etiket="Şoför" Secenekler="Ogeler(SoforSecenekleri)" Secili="secSofor" OnDegisti="FiltreDegistiAsync" />
                        @if (seciliTip == HakedisTipi.Arac)
                        {
                            <div class="mt-2">
                                <label class="form-label small mb-1" for="birimFiyatKaynagi">Birim fiyat (araç hakedişi)</label>
                                <select id="birimFiyatKaynagi" class="form-select form-select-sm" @bind="birimFiyatKaynagi" @bind:after="OnizlemeYenileAsync">
                                    <option value="@HakedisBirimFiyatKaynagi.EslestirmeOdenen">Eşleştirme: taşerona / şoföre ödenen</option>
                                    <option value="@HakedisBirimFiyatKaynagi.EslestirmeKesilecek">Eşleştirme: kuruma kesilecek ücret</option>
                                    <option value="@HakedisBirimFiyatKaynagi.MaliyetKaydi">Araç maliyet kaydı (eski)</option>
                                </select>
                            </div>
                        }
                        <div class="form-text">Eşleştirmeler, "Tanımları Yönet" sekmesindeki araç–şoför–güzergâh şablonlarıdır.</div>
                    </div>

                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="filtre-grup-baslik"><i class="bi bi-calendar-range me-1"></i>Gün aralığı</div>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label small mb-1">Başlangıç</label>
                                <input type="date" class="form-control form-control-sm" value="@TarihDegeri(gunBaslangic)"
                                       min="@DonemIlkGun" max="@DonemSonGun" @onchange="e => GunDegistiAsync(e, true)" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small mb-1">Bitiş</label>
                                <input type="date" class="form-control form-control-sm" value="@TarihDegeri(gunBitis)"
                                       min="@DonemIlkGun" max="@DonemSonGun" @onchange="e => GunDegistiAsync(e, false)" />
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-1">
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => HazirGunAraligiAsync(1, 15)">1 – 15</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => HazirGunAraligiAsync(16, null)">16 – ay sonu</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => HazirGunAraligiAsync(null, null)">Tüm ay</button>
                        </div>
                        <div class="form-text">Boş bırakılırsa ayın tamamı alınır. Farklı gün aralıkları ayrı hakediş olarak oluşturulabilir.</div>
                    </div>
                </div>
            </div>
        </div>

        @if (onizleme is not null)
        {
            var toplamSatirlar = GorunenSatirlar;
            var sefer = toplamSatirlar.Sum(s => s.Sefer);
            var gelir = toplamSatirlar.Sum(s => s.Gelir);
            var gider = toplamSatirlar.Sum(s => s.Gider);
            var maliyet = toplamSatirlar.Sum(s => s.Maliyet);
            var net = gelir - gider - maliyet;

            @* ── 2) Özet ve hakediş oluşturma ─────────────────────────── *@
            <div class="row g-2 mb-2">
                <div class="col-6 col-lg">
                    <div class="ozet-kutu ozet-birincil">
                        <div class="etiket">Sefer</div>
                        <div class="deger">@Sayi(sefer)</div>
                        <div class="alt">@toplamSatirlar.Sum(s => s.PuantajSayisi) puantaj kaydı</div>
                    </div>
                </div>
                <div class="col-6 col-lg">
                    <div class="ozet-kutu ozet-basari">
                        <div class="etiket">Gelir (kuruma kesilecek)</div>
                        <div class="deger">@Tl(gelir)</div>
                    </div>
                </div>
                <div class="col-6 col-lg">
                    <div class="ozet-kutu ozet-tehlike">
                        <div class="etiket">Gider (taşeron / araç sahibi)</div>
                        <div class="deger">@Tl(gider)</div>
                    </div>
                </div>
                <div class="col-6 col-lg">
                    <div class="ozet-kutu ozet-uyari">
                        <div class="etiket">İç maliyet (özmal / kiralık)</div>
                        <div class="deger">@Tl(maliyet)</div>
                    </div>
                </div>
                <div class="col-12 col-lg">
                    <div class="ozet-kutu @(net >= 0 ? "ozet-basari" : "ozet-tehlike")">
                        <div class="etiket">Net</div>
                        <div class="deger">@Tl(net)</div>
                    </div>
                </div>
            </div>

            <div class="olustur-cubugu mb-3">
                <div>
                    @if (onizleme.OlusacakHakedisSayisi > 0)
                    {
                        <div class="fw-semibold">
                            @onizleme.OlusacakHakedisSayisi adet @GetTipText(seciliTip).ToLower(new System.Globalization.CultureInfo("tr-TR")) hakedişi oluşacak
                            <span class="text-muted fw-normal">· @TutarBasligi: @Tl(OlusacakTutar) (KDV hariç)</span>
                        </div>
                        <div class="small text-muted">Kapsam: @KapsamOzetiMetni</div>
                    }
                    else
                    {
                        <div class="fw-semibold">Bu kapsamda yeni hakedişe girecek satır yok</div>
                        <div class="small text-muted">Kapsam: @KapsamOzetiMetni</div>
                    }
                </div>
                <button type="button" class="btn btn-primary" @onclick="HakedisOlusturAsync"
                        disabled="@(isBusy || onizlemeYukleniyor || onizleme.OlusacakHakedisSayisi == 0)"
                        title="Seçili kapsam için taslak hakediş oluşturur; aynı kapsamdaki taslak varsa günceller">
                    <i class="bi bi-magic me-1"></i>Hakediş Oluştur
                </button>
            </div>

            @if (HakedistekiPuantaj > 0)
            {
                <div class="alert alert-info py-2 small">
                    <i class="bi bi-info-circle me-1"></i>
                    Kapsamdaki <strong>@HakedistekiPuantaj</strong> puantaj kaydı (@Sayi(HakedistekiSefer) sefer) onaylı veya faturalı bir hakedişte
                    olduğu için yeni hakedişe girmez@(hakedistekileriGoster ? "; tabloda soluk gösteriliyor." : "; tabloda gizli. Görmek için aşağıdaki \"Hakedişte olanları da göster\" seçeneğini açın.")
                </div>
            }

            @if (UygunsuzPuantaj > 0)
            {
                <div class="alert alert-warning py-2 small">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    <strong>@UygunsuzPuantaj</strong> puantaj kaydı hakedişe alınamıyor (tabloda kırmızı):
                    @string.Join("; ", UygunsuzNedenleri). Eksik kaydı tamamlayıp önizlemeyi yenileyin.
                </div>
            }

            @if (onizleme.TurDisiPuantajSayisi > 0)
            {
                <div class="alert alert-secondary py-2 small">
                    <i class="bi bi-info-circle me-1"></i>
                    @TurKapsamiAciklamasi Kapsamınızdaki
                    <strong>@onizleme.TurDisiPuantajSayisi</strong> puantaj kaydı (@Sayi(onizleme.TurDisiSefer) sefer) bu türe girmediği
                    için listelenmiyor.
                </div>
            }
        }

        @* ── 3) Önizleme tablosu ───────────────────────────────────────── *@
        <div class="card shadow-sm">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2 py-2">
                <div>
                    <strong><i class="bi bi-table me-1"></i>Önizleme</strong>
                    <span class="text-muted small ms-2">@(DonemGecerli ? AyAdlari[ay - 1] : "") @yil · @GetTipText(seciliTip) hakedişi</span>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-success" @onclick="OnizlemeExceleAktarAsync" disabled="@(GorunenSatirlar.Count == 0)">
                        <i class="bi bi-file-earmark-excel me-1"></i>Excel
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="OnizlemePdfAktarAsync" disabled="@(GorunenSatirlar.Count == 0)">
                        <i class="bi bi-file-earmark-pdf me-1"></i>PDF
                    </button>
                </div>
            </div>
            <div class="card-body border-bottom py-2">
                <div class="d-flex flex-wrap align-items-center gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <label class="small text-muted mb-0" for="gruplamaSecimi">Grupla:</label>
                        <select id="gruplamaSecimi" class="form-select form-select-sm w-auto" @bind="gruplama" @bind:after="GruplamaDegisti">
                            @foreach (var g in GruplamaSecenekleri)
                            {
                                <option value="@g">@HakedisRaporOlusturucu.GruplamaAdi(g)</option>
                            }
                        </select>
                        @if (gruplama != HakedisGruplama.Yok)
                        {
                            <button type="button" class="btn btn-sm btn-link text-decoration-none p-0" @onclick="OnizlemeGruplariniAcKapat">
                                @(onizlemeTumuAcik ? "Grupları kapat" : "Grupları aç")
                            </button>
                        }
                    </div>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" role="switch" id="karlilikKolonlari" @bind="karlilikKolonlari" />
                        <label class="form-check-label small" for="karlilikKolonlari">Kârlılık sütunları (gelir / gider / maliyet / net)</label>
                    </div>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" role="switch" id="hakedistekileriGoster" @bind="hakedistekileriGoster" />
                        <label class="form-check-label small" for="hakedistekileriGoster">Hakedişte olanları da göster</label>
                    </div>
                    @if (onizlemeYukleniyor)
                    {
                        <div class="spinner-border spinner-border-sm text-primary" role="status" aria-label="Yükleniyor"></div>
                    }
                </div>
            </div>

            @if (onizleme is null)
            {
                <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
            }
            else if (GorunenSatirlar.Count == 0)
            {
                <div class="text-center text-muted py-5 px-3">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    @if (onizleme.Satirlar.Count > 0)
                    {
                        <div class="fw-semibold">Kapsamdaki tüm satırlar onaylı / faturalı hakedişlerde.</div>
                        <div class="small mb-2">Yeni hakedişe girecek satır kalmadı.</div>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => hakedistekileriGoster = true">Hakedişte olanları göster</button>
                    }
                    else
                    {
                        <div class="fw-semibold">Bu kapsamda puantaj bulunamadı.</div>
                        <div class="small mb-2">Dönemi değiştirin, hakediş türünü kontrol edin ya da filtreleri gevşetin.</div>
                        @if (FiltreVar)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="FiltreleriTemizleAsync">Filtreleri temizle</button>
                        }
                    }
                </div>
            }
            else
            {
                var gruplar = GorunenGruplar;
                var tumSatirlar = GorunenSatirlar;
                var etiketKolonlari = GrupEtiketKolonSayisi;

                <div class="table-responsive onizleme-tablo @(onizlemeYukleniyor ? "opacity-50" : "")">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                @if (GosterCari) { <th>Cari</th> }
                                @if (GosterGuzergah) { <th>Güzergâh</th> }
                                @if (GosterPlaka) { <th>Plaka</th> }
                                @if (GosterSahip) { <th>Araç sahibi</th> }
                                @if (GosterSofor) { <th>Şoför</th> }
                                <th class="text-end">Sefer</th>
                                @if (karlilikKolonlari)
                                {
                                    <th class="text-end">Gelir</th>
                                    <th class="text-end">Gider</th>
                                    <th class="text-end">İç maliyet</th>
                                    <th class="text-end">Net</th>
                                }
                                else
                                {
                                    <th class="text-end">Birim fiyat</th>
                                    <th class="text-end">@TutarBasligi</th>
                                }
                                @if (GorunenHakedisteVar) { <th>Durum</th> }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var grup in gruplar)
                            {
                                @if (gruplama != HakedisGruplama.Yok)
                                {
                                    var acik = OnizlemeGrubuAcik(grup.Anahtar);
                                    <tr class="grup-satiri" @onclick="() => OnizlemeGrubuDegistir(grup.Anahtar)">
                                        <td colspan="@etiketKolonlari">
                                            <i class="bi @(acik ? "bi-chevron-down" : "bi-chevron-right") me-1"></i>
                                            @grup.Baslik
                                            @if (!string.IsNullOrWhiteSpace(grup.Alt))
                                            {
                                                <span class="text-muted fw-normal small ms-1">(@grup.Alt)</span>
                                            }
                                            <span class="badge rounded-pill bg-secondary ms-1">@grup.Satirlar.Count</span>
                                        </td>
                                        <td class="text-end">@Sayi(grup.Sefer)</td>
                                        @if (karlilikKolonlari)
                                        {
                                            <td class="text-end">@Sayi(grup.Gelir)</td>
                                            <td class="text-end">@Sayi(grup.Gider)</td>
                                            <td class="text-end">@Sayi(grup.Maliyet)</td>
                                            <td class="text-end">@Sayi(grup.Net)</td>
                                        }
                                        else
                                        {
                                            <td></td>
                                            <td class="text-end">@Sayi(grup.HakedisTutari)</td>
                                        }
                                        @if (GorunenHakedisteVar) { <td></td> }
                                    </tr>
                                }

                                @if (gruplama == HakedisGruplama.Yok || OnizlemeGrubuAcik(grup.Anahtar))
                                {
                                    @foreach (var s in grup.Satirlar)
                                    {
                                        <tr class="@(!s.Uygun ? "table-danger" : s.HakedisteMi ? "text-muted satir-hakedistede" : "")">
                                            @if (GosterCari) { <td>@s.CariAd</td> }
                                            @if (GosterGuzergah) { <td>@s.GuzergahAd</td> }
                                            @if (GosterPlaka)
                                            {
                                                <td class="text-nowrap fw-semibold">@s.Plaka <SahiplikBadge Tip="s.SahiplikTipi" CssClass="ms-1 fw-normal" /></td>
                                            }
                                            @if (GosterSahip) { <td>@(s.SahiplikTipi == AracSahiplikTipi.Ozmal ? "Firma aracı" : s.SahipAd)</td> }
                                            @if (GosterSofor) { <td>@s.SoforAd</td> }
                                            <td class="text-end" title="@s.PuantajSayisi puantaj kaydı">@Sayi(s.Sefer)</td>
                                            @if (karlilikKolonlari)
                                            {
                                                <td class="text-end">@Sayi(s.Gelir)</td>
                                                <td class="text-end">@Sayi(s.Gider)</td>
                                                <td class="text-end">@Sayi(s.Maliyet)</td>
                                                <td class="text-end fw-semibold">@Sayi(s.Net)</td>
                                            }
                                            else
                                            {
                                                <td class="text-end">@Sayi(s.Sefer > 0 ? s.HakedisTutari / s.Sefer : 0m)</td>
                                                <td class="text-end fw-semibold">@Sayi(s.HakedisTutari)</td>
                                            }
                                            @if (GorunenHakedisteVar)
                                            {
                                                <td class="text-nowrap">
                                                    @if (!s.Uygun)
                                                    {
                                                        <span class="badge bg-danger" title="@s.UygunsuzlukNedeni">Hakedişe girmez</span>
                                                    }
                                                    else if (s.HakedisteMi)
                                                    {
                                                        <span class="badge bg-info text-dark" title="Aynı türde onaylı / faturalı bir hakedişte zaten var">Hakedişte</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success">Yeni</span>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold toplam-satiri">
                                <td colspan="@etiketKolonlari">GENEL TOPLAM <span class="fw-normal text-muted small">(@tumSatirlar.Count satır)</span></td>
                                <td class="text-end">@Sayi(tumSatirlar.Sum(x => x.Sefer))</td>
                                @if (karlilikKolonlari)
                                {
                                    <td class="text-end">@Sayi(tumSatirlar.Sum(x => x.Gelir))</td>
                                    <td class="text-end">@Sayi(tumSatirlar.Sum(x => x.Gider))</td>
                                    <td class="text-end">@Sayi(tumSatirlar.Sum(x => x.Maliyet))</td>
                                    <td class="text-end">@Sayi(tumSatirlar.Sum(x => x.Net))</td>
                                }
                                else
                                {
                                    <td></td>
                                    <td class="text-end">@Sayi(tumSatirlar.Sum(x => x.HakedisTutari))</td>
                                }
                                @if (GorunenHakedisteVar) { <td></td> }
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    }
    else
    {
        @* ── Oluşturulan hakedişler ─────────────────────────────────────── *@
        @if (sonUretimSonucu is not null)
        {
            <div class="card shadow-sm mb-3 border-success">
                <div class="card-header d-flex justify-content-between align-items-center py-2">
                    <strong><i class="bi bi-check2-circle text-success me-1"></i>Son oluşturma sonucu</strong>
                    <button type="button" class="btn-close" aria-label="Kapat" @onclick="() => sonUretimSonucu = null"></button>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Referans</th>
                                <th>Sonuç</th>
                                <th class="text-end">Sefer</th>
                                <th class="text-end">Genel toplam</th>
                                <th>Açıklama</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in sonUretimSonucu.Satirlar)
                            {
                                <tr>
                                    <td>@s.ReferansAd</td>
                                    <td>
                                        <span class="badge @(s.Sonuc == "Üretildi" ? "bg-success" : s.Sonuc == "Hata" ? "bg-danger" : "bg-warning text-dark")">@s.Sonuc</span>
                                    </td>
                                    <td class="text-end">@Sayi(s.Sefer)</td>
                                    <td class="text-end">@(s.Tutar > 0 ? Tl(s.Tutar) : "-")</td>
                                    <td class="small text-muted">@s.Mesaj</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div class="row g-2 mb-3">
            <div class="col-6 col-lg-3">
                <div class="ozet-kutu ozet-birincil">
                    <div class="etiket">Hakediş</div>
                    <div class="deger">@FiltreliHakedisler.Count</div>
                    <div class="alt">@GetTipText(seciliTip) · @hakedisler.Count(x => x.Durum == HakedisDurum.Taslak) taslak, @hakedisler.Count(x => x.Durum == HakedisDurum.Onaylandi) onaylı</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="ozet-kutu ozet-basari">
                    <div class="etiket">Tutar (KDV hariç)</div>
                    <div class="deger">@Tl(FiltreliHakedisler.Sum(x => x.Tutar))</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="ozet-kutu ozet-uyari">
                    <div class="etiket">KDV</div>
                    <div class="deger">@Tl(FiltreliHakedisler.Sum(x => x.KdvTutar))</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="ozet-kutu ozet-birincil">
                    <div class="etiket">Genel toplam</div>
                    <div class="deger">@Tl(FiltreliHakedisler.Sum(x => x.GenelToplam))</div>
                </div>
            </div>
        </div>

        @if (puantajDonemOzeti is not null)
        {
            <div class="card shadow-sm mb-3 border-0 border-start border-4 @(MutabakatSorunuVar ? "border-warning" : "border-success")">
                <div class="card-body py-2">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div class="fw-semibold"><i class="bi bi-shield-check me-1"></i>Mutabakat (puantaj ↔ hakediş)</div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @(MutabakatSorunuVar ? "bg-warning text-dark" : "bg-success")">@(MutabakatSorunuVar ? "Fark var" : "Uyumlu")</span>
                            <button type="button" class="btn btn-sm btn-link text-decoration-none p-0" @onclick="() => mutabakatAcik = !mutabakatAcik">
                                @(mutabakatAcik ? "Gizle" : "Ayrıntı")
                            </button>
                        </div>
                    </div>
                    @if (mutabakatAcik)
                    {
                        <div class="row g-2 small mt-1">
                            <div class="col-md-4">
                                <div>Puantaj sefer: <strong>@Sayi(puantajDonemOzeti.ToplamSefer)</strong></div>
                                <div>Hakediş sefer: <strong>@Sayi(HakedisToplamSefer)</strong></div>
                                <div>Fark: <strong class="@(Math.Abs(SeferFarki) > 0.01m ? "text-warning" : "text-success")">@Sayi(SeferFarki)</strong></div>
                            </div>
                            <div class="col-md-4">
                                <div>Puantaj gelir: <strong>@Tl(puantajDonemOzeti.ToplamGelir)</strong></div>
                                <div>Hakediş gelir: <strong>@Tl(HakedisToplamGelir)</strong></div>
                                <div>Fark: <strong class="@(Math.Abs(GelirFarki) > 0.01m ? "text-warning" : "text-success")">@Tl(GelirFarki)</strong></div>
                            </div>
                            <div class="col-md-4">
                                <div>Puantaj gider: <strong>@Tl(puantajDonemOzeti.ToplamGider)</strong></div>
                                <div>Hakediş gider: <strong>@Tl(HakedisToplamGider)</strong></div>
                                <div>Fark: <strong class="@(Math.Abs(GiderFarki) > 0.01m ? "text-warning" : "text-success")">@Tl(GiderFarki)</strong></div>
                            </div>
                        </div>
                        <div class="small text-muted mt-2">
                            Güzergâh kartı fiyatıyla: gelir <strong>@Tl(ToplamSeferGelir)</strong>, gider <strong>@Tl(ToplamSeferGider)</strong>.
                            Kapsamlı (filtreli) hakedişler dönemin tamamını kapsamadığı için fark çıkması normaldir.
                        </div>
                    }
                </div>
            </div>
        }

        @if (isBusy && hakedisler.Count == 0)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="card-header py-2">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div class="d-flex flex-wrap align-items-center gap-1">
                            <button type="button" class="btn btn-sm rounded-pill @(string.IsNullOrEmpty(durumFiltre) ? "btn-primary" : "btn-outline-secondary")"
                                    @onclick='() => DurumSec("")'>Tümü <span class="opacity-75">(@hakedisler.Count)</span></button>
                            @foreach (var d in Enum.GetValues<HakedisDurum>().Where(x => DurumAdedi(x) > 0))
                            {
                                <button type="button" class="btn btn-sm rounded-pill @(durumFiltre == d.ToString() ? "btn-primary" : "btn-outline-secondary")"
                                        @onclick="() => DurumSec(d.ToString())">@GetDurumText(d) <span class="opacity-75">(@DurumAdedi(d))</span></button>
                            }
                        </div>
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <input class="form-control form-control-sm hakedis-arama" placeholder="Referans, güzergâh veya kapsam ara..."
                                   @bind="aramaMetni" @bind:event="oninput" aria-label="Ara" />
                            <select class="form-select form-select-sm w-auto" @bind="selectedGrouping" aria-label="Gruplama">
                                <option value="cari">Cariye göre grupla</option>
                                <option value="referans">Referansa göre grupla</option>
                            </select>
                            @if (!string.IsNullOrWhiteSpace(aramaMetni) || !string.IsNullOrWhiteSpace(durumFiltre))
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ListeFiltreleriniTemizle">
                                    <i class="bi bi-x-lg me-1"></i>Temizle
                                </button>
                            }
                            <button type="button" class="btn btn-sm btn-outline-success" @onclick="ExceleAktarAsync" disabled="@(isBusy || !FiltreliHakedisler.Any())">
                                <i class="bi bi-file-earmark-excel me-1"></i>Excel
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body border-bottom py-2">
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="TumunuSecKaldir" disabled="@(isBusy || !FiltreliHakedisler.Any())">
                            <i class="bi bi-check2-square me-1"></i>@(TumSeciliMi ? "Seçimi temizle" : "Tümünü seç")
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-success" @onclick="TopluOnaylaSecilenAsync" disabled="@(isBusy || !SeciliTaslakIdler.Any())"
                                title="Seçili taslakları onaylar">
                            <i class="bi bi-check2-circle me-1"></i>Onayla (@SeciliTaslakIdler.Count)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="TopluFaturalaSecilenAsync" disabled="@(isBusy || !SeciliFaturalanabilirIdler.Any())"
                                title="Seçili onaylı hakedişleri faturaya dönüştürür">
                            <i class="bi bi-receipt me-1"></i>Faturala (@SeciliFaturalanabilirIdler.Count)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="TaslaklariYenileSecilenAsync" disabled="@(isBusy || !SeciliTaslakIdler.Any())"
                                title="Seçili taslakları, oluşturuldukları kapsamla güncel puantajdan yeniden üretir">
                            <i class="bi bi-arrow-repeat me-1"></i>Taslakları yenile (@SeciliTaslakIdler.Count)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="TopluSilSecilenAsync" disabled="@(isBusy || !SeciliSilinebilirIdler.Any())"
                                title="Seçili (faturalanmamış) hakedişleri siler">
                            <i class="bi bi-trash me-1"></i>Sil (@SeciliSilinebilirIdler.Count)
                        </button>
                        <button type="button" class="btn btn-sm btn-link text-decoration-none ms-auto" @onclick="ListeGruplariniAcKapat">
                            @(listeTumuAcik ? "Grupları kapat" : "Grupları aç")
                        </button>
                        <span class="text-muted small">Seçili: <strong>@seciliHakedisIds.Count</strong></span>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th style="width:40px">
                                        <input type="checkbox" class="form-check-input" checked="@TumSeciliMi" @onchange="_ => TumunuSecKaldir()"
                                               disabled="@(isBusy || !hakedisler.Any())" aria-label="Tümünü seç" />
                                    </th>
                                    <th>#</th>
                                    <th>Referans</th>
                                    <th>Kapsam</th>
                                    <th>Güzergâh</th>
                                    <th class="text-end">Sefer</th>
                                    <th class="text-end">Tutar</th>
                                    <th class="text-end">KDV</th>
                                    <th class="text-end">Genel toplam</th>
                                    <th>Durum</th>
                                    <th class="text-end">İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!FiltreliHakedisler.Any())
                                {
                                    <tr>
                                        <td colspan="11" class="text-center text-muted p-4">
                                            @if (hakedisler.Count == 0)
                                            {
                                                <div>Bu dönemde @GetTipText(seciliTip).ToLower(new System.Globalization.CultureInfo("tr-TR")) hakedişi yok.</div>
                                                <button type="button" class="btn btn-sm btn-primary mt-2" @onclick="() => aktifSekme = Sekme.Hazirla">
                                                    <i class="bi bi-sliders me-1"></i>Hakediş hazırla
                                                </button>
                                            }
                                            else
                                            {
                                                <div>Filtreye uyan hakediş bulunamadı.</div>
                                            }
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var group in GetGroupedData())
                                    {
                                        var acik = ListeGrubuAcik(group.Key);
                                        <tr class="grup-satiri" @onclick="() => ToggleGroup(group.Key)">
                                            <td colspan="11">
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="bi @(acik ? "bi-chevron-down" : "bi-chevron-right")"></i>
                                                    <strong>@group.Key</strong>
                                                    <span class="badge rounded-pill bg-secondary">@group.Value.Count</span>
                                                    <span class="text-muted small ms-auto">
                                                        Toplam: @Tl(group.Value.Sum(x => x.GenelToplam))
                                                    </span>
                                                </div>
                                            </td>
                                        </tr>

                                        @if (acik)
                                        {
                                            @foreach (var h in group.Value.OrderByDescending(x => x.Id))
                                            {
                                                <tr>
                                                    <td>
                                                        <input type="checkbox" class="form-check-input" checked="@seciliHakedisIds.Contains(h.Id)"
                                                               @onchange="_ => SecimiDegistir(h.Id)" disabled="@isBusy" aria-label="Seç" />
                                                    </td>
                                                    <td>@h.Id</td>
                                                    <td title="@GetCariTooltip(h)">@GetReferansAd(h)</td>
                                                    <td class="small">
                                                        @if (KapsamliMi(h))
                                                        {
                                                            <span class="badge bg-info text-dark text-wrap text-start" title="Bu hakediş yalnızca seçilen kapsam için oluşturuldu">@GetKapsamOzeti(h)</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">Tüm dönem</span>
                                                        }
                                                    </td>
                                                    <td class="small">
                                                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-start" @onclick="() => ToggleHakedisDetay(h.Id)" @onclick:stopPropagation="true">
                                                            <i class="bi @(acikHakedisDetaylari.Contains(h.Id) ? "bi-chevron-down" : "bi-chevron-right") me-1"></i>@GetGuzergahOzet(h, kisalt: true)
                                                        </button>
                                                        @if (acikHakedisDetaylari.Contains(h.Id))
                                                        {
                                                            <div class="mt-1 ps-3 border-start">
                                                                @foreach (var d in GetGuzergahDetaylari(h))
                                                                {
                                                                    <div class="mb-1">
                                                                        <div class="fw-semibold">@d.Ad</div>
                                                                        <div class="d-flex flex-wrap gap-3 small">
                                                                            <span class="text-success">Gelir: @Sayi(d.Sefer) sefer × @Sayi(d.GelirBirim) = @Tl(d.GelirToplam)</span>
                                                                            <span class="text-danger">Gider: @Sayi(d.Sefer) sefer × @Sayi(d.GiderBirim) = @Tl(d.GiderToplam)</span>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    </td>
                                                    <td class="text-end">@Sayi(h.ToplamSeferSayisi)</td>
                                                    <td class="text-end">@Sayi(h.Tutar)</td>
                                                    <td class="text-end">@Sayi(h.KdvTutar)</td>
                                                    <td class="text-end fw-semibold">@Sayi(h.GenelToplam)</td>
                                                    <td><span class="badge @GetDurumBadge(h.Durum)">@GetDurumText(h.Durum)</span></td>
                                                    <td class="text-end text-nowrap">
                                                        <button type="button" class="btn btn-sm btn-outline-secondary me-1" @onclick="() => PdfIndirAsync(h.Id)" disabled="@isBusy" title="PDF indir">
                                                            <i class="bi bi-filetype-pdf"></i>
                                                        </button>
                                                        @if (h.Durum == HakedisDurum.Taslak)
                                                        {
                                                            <button type="button" class="btn btn-sm btn-outline-success me-1" @onclick="() => OnaylaAsync(h.Id)" disabled="@isBusy" title="Onayla">
                                                                <i class="bi bi-check2-circle"></i>
                                                            </button>
                                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => SilAsync(h.Id)" disabled="@isBusy" title="Sil">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        }
                                                        else if (h.Durum == HakedisDurum.Onaylandi)
                                                        {
                                                            <button type="button" class="btn btn-sm btn-outline-primary me-1" @onclick="() => FaturalaAsync(h.Id)"
                                                                    disabled="@(isBusy || h.Tip == HakedisTipi.Arac)"
                                                                    title="@(h.Tip == HakedisTipi.Arac ? "Araç hakedişi faturalanmaz" : "Faturaya dönüştür")">
                                                                <i class="bi bi-receipt"></i>
                                                            </button>
                                                            <button type="button" class="btn btn-sm btn-outline-warning" @onclick="() => IptalAsync(h.Id)" disabled="@isBusy" title="İptal et">
                                                                <i class="bi bi-x-circle"></i>
                                                            </button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>
