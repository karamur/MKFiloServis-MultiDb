            if (!string.IsNullOrWhiteSpace(c.VergiNo)) detaySatirlari.Add(("Vergi No", c.VergiNo));
            if (!string.IsNullOrWhiteSpace(c.Telefon)) detaySatirlari.Add(("Telefon", c.Telefon));
            if (!string.IsNullOrWhiteSpace(c.Email)) detaySatirlari.Add(("E-posta", c.Email));
            if (!string.IsNullOrWhiteSpace(c.YetkiliKisi)) detaySatirlari.Add(("Yetkili Kişi", c.YetkiliKisi));
