            if (!string.IsNullOrWhiteSpace(c.SozlesmeNo)) detaySatirlari.Add(("Sözleşme No", c.SozlesmeNo));
            if (c.SozlesmeBaslangicTarihi.HasValue) detaySatirlari.Add(("Sözleşme Başlangıç", c.SozlesmeBaslangicTarihi.Value.ToString("dd.MM.yyyy")));
            if (c.SozlesmeBitisTarihi.HasValue) detaySatirlari.Add(("Sözleşme Bitiş", c.SozlesmeBitisTarihi.Value.ToString("dd.MM.yyyy")));
