    private void KurumDetayAc(MatrisSatir satir)
    {
        var c = satir.MusteriCariRef;
        detayBaslik = $"Kurum Detayı – {satir.Kurum}";
        detayIkon = "bi-building";
        detaySatirlari = new();
        if (c != null)
        {
            detaySatirlari.Add(("Ünvan", c.Unvan));
            if (!string.IsNullOrWhiteSpace(c.CariKodu)) detaySatirlari.Add(("Cari Kodu", c.CariKodu));
            detaySatirlari.Add(("Cari Tipi", c.CariTipi.ToString()));
