@page "/operasyon/puantaj-matris"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using MKFiloServis.Shared.Entities
@using MKFiloServis.Web.Services
@using MKFiloServis.Web.Services.Interfaces
@using MKFiloServis.Web.Models
@inject IFiloKomisyonService FiloKomisyonService
@inject IAktifFirmaProvider AktifFirmaProvider
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Aylık Operasyon Kontrolü</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-1"><i class="bi bi-table me-2 text-primary"></i>Aylık Operasyon Kontrolü</h3>
            <p class="text-muted mb-0">Sefer, gelir ve gider toplamlarını ay bazında kontrol edin.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-success" @onclick="ExceleAktarAsync" disabled="@(isBusy || !FiltreliSatirlar.Any())">
                <i class="bi bi-file-earmark-excel me-1"></i>Excel'e Aktar
            </button>
            <button class="btn btn-outline-secondary" @onclick="YukleAsync" disabled="@isBusy">
                <i class="bi bi-arrow-clockwise me-1"></i>Yenile
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(hataMesaji))
    {
        <div class="alert alert-danger">@hataMesaji</div>
    }

    <div class="card shadow-sm mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-end">
                <div class="col-md-1">
                    <label class="form-label small mb-1">Ay</label>
                    <select class="form-select form-select-sm" @bind="seciliAy" @bind:after="YukleAsync">
                        @for (var ay = 1; ay <= 12; ay++)
                        {
                            <option value="@ay">@(new DateTime(2000, ay, 1).ToString("MMMM", TrKultur))</option>
                        }
                    </select>
                </div>
                <div class="col-md-1">
                    <label class="form-label small mb-1">Yıl</label>
                    <select class="form-select form-select-sm" @bind="seciliYil" @bind:after="YukleAsync">
                        @for (var yil = DateTime.Today.Year + 1; yil >= DateTime.Today.Year - 3; yil--)
                        {
                            <option value="@yil">@yil</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1">Kurum</label>
                    <input class="form-control form-control-sm" @bind="filtreKurum" @bind:event="oninput" placeholder="Kurum ara..." />
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1">Güzergah</label>
                    <input class="form-control form-control-sm" @bind="filtreGuzergah" @bind:event="oninput" placeholder="Güzergah ara..." />
                </div>
                <div class="col-md-1">
                    <label class="form-label small mb-1">Servis yönü</label>
                    <select class="form-select form-select-sm" @bind="filtreYon">
                        <option value="">Tümü</option>
                        <option value="S">S (Sabah)</option>
                        <option value="A">A (Akşam)</option>
                        <option value="S-A">S-A (Sabah-Akşam)</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <label class="form-label small mb-1">Plaka</label>
                    <input class="form-control form-control-sm" @bind="filtrePlaka" @bind:event="oninput" placeholder="Plaka..." />
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1">Şoför</label>
                    <input class="form-control form-control-sm" @bind="filtreSofor" @bind:event="oninput" placeholder="Şoför ara..." />
                </div>
                <div class="col-md-1">
                    <label class="form-label small mb-1">Fatura firması</label>
                    <input class="form-control form-control-sm" @bind="filtreFaturaFirma" @bind:event="oninput" placeholder="Firma..." />
                </div>
                <div class="col-md-1 text-end">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="FiltreleriTemizle" disabled="@isBusy">
                        <i class="bi bi-funnel me-1"></i>Temizle
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (isBusy)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Yükleniyor...</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height:70vh;">
                    <table class="table table-bordered table-sm mb-0 align-middle" style="font-size:.75rem; white-space:nowrap;">
                        <thead class="table-light" style="position:sticky; top:0; z-index:2;">
                            <tr>
                                <th class="text-center">S.NO</th>
                                <th>KURUM</th>
                                <th>GÜZERGAH</th>
                                <th class="text-end">TOPLAM GELİR</th>
                                <th class="text-end">TOPLAM GİDER</th>
                                <th class="text-center">YÖN</th>
                                <th>PLAKA</th>
                                <th>ŞOFÖR / TEDARİKÇİ</th>
                                <th>FATURA FİRMASI</th>
                                @for (var g = 1; g <= AyGunSayisi; g++)
                                {
                                    var gun = g;
                                    var tarih = new DateTime(seciliYil, seciliAy, gun);
                                    var haftaSonu = tarih.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
                                    <th class="text-center @(haftaSonu ? "table-secondary" : "")" style="min-width:28px;" title="@tarih.ToString("dd.MM.yyyy ddd", TrKultur)">@gun</th>
                                }
                                <th class="text-center">GÜN</th>
                                <th class="text-center">SEFER</th>
                                <th class="text-end">TOPLAM GELİR</th>
                                <th class="text-end">TOPLAM GİDER</th>
                                <th class="text-center">KDV ORANI</th>
                                <th class="text-end">KDV MİKTAR</th>
                                <th class="text-end">KESİNTİ</th>
                                <th class="text-end">ÖDENECEK</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var filtreli = FiltreliSatirlar;
                            }
                            @if (!filtreli.Any())
                            {
                                <tr><td colspan="@(17 + AyGunSayisi)" class="text-center text-muted p-4">Filtreye uygun kayıt yok</td></tr>
                            }
                            else
                            {
                                var sira = 0;
                                @foreach (var satir in filtreli)
                                {
                                    sira++;
                                    <tr>
                                        <td class="text-center">@sira</td>
                                        <td class="fw-semibold"><a href="javascript:void(0)" class="text-decoration-none text-dark" @onclick="() => KurumDetayAc(satir)">@satir.Kurum</a></td>
                                        <td>@satir.Guzergah</td>
                                        <td class="text-end">@(satir.Gelir > 0 ? satir.Gelir.ToString("N2") : "")</td>
                                        <td class="text-end">@(satir.Gider > 0 ? satir.Gider.ToString("N2") : "")</td>
                                        <td class="text-center fw-semibold @(satir.Yon == "S" ? "table-warning" : satir.Yon == "A" ? "table-warning" : "")">@satir.Yon</td>
                                        <td><a href="javascript:void(0)" class="text-decoration-none" @onclick="() => AracDetayAc(satir)">@satir.Plaka</a></td>
                                        <td><a href="javascript:void(0)" class="text-decoration-none" @onclick="() => SoforDetayAc(satir)">@satir.Sofor</a></td>
                                        <td><a href="javascript:void(0)" class="text-danger text-decoration-none" @onclick="() => FaturaFirmaDetayAc(satir)">@satir.FaturaFirma</a></td>
                                        @for (var g = 1; g <= AyGunSayisi; g++)
                                        {
                                            var tarih = new DateTime(seciliYil, seciliAy, g);
                                            var haftaSonu = tarih.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
                                             var deger = satir.GunlukSeferler.TryGetValue(tarih.Date, out var v) ? v : 0m;
                                            <td class="text-center @(haftaSonu ? "table-secondary" : "")">@(deger > 0 ? deger.ToString("0.#") : "")</td>
                                        }
                                        <td class="text-center fw-semibold">@satir.GunSayisi</td>
                                        <td class="text-center fw-semibold">@satir.SeferSayisi.ToString("0.#")</td>
                                        <td class="text-end fw-semibold">@satir.ToplamGelir.ToString("N2")</td>
                                        <td class="text-end fw-semibold">@satir.ToplamGider.ToString("N2")</td>
                                        <td class="text-center">%@satir.KdvOrani.ToString("0.##")</td>
                                        <td class="text-end">@satir.KdvMiktar.ToString("N2")</td>
                                        <td class="text-end">@(satir.Kesinti != 0 ? satir.Kesinti.ToString("N2") : "")</td>
                                        <td class="text-end fw-bold">@satir.Odenecek.ToString("N2")</td>
                                    </tr>
                                }
                                <tr class="table-light fw-bold">
                                    <td colspan="3" class="text-end">TOPLAM</td>
                                    <td class="text-end">@filtreli.Sum(x => x.Gelir).ToString("N2")</td>
                                    <td class="text-end">@filtreli.Sum(x => x.Gider).ToString("N2")</td>
                                    <td colspan="4"></td>
                                    @for (var g = 1; g <= AyGunSayisi; g++)
                                    {
                                         var tarih = new DateTime(seciliYil, seciliAy, g);
                                         var gunToplam = filtreli.Sum(x => x.GunlukSeferler.TryGetValue(tarih.Date, out var v) ? v : 0m);
                                        <td class="text-center">@(gunToplam > 0 ? gunToplam.ToString("0.#") : "")</td>
                                    }
                                    <td class="text-center">@filtreli.Sum(x => x.GunSayisi)</td>
                                    <td class="text-center">@filtreli.Sum(x => x.SeferSayisi).ToString("0.#")</td>
                                    <td class="text-end">@filtreli.Sum(x => x.ToplamGelir).ToString("N2")</td>
                                    <td class="text-end">@filtreli.Sum(x => x.ToplamGider).ToString("N2")</td>
                                    <td></td>
                                    <td class="text-end">@filtreli.Sum(x => x.KdvMiktar).ToString("N2")</td>
                                    <td class="text-end">@filtreli.Sum(x => x.Kesinti).ToString("N2")</td>
                                    <td class="text-end">@filtreli.Sum(x => x.Odenecek).ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="small text-muted mt-2">
            Toplam satır: <strong>@matrisSatirlari.Count</strong> | Filtreli: <strong>@FiltreliSatirlar.Count</strong>
        </div>
    }

    @if (detayModalAcik)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.4);" @onclick="DetayKapat">
            <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
                <div class="modal-content">
                    <div class="modal-header py-2">
                        <h6 class="modal-title"><i class="bi @detayIkon me-2"></i>@detayBaslik</h6>
                        <button type="button" class="btn-close" @onclick="DetayKapat"></button>
                    </div>
                    <div class="modal-body py-2">
                        @if (!detaySatirlari.Any())
                        {
                            <p class="text-muted mb-0">Detay bilgisi bulunamadı.</p>
                        }
                        else
                        {
                            <table class="table table-sm table-striped mb-0" style="font-size:.85rem;">
                                <tbody>
                                    @foreach (var (etiket, deger) in detaySatirlari)
                                    {
                                        <tr>
                                            <th style="width:40%; white-space:nowrap;">@etiket</th>
                                            <td>@deger</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                    <div class="modal-footer py-1">
                        <button class="btn btn-sm btn-secondary" @onclick="DetayKapat">Kapat</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private static readonly System.Globalization.CultureInfo TrKultur = new("tr-TR");

    private bool isBusy;
    private string? hataMesaji;
    private int seciliAy = DateTime.Today.Month;
    private int seciliYil = DateTime.Today.Year;

    private string filtreKurum = string.Empty;
    private string filtreGuzergah = string.Empty;
    private string filtreYon = string.Empty;
    private string filtrePlaka = string.Empty;
    private string filtreSofor = string.Empty;
    private string filtreFaturaFirma = string.Empty;

    private List<MatrisSatir> matrisSatirlari = new();

    private string AyAdi => new DateTime(2000, seciliAy, 1).ToString("MMMM", TrKultur);
    private int AyGunSayisi => DateTime.DaysInMonth(seciliYil, seciliAy);

    private List<MatrisSatir> FiltreliSatirlar => matrisSatirlari.Where(FiltreyeUyar).ToList();

    protected override async Task OnInitializedAsync()
    {
        await YukleAsync();
    }

    private async Task YukleAsync()
    {
        hataMesaji = null;
        isBusy = true;
        try
        {
            var firmaId = GetFirmaId();
            var baslangic = new DateTime(seciliYil, seciliAy, 1);
            var bitis = baslangic.AddMonths(1).AddDays(-1);

            var detaylar = await FiloKomisyonService.GetPuantajDetayliByTarihAraligiAsync(firmaId, baslangic, bitis);

            matrisSatirlari = detaylar
                .Where(d => d.Puantaj != null)
                .GroupBy(d => new
                {
                    d.Puantaj.KurumFirmaId,
                    d.Puantaj.GuzergahId,
                    d.Puantaj.AracId,
                    d.Puantaj.SoforId
                })
                .Select(grp =>
                {
                    var ilk = grp.First();
                     var gunluk = grp
                         .GroupBy(x => x.Puantaj.Tarih.Date)
                        .ToDictionary(g => g.Key, g => g.Sum(x => x.Puantaj.SeferSayisi));

                    var seferSayisi = grp.Sum(x => x.Puantaj.SeferSayisi);
                    var toplamGelir = grp.Sum(x => x.Puantaj.TahakkukEdenKurumUcreti);
                    var toplamGider = grp.Sum(x => x.Puantaj.TahakkukEdenTaseronUcreti);
                    var gelirBirim = seferSayisi > 0 ? toplamGelir / seferSayisi : 0m;
                    var giderBirim = seferSayisi > 0 ? toplamGider / seferSayisi : 0m;
                    // KDV oranı güzergah kartından gelir
                    var kdvOrani = ilk.Puantaj.Guzergah?.KdvOrani ?? 20m;
                    var kdvMiktar = Math.Round(toplamGelir * kdvOrani / 100m, 2, MidpointRounding.AwayFromZero);
                    var kesinti = 0m;

                    return new MatrisSatir
                    {
                        Kurum = ilk.Puantaj.MusteriCari?.Unvan ?? "-",
                        Guzergah = ilk.Puantaj.Guzergah?.GuzergahAdi ?? ilk.Puantaj.Guzergah?.GuzergahKodu ?? "-",
                        Gelir = gelirBirim,
                        Gider = giderBirim,
                        Yon = ServisYonKodu(ilk.Puantaj.ServisTuru),
                        Plaka = ilk.Puantaj.Arac?.AktifPlaka ?? "-",
                        Sofor = $"{ilk.Puantaj.Sofor?.Ad} {ilk.Puantaj.Sofor?.Soyad}".Trim(),
                        FaturaFirma = ilk.AracSahibiAd,
                        AracRef = ilk.Puantaj.Arac,
                        SoforRef = ilk.Puantaj.Sofor,
                        MusteriCariRef = ilk.Puantaj.MusteriCari,
                        AracSahibiTip = ilk.AracSahibiTip,
                        GunlukSeferler = gunluk,
                        GunSayisi = gunluk.Count(x => x.Value > 0),
                        SeferSayisi = seferSayisi,
                        ToplamGelir = toplamGelir,
                        ToplamGider = toplamGider,
                        KdvOrani = kdvOrani,
                        KdvMiktar = kdvMiktar,
                        Kesinti = kesinti,
                        // ÖDENECEK = TOPLAM GELİR + KDV MİKTAR - KESİNTİ
                        Odenecek = toplamGelir + kdvMiktar - kesinti
                    };
                })
                .OrderBy(x => x.Kurum)
                .ThenBy(x => x.Guzergah)
                .ThenBy(x => x.Yon)
                .ToList();
        }
        catch (Exception ex)
        {
            hataMesaji = ex.Message;
            matrisSatirlari = new();
        }
        finally
        {
            isBusy = false;
        }
    }

    private static string ServisYonKodu(ServisTuru tur) => tur switch
    {
        ServisTuru.Sabah => "S",
        ServisTuru.Aksam => "A",
        ServisTuru.SabahAksam => "S-A",
        ServisTuru.YardaMesai => "YM",
        ServisTuru.Ozel => "Ö",
        _ => "-"
    };

    private bool FiltreyeUyar(MatrisSatir satir)
    {
        if (!string.IsNullOrWhiteSpace(filtreKurum)
            && !satir.Kurum.Contains(filtreKurum, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrWhiteSpace(filtreGuzergah)
            && !satir.Guzergah.Contains(filtreGuzergah, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrWhiteSpace(filtreYon)
            && !string.Equals(satir.Yon, filtreYon, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrWhiteSpace(filtrePlaka)
            && !satir.Plaka.Contains(filtrePlaka, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrWhiteSpace(filtreSofor)
            && !satir.Sofor.Contains(filtreSofor, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrWhiteSpace(filtreFaturaFirma)
            && !satir.FaturaFirma.Contains(filtreFaturaFirma, StringComparison.OrdinalIgnoreCase))
            return false;

        return true;
    }

    private void FiltreleriTemizle()
    {
        filtreKurum = string.Empty;
        filtreGuzergah = string.Empty;
        filtreYon = string.Empty;
        filtrePlaka = string.Empty;
        filtreSofor = string.Empty;
        filtreFaturaFirma = string.Empty;
    }

    private async Task ExceleAktarAsync()
    {
        try
        {
            var filtreli = FiltreliSatirlar;
            if (!filtreli.Any()) return;

            using var workbook = new ClosedXML.Excel.XLWorkbook();
            var ws = workbook.Worksheets.Add("Aylık Puantaj");

            var gunSayisi = AyGunSayisi;
            var sabitBasliklar = new[] { "S.NO", "KURUM", "GÜZERGAH", "GELİR", "GİDER", "YÖN", "PLAKA", "tedarikçi/personel ŞOFÖR", "tedarikçi/firma FATURA" };
            var sonBasliklar = new[] { "GÜN", "SEFER", "TOPLAM GELİR", "TOPLAM GİDER", "KDV ORANI", "KDV MİKTAR", "KESİNTİ", "ÖDENECEK" };

            var kolon = 1;
            foreach (var b in sabitBasliklar)
                ws.Cell(1, kolon++).Value = b;
            for (var g = 1; g <= gunSayisi; g++)
                ws.Cell(1, kolon++).Value = g;
            foreach (var b in sonBasliklar)
                ws.Cell(1, kolon++).Value = b;

            var sonKolon = kolon - 1;
            var baslikAralik = ws.Range(1, 1, 1, sonKolon);
            baslikAralik.Style.Font.Bold = true;
            baslikAralik.Style.Fill.BackgroundColor = ClosedXML.Excel.XLColor.LightGray;

            // Hafta sonu gün başlıklarını gölgele
            for (var g = 1; g <= gunSayisi; g++)
            {
                var tarih = new DateTime(seciliYil, seciliAy, g);
                if (tarih.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)
                    ws.Column(sabitBasliklar.Length + g).Style.Fill.BackgroundColor = ClosedXML.Excel.XLColor.FromArgb(0xEE, 0xEE, 0xEE);
            }
            baslikAralik.Style.Fill.BackgroundColor = ClosedXML.Excel.XLColor.LightGray;

            var satirNo = 2;
            var sira = 0;
            foreach (var satir in filtreli)
            {
                sira++;
                var c = 1;
                ws.Cell(satirNo, c++).Value = sira;
                ws.Cell(satirNo, c++).Value = satir.Kurum;
                ws.Cell(satirNo, c++).Value = satir.Guzergah;
                if (satir.Gelir > 0) ws.Cell(satirNo, 4).Value = satir.Gelir;
                c++;
                if (satir.Gider > 0) ws.Cell(satirNo, 5).Value = satir.Gider;
                c++;
                ws.Cell(satirNo, c++).Value = satir.Yon;
                ws.Cell(satirNo, c++).Value = satir.Plaka;
                ws.Cell(satirNo, c++).Value = satir.Sofor;
                var faturaHucre = ws.Cell(satirNo, c++);
                faturaHucre.Value = satir.FaturaFirma;
                faturaHucre.Style.Font.FontColor = ClosedXML.Excel.XLColor.Red;

                for (var g = 1; g <= gunSayisi; g++)
                {
                     var tarih = new DateTime(seciliYil, seciliAy, g);
                     var deger = satir.GunlukSeferler.TryGetValue(tarih.Date, out var v) ? v : 0m;
                    if (deger > 0)
                        ws.Cell(satirNo, c).Value = deger;
                    c++;
                }

                ws.Cell(satirNo, c++).Value = satir.GunSayisi;
                ws.Cell(satirNo, c++).Value = satir.SeferSayisi;
                ws.Cell(satirNo, c++).Value = satir.ToplamGelir;
                ws.Cell(satirNo, c++).Value = satir.ToplamGider;
                ws.Cell(satirNo, c++).Value = satir.KdvOrani / 100m;
                ws.Cell(satirNo, c - 1).Style.NumberFormat.Format = "0.##%";
                ws.Cell(satirNo, c++).Value = satir.KdvMiktar;
                if (satir.Kesinti != 0) ws.Cell(satirNo, c).Value = satir.Kesinti;
                c++;
                ws.Cell(satirNo, c).Value = satir.Odenecek;
                satirNo++;
            }

            // TOPLAM satırı
            ws.Cell(satirNo, 3).Value = "TOPLAM";
            ws.Cell(satirNo, 3).Style.Alignment.Horizontal = ClosedXML.Excel.XLAlignmentHorizontalValues.Right;
            var toplamKolonlar = new List<int> { 4, 5 };
            for (var g = 1; g <= gunSayisi; g++)
                toplamKolonlar.Add(sabitBasliklar.Length + g);
            var sonBaslangic = sabitBasliklar.Length + gunSayisi;
            for (var i = 1; i <= sonBasliklar.Length; i++)
            {
                if (i == 5) continue; // KDV ORANI kolonu toplanmaz
                toplamKolonlar.Add(sonBaslangic + i);
            }

            foreach (var col in toplamKolonlar)
            {
                var hucre = ws.Cell(satirNo, col);
                hucre.FormulaA1 = $"SUM({ws.Cell(2, col).Address}:{ws.Cell(satirNo - 1, col).Address})";
            }
            ws.Range(satirNo, 1, satirNo, sonKolon).Style.Font.Bold = true;
            ws.Range(satirNo, 1, satirNo, sonKolon).Style.Fill.BackgroundColor = ClosedXML.Excel.XLColor.FromArgb(0xF8, 0xF9, 0xFA);

            // Sayı formatları
            ws.Range(2, 4, satirNo, 5).Style.NumberFormat.Format = "#,##0.00";
            ws.Range(2, sonBaslangic + 3, satirNo, sonBaslangic + 4).Style.NumberFormat.Format = "#,##0.00"; // TOPLAM GELİR/GİDER
            ws.Range(2, sonBaslangic + 5, satirNo - 1, sonBaslangic + 5).Style.NumberFormat.Format = "0.##%"; // KDV ORANI
            ws.Range(2, sonBaslangic + 6, satirNo, sonKolon).Style.NumberFormat.Format = "#,##0.00"; // KDV MİKTAR..ÖDENECEK

            ws.Columns().AdjustToContents();
            ws.SheetView.FreezeRows(1);
            ws.SheetView.FreezeColumns(sabitBasliklar.Length);

            using var stream = new MemoryStream();
            workbook.SaveAs(stream);
            var dosyaAdi = $"AylikPuantajTablosu_{seciliYil}-{seciliAy:D2}.xlsx";
            var base64 = Convert.ToBase64String(stream.ToArray());
            await JS.InvokeVoidAsync("downloadFile", dosyaAdi, base64, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        catch (Exception ex)
        {
            hataMesaji = $"Excel oluşturulurken hata: {ex.Message}";
        }
    }

    private bool detayModalAcik;
