    private void FaturaFirmaDetayAc(MatrisSatir satir)
    {
        var a = satir.AracRef;
        detayBaslik = $"Fatura Firma Detayı – {satir.FaturaFirma}";
        detayIkon = "bi-receipt";
        detaySatirlari = new();
        detaySatirlari.Add(("Firma / Cari", satir.FaturaFirma));
        if (!string.IsNullOrWhiteSpace(satir.AracSahibiTip)) detaySatirlari.Add(("Sahiplik Tipi", satir.AracSahibiTip));
        if (a != null)
        {
            Cari? cari = a.SahiplikTipi switch
            {
                AracSahiplikTipi.Kiralik => a.KiralikCari,
                AracSahiplikTipi.Komisyon => a.KomisyoncuCari,
                _ => null
            };

            if (cari != null)
            {
                if (!string.IsNullOrWhiteSpace(cari.VergiNo)) detaySatirlari.Add(("Vergi No", cari.VergiNo));
                if (!string.IsNullOrWhiteSpace(cari.Telefon)) detaySatirlari.Add(("Telefon", cari.Telefon));
                if (!string.IsNullOrWhiteSpace(cari.Email)) detaySatirlari.Add(("E-posta", cari.Email));
                if (!string.IsNullOrWhiteSpace(cari.Il) || !string.IsNullOrWhiteSpace(cari.Ilce)) detaySatirlari.Add(("İl / İlçe", $"{cari.Il} / {cari.Ilce}"));
            }
            else if (a.TasimaTedarikci != null)
            {
                var t = a.TasimaTedarikci;
                detaySatirlari.Add(("Tedarikçi Ünvan", t.Unvan));
                if (!string.IsNullOrWhiteSpace(t.Telefon)) detaySatirlari.Add(("Telefon", t.Telefon));
            }
            else if (a.Firma != null)
            {
                detaySatirlari.Add(("Firma", a.Firma.FirmaAdi));
            }
        }
        detayModalAcik = true;
    }

    private int GetFirmaId()
    {
        if (AktifFirmaProvider.AktifFirmaId.HasValue && AktifFirmaProvider.AktifFirmaId.Value > 0)
            return AktifFirmaProvider.AktifFirmaId.Value;

        if (AktifFirmaProvider.Mevcut?.FirmaId > 0)
            return AktifFirmaProvider.Mevcut.FirmaId;

        return 0;
    }

