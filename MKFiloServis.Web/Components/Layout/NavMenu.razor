@using MKFiloServis.Web.Services
@using MKFiloServis.Shared.Entities
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject IKullaniciService KullaniciService
@inject AppAuthenticationStateProvider AuthProvider
@inject IAktifFirmaProvider AktifFirmaProvider
@inject ILogger<NavMenu> Logger
@inject LicenseService ModuleLicenses

@* Kenar çubuğunda logo gösterilmez; şerit yalnızca mobildeki menü düğmesine yer açar. *@
<div class="top-row ps-3 navbar navbar-dark"></div>

<!-- Global Arama -->
<div class="px-3 py-2">
    <MKFiloServis.Web.Components.Shared.GlobalSearch />
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable">
    <nav class="nav flex-column" aria-label="Ana menü">
        @if (!yetkilerYuklendi)
        {
            <div class="px-3 py-2 mt-2">
                <div class="placeholder-glow">
                    <span class="placeholder col-10 mb-2 d-block rounded" style="height:14px"></span>
                    <span class="placeholder col-8 mb-2 d-block rounded" style="height:14px"></span>
                    <span class="placeholder col-9 mb-2 d-block rounded" style="height:14px"></span>
                    <span class="placeholder col-7 mb-2 d-block rounded" style="height:14px"></span>
                </div>
            </div>
        }

        @* Menünün içeriği (gruplar, alt gruplar, bağlantılar, yetki kuralları) AnaMenuYapisi.cs'dedir. *@
        <AnaMenuAgaci Kokler="AnaMenuYapisi.Kokler" Gorunurluk="Gorunurluk" />
    </nav>
</div>

@code {
    private HashSet<string> kullaniciYetkileri = new();
    private HashSet<string> kullaniciYetkiPrefixleri = new();
    private bool yetkilerYuklendi = false;
    private bool isAdmin = false;
    private string? aktifRolAdi;
    private bool disposed = false;
    private readonly SemaphoreSlim yetkiYukleGate = new(1, 1);

    // Her çizimde güncel yetki/lisans durumundan yeni bir değerlendirici üretilir (hafif, durum taşımaz).
    private MenuGorunurluk Gorunurluk => new(
        ModuleLicenses.HasLicensedPermission, isAdmin, yetkilerYuklendi, kullaniciYetkileri, kullaniciYetkiPrefixleri, aktifRolAdi);

    protected override async Task OnInitializedAsync()
    {
        // Once subscribe ol, sonra ilk yuklemeyi yap. Aksi halde yukleme sirasinda
        // gerceklesen AuthenticationStateChanged olaylari kacirilir.
        AuthProvider.AuthenticationStateChanged += OnAuthStateChanged;
        await YetkileriYukle();
    }

    private void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        _ = HandleAuthStateChangedAsync();
    }

    private async Task HandleAuthStateChangedAsync()
    {
        if (disposed)
            return;

        try
        {
            await YetkileriYukle();
            if (!disposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (ObjectDisposedException)
        {
            // Circuit kapanırken beklenen durum, sessizce yut
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "NavMenu auth state degisikligi islenirken hata olustu");
        }
    }

    public void Dispose()
    {
        disposed = true;
        AuthProvider.AuthenticationStateChanged -= OnAuthStateChanged;
    }

    private async Task YetkileriYukle()
    {
        if (disposed)
            return;

        // Es zamanli auth state degisikliklerinde koleksiyonlarda race olusmamasi icin serialize et
        await yetkiYukleGate.WaitAsync();
        try
        {
            if (disposed)
                return;

            var aktifKullanici = AuthProvider.GetAktifKullanici();
            if (aktifKullanici != null)
            {
                // Admin kontrolu
                var rolAdi = aktifKullanici.Rol?.RolAdi;
                aktifRolAdi = rolAdi;
                isAdmin = rolAdi == "Admin";

                if (!isAdmin)
                {
                    // Kullanici yetkilerini yukle
                    var yetkiler = await KullaniciService.GetKullaniciYetkileriAsync(aktifKullanici.Id);
                    var yetkiSet = yetkiler.ToHashSet();
                    var prefixSet = yetkiSet
                        .Select(y =>
                        {
                            var idx = y.IndexOf('.');
                            return idx > 0 ? y.Substring(0, idx) : y;
                        })
                        .ToHashSet();

                    // Yeni referanslari atomik olarak ata (render sirasinda yarim doldurulmus
                    // koleksiyon gorunmesin)
                    kullaniciYetkileri = yetkiSet;
                    kullaniciYetkiPrefixleri = prefixSet;
                }
                else
                {
                    kullaniciYetkileri = new HashSet<string>();
                    kullaniciYetkiPrefixleri = new HashSet<string>();
                }

                yetkilerYuklendi = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "NavMenu kullanici yetkileri yuklenirken hata olustu");
            // Hata durumunda bos yetkiler
            kullaniciYetkileri = new HashSet<string>();
            kullaniciYetkiPrefixleri = new HashSet<string>();
        }
        finally
        {
            if (!disposed)
            {
                yetkiYukleGate.Release();
            }
        }
    }
}
