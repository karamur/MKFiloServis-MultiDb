# ============================================================
# 🔐 MKFiloServis — Environment değişkenleri (örnek)
# ------------------------------------------------------------
# 1) Bu dosyayı `.env` olarak kopyalayın
# 2) Tüm değerleri kendi ortamınız için DEĞİŞTİRİN
# 3) `.env` ASLA git'e commit edilmemelidir (.gitignore'da)
# ============================================================

# ── Web ──────────────────────────────────────────────────────
WEB_PORT=8080

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=MKFiloServis
POSTGRES_USER=koafilo
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# ── JWT (boş bırakmayın; örnek üretmek için: openssl rand -base64 48) ──
JWT_SECRET=
JWT_ISSUER=MKFiloServis
JWT_AUDIENCE=MKFiloServis-Users

# ── İlk yönetici (ilk açılışta; admin oluşturulduktan sonra bu sırları kaldırın) ──
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
# Kurulum sihirbazı için isteğe bağlı, en az 32 baytlık tek kullanımlık anahtar
MKFILOSERVIS_SETUP_BOOTSTRAP_TOKEN=

# ── Ollama (opsiyonel — `docker compose --profile ai up`) ────
OLLAMA_PORT=11434

